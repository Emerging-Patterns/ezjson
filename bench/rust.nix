  mainRsText = ''
//! Fair in-process serde_json reference for ezjson benches.
//! Time N iterations inside this process; never spawn per op.

use std::cell::Cell;
use std::env;
use std::fs;
use std::process;
use std::time::Instant;

use serde::de::{self, DeserializeSeed, Deserializer, MapAccess, SeqAccess, Visitor};
use serde_json::value::RawValue;

fn die(msg: &str) -> ! {
    eprintln!("{msg}");
    process::exit(1);
}

fn read_text(path: &str) -> String {
    fs::read_to_string(path).unwrap_or_else(|e| die(&format!("read {path}: {e}")))
}

fn write_text(path: &str, s: &str) {
    fs::write(path, s).unwrap_or_else(|e| die(&format!("write {path}: {e}")));
}

fn compact(v: &serde_json::Value) -> String {
    serde_json::to_string(v).unwrap_or_else(|e| die(&format!("to_string: {e}")))
}

fn parse(s: &str) -> serde_json::Value {
    serde_json::from_str(s).unwrap_or_else(|e| die(&format!("from_str: {e}")))
}

fn show_ms(ms: u128, sum: u64, bytes: usize, n: u64) {
    // Match Bend driver: MS … SUM … BY … N …
    println!("MS {ms} SUM {sum} BY {bytes} N {n}");
}

fn cmd_dec(src: &str, dst: &str) {
    let text = read_text(src);
    let v = parse(&text);
    write_text(dst, &compact(&v));
}

fn cmd_enc(src: &str, dst: &str) {
    // Encode path: load JSON text, parse to Value, print compact (same surface as dec for text JSON).
    let text = read_text(src);
    let v = parse(&text);
    write_text(dst, &compact(&v));
}

fn cmd_rt(src: &str, dst: &str) {
    let text = read_text(src);
    let v = parse(&text);
    let out = compact(&v);
    let v2 = parse(&out);
    write_text(dst, &compact(&v2));
}

fn bench_dec(path: &str, n: u64) {
    let text = read_text(path);
    let bytes = text.len();
    let mut sum: u64 = 0;
    let t0 = Instant::now();
    for _ in 0..n {
        match serde_json::from_str::<serde_json::Value>(&text) {
            Ok(v) => sum = sum.wrapping_add(compact(&v).len() as u64).wrapping_add(1),
            Err(_) => {}
        }
    }
    let ms = t0.elapsed().as_millis();
    show_ms(ms, sum, bytes, n);
}

fn bench_enc(path: &str, n: u64) {
    let text = read_text(path);
    let v = parse(&text);
    let bytes = text.len();
    let mut sum: u64 = 0;
    let t0 = Instant::now();
    for _ in 0..n {
        let s = compact(&v);
        sum = sum.wrapping_add(s.len() as u64).wrapping_add(1);
    }
    let ms = t0.elapsed().as_millis();
    show_ms(ms, sum, bytes, n);
}

// Token-walk checksum, matched by the Bend pull bench.
// null 1, bool 2, number 3, string 4, key 5, begin-array 6, end-array 7,
// begin-object 8, end-object 9, end 10 (added by the caller), error is a die.
// A skipped `rows` value is 12. Text mode also adds the byte length of every
// 8th direct string in each `rows` array (those rows are ASCII).
//
// This is a serde_json token walk (`deserialize_any`), not `from_str::<Value>`
// and not `StreamDeserializer` of `Value`. One document is one value, so a
// stream-of-values parse would be a single tree. `skip` of `rows` borrows a
// `RawValue` (structural scan, no DOM).

#[derive(Clone, Copy)]
enum Job {
    Walk,
    Skip,
    // `depth` is 0 outside a `rows` array, 1 on its direct elements.
    Text { depth: u32 },
    // The next value is the array named `rows`.
    TextRows,
}

struct Seed<'a> {
    job: Job,
    every: Option<&'a Cell<u32>>,
}

fn copied_len(s: &str) -> u64 {
    // `text` copies the row. black_box keeps that copy in the timed work.
    std::hint::black_box(s.to_owned()).len() as u64
}

fn str_tag(job: Job, every: Option<&Cell<u32>>, s: &str) -> u64 {
    match job {
        Job::Text { depth: 1 } => {
            let every = every.expect("rows countdown");
            if every.get() == 1 {
                let n = copied_len(s);
                every.set(8);
                4 + n
            } else {
                every.set(every.get() - 1);
                4
            }
        }
        _ => 4,
    }
}

impl<'de, 'a> DeserializeSeed<'de> for Seed<'a> {
    type Value = u64;
    fn deserialize<D: Deserializer<'de>>(self, deserializer: D) -> Result<u64, D::Error> {
        deserializer.deserialize_any(self)
    }
}

impl<'de, 'a> Visitor<'de> for Seed<'a> {
    type Value = u64;

    fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
        write!(f, "json")
    }

    fn visit_unit<E: de::Error>(self) -> Result<u64, E> {
        Ok(1)
    }

    fn visit_none<E: de::Error>(self) -> Result<u64, E> {
        Ok(1)
    }

    fn visit_bool<E: de::Error>(self, _v: bool) -> Result<u64, E> {
        Ok(2)
    }

    fn visit_i64<E: de::Error>(self, _v: i64) -> Result<u64, E> {
        Ok(3)
    }

    fn visit_u64<E: de::Error>(self, _v: u64) -> Result<u64, E> {
        Ok(3)
    }

    fn visit_f64<E: de::Error>(self, _v: f64) -> Result<u64, E> {
        Ok(3)
    }

    fn visit_i128<E: de::Error>(self, _v: i128) -> Result<u64, E> {
        Ok(3)
    }

    fn visit_u128<E: de::Error>(self, _v: u128) -> Result<u64, E> {
        Ok(3)
    }

    fn visit_str<E: de::Error>(self, v: &str) -> Result<u64, E> {
        Ok(str_tag(self.job, self.every, v))
    }

    fn visit_borrowed_str<E: de::Error>(self, v: &'de str) -> Result<u64, E> {
        Ok(str_tag(self.job, self.every, v))
    }

    fn visit_string<E: de::Error>(self, v: String) -> Result<u64, E> {
        Ok(str_tag(self.job, self.every, &v))
    }

    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<u64, A::Error> {
        let mut sum = 6u64;
        match self.job {
            Job::TextRows => {
                let every = Cell::new(1u32);
                loop {
                    let child = Seed { job: Job::Text { depth: 1 }, every: Some(&every) };
                    match seq.next_element_seed(child)? {
                        Some(part) => sum = sum.wrapping_add(part),
                        None => break,
                    }
                }
            }
            Job::Text { depth } if depth > 0 => {
                loop {
                    let child = Seed { job: Job::Text { depth: depth + 1 }, every: None };
                    match seq.next_element_seed(child)? {
                        Some(part) => sum = sum.wrapping_add(part),
                        None => break,
                    }
                }
            }
            job => {
                loop {
                    let child = Seed { job, every: None };
                    match seq.next_element_seed(child)? {
                        Some(part) => sum = sum.wrapping_add(part),
                        None => break,
                    }
                }
            }
        }
        Ok(sum.wrapping_add(7))
    }

    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<u64, A::Error> {
        let mut sum = 8u64;
        loop {
            let key = match map.next_key::<&str>()? {
                Some(k) => k,
                None => break,
            };
            sum = sum.wrapping_add(5);
            if matches!(self.job, Job::Skip) && key == "rows" {
                let raw = map.next_value::<&RawValue>()?;
                std::hint::black_box(raw.get());
                sum = sum.wrapping_add(12);
                continue;
            }
            let child = if key == "rows" && matches!(self.job, Job::Text { .. }) {
                Seed { job: Job::TextRows, every: None }
            } else {
                let job = match self.job {
                    Job::Text { depth } if depth > 0 => Job::Text { depth: depth + 1 },
                    // A `rows` value that is an object is not a row array.
                    Job::TextRows => Job::Text { depth: 0 },
                    other => other,
                };
                Seed { job, every: None }
            };
            sum = sum.wrapping_add(map.next_value_seed(child)?);
        }
        Ok(sum.wrapping_add(9))
    }
}

fn pull_sum(text: &str, job: Job) -> u64 {
    let mut de = serde_json::Deserializer::from_str(text);
    let seed = Seed { job, every: None };
    let sum = seed.deserialize(&mut de).unwrap_or_else(|e| die(&format!("pull: {e}")));
    de.end().unwrap_or_else(|e| die(&format!("pull trailing: {e}")));
    // The Bend walk's final end event.
    sum.wrapping_add(10)
}

fn bench_pull(path: &str, n: u64, job: Job) {
    let text = read_text(path);
    let bytes = text.len();
    let mut sum: u64 = 0;
    let t0 = Instant::now();
    for _ in 0..n {
        let part = pull_sum(std::hint::black_box(&text), job);
        sum = sum.wrapping_add(std::hint::black_box(part));
    }
    let ms = t0.elapsed().as_millis();
    show_ms(ms, sum, bytes, n);
}

fn main() {
    let mut args = env::args().skip(1);
    let cmd = args.next().unwrap_or_default();
    let a = args.next().unwrap_or_default();
    let b = args.next().unwrap_or_default();
    let _c = args.next().unwrap_or_default();
    match cmd.as_str() {
        "ping" => println!("pong"),
        "json-dec" => cmd_dec(&a, &b),
        "json-enc" => cmd_enc(&a, &b),
        "json-rt" => cmd_rt(&a, &b),
        "bench-json-dec" => {
            let n: u64 = b.parse().unwrap_or(0);
            bench_dec(&a, n);
        }
        "bench-json-enc" => {
            let n: u64 = b.parse().unwrap_or(0);
            bench_enc(&a, n);
        }
        "bench-pull-walk" => {
            let n: u64 = b.parse().unwrap_or(0);
            bench_pull(&a, n, Job::Walk);
        }
        "bench-pull-skip" => {
            let n: u64 = b.parse().unwrap_or(0);
            bench_pull(&a, n, Job::Skip);
        }
        "bench-pull-text" => {
            let n: u64 = b.parse().unwrap_or(0);
            bench_pull(&a, n, Job::Text { depth: 0 });
        }
        "" => die("usage: ezjson-rust-ref <cmd> …"),
        other => die(&format!("unknown command {other}")),
    }
}
'';

  cargoToml = pkgs.writeText "Cargo.toml" cargoTomlText;
  cargoLock = pkgs.writeText "Cargo.lock" cargoLockText;
  mainRs = pkgs.writeText "main.rs" mainRsText;

  src = pkgs.runCommand "ezjson-rust-ref-src" { } ''
    mkdir -p $out/src
    cp ${cargoToml} $out/Cargo.toml
    cp ${cargoLock} $out/Cargo.lock
    cp ${mainRs} $out/src/main.rs
  '';
in
pkgs.rustPlatform.buildRustPackage {
  pname = "ezjson-rust-ref";
  version = "0.1.0";
  inherit src;
  cargoLock = {
    lockFile = cargoLock;
  };
  meta = {
    description = "In-process serde_json reference for ezjson benches";
    mainProgram = "ezjson-rust-ref";
  };
}
