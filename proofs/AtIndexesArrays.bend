# proofs of laws/AtIndexesArrays.bend
import Base
import ../src/value.bend as V
import ../main.bend as Ezjson
import ../laws/AtIndexesArrays.bend as Laws
import ./lemmas/ArrayLength.bend as M1
import ./lemmas/WordArithmetic.bend as M2

def Laws.at_not_arr(val, idx, h_kind):
  match val:
    case V.JNull{}:
      {==}
    case V.JBool{_}:
      {==}
    case V.JNum{_}:
      {==}
    case V.JStr{_}:
      {==}
    case V.JArr{its}:
      Empty.absurd({Ezjson.at(V.JArr{its}, idx) == Ezjson.null() : V.Json},
        M1.true_false(h_kind))
    case V.JObj{_}:
      {==}
    case V.JNil{}:
      {==}
    case V.JCons{_, _}:
      {==}
    case V.JPair{_, _, _}:
      {==}
    case V.JSpan{_, _}:
      {==}
    case V.JBind{_, _, _, _}:
      {==}
