    Parse.close_obj(owns(Parse.FObj{pairs, key, slot} <> rest), Laws.own_m(root), bad) : Parse.P}

def co_own(slot, pairs, key, rest, root, bad):
  match slot:
    case Parse.SKey{}:
      match pairs:
        case V.JNull{}:
          {==}
