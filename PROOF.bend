law lon_cons:
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +w: String
  for +h: {Laws.lit_or_num(w) == True{} : Bool}
  {Laws.lit_or_num(SCon{cc, w}) == False{} : Bool}

