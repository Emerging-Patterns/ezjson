def cls_o_arr(yy, hb, post, ha, cc):
  acc_o(sc.run(post, yy), sc.run(post, sc.stepc(yy, Lex.CPunct{Lex.TOpenArr{}}, cc)), run_o(post, yy, sc.stepc(yy,
    Lex.CPunct{Lex.TOpenArr{}}, cc),
    init_o_arr(yy, hb, cc)), ha)


