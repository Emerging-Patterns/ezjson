      Empty.absurd({sc.acc(SOut{b1, b2}) == False{} : Bool}, acc_c_wo(a1, a2, b1, b2, h, ha))
    case SWord{a1, a2} SWord{b1, b2}:
      Empty.absurd({sc.acc(SWord{b1, b2}) == False{} : Bool}, acc_c_ww(a1, a2, b1, b2, h, ha))
