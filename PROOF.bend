  match its:
    case Nil{}:
      {==}
    case It{+rws, +lx} <> +rest:
      Equal.cong(List<&2, Char>, List<&2, Char>, zz => rlx(lx, List.append(&2, Char, rws, zz)), ritems(rest), ra(rest,
        []), ritems_ra(rest))

# lexemes put back in order spell what they spelled
