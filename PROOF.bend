          no({tj(V.JPair{kk, vv, V.JArr{b1}}, V.WObj{}) == tj_r(fxv(V.JPair{kk, vv, V.JArr{b1}}, V.WObj{}),
            V.WObj{}) : List<&2, Lex.Tok>}, h)
