  for +src: String
  for +nn: U32
  for +vv: V.Json
  for cc: V.Json
  for +kt: List<&2, Lex.Tok>
  {List.append(&2, Lex.Tok, tj_r(V.JBind{src, nn, vv, cc}, V.WObj{}), kt) == Lex.TStr{V.span.str(src, nn,
    U32.is_zero(nn))} <> Lex.TColon{} <> List.append(&2, Lex.Tok, tj_r(vv, V.WVal{}), List.append(&2, Lex.Tok, otk(cc),
    kt)) : List<&2, Lex.Tok>}

