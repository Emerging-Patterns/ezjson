law cpw.t:
  for +ba: List<&2, Char>
  for +dd: Nat
  for +cls: Lex.Class
  for +ch: Char
  cpt(sc.word(ba, dd, cls, ch), gps(Laws.GpOut{True{}}, cls))

def cpw.t(ba, dd, cls, ch):
  match cls:
    case Lex.CPunct{tk}:
      match tk:
        case Lex.TOpenArr{}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TCloseArr{}:
          cpw.t.c1(dd, ba, ch)
        case Lex.TOpenObj{}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TCloseObj{}:
          cpw.t.c2(dd, ba, ch)
        case Lex.TColon{}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, Laws.GpOut{False{}}, Unit{})
        case Lex.TComma{}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, Laws.GpOut{False{}}, Unit{})
        case Lex.TStr{_x0}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TWord{_x0}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TStrS{_x0, _x1}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TWordS{_x0, _x1}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
        case Lex.TBad{}:
          pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
    case Lex.CQuote{}:
      pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpIn{}, Unit{})
    case Lex.CBack{}:
      pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
    case Lex.CSpace{}:
      pick_cp(Laws.lit_or_num(Lex.text(ba)), SOut{LVal{}, dd}, Laws.GpOut{False{}}, Unit{})
    case Lex.COther{}:
      Unit{}


law cpi:
  for +dd: Nat
  for +cls: Lex.Class
  cpt(sc.in(dd, cls), gps(Laws.GpIn{}, cls))

def cpi(_dd, cls):
  match cls:
    case Lex.CPunct{tk}:
      Unit{}
    case Lex.CQuote{}:
      Unit{}
    case Lex.CBack{}:
      Unit{}
    case Lex.CSpace{}:
      Unit{}
    case Lex.COther{}:
      Unit{}


# is_cp 34 is classify's quotation mark
law cq.at:
  for +uu: U32
  for cls: Lex.Class
  for e: {Lex.classify(Chr{uu}) == cls : Lex.Class}
  {U32.is_eq(uu, 34) == is_quote(cls) : Bool}

def cq.at(uu, cls, e):
  match cls:
    case Lex.CPunct{+tk}:
      nq(U32.is_eq(uu, 34), uu, Lex.CPunct{tk}, {==}, e, {==})
    case Lex.CQuote{}:
      Equal.cong(U32, Bool, zz => U32.is_eq(zz, 34), uu, 34, cls_quote(Chr{uu}, e))
    case Lex.CBack{}:
      nq(U32.is_eq(uu, 34), uu, Lex.CBack{}, {==}, e, {==})
    case Lex.CSpace{}:
      nq(U32.is_eq(uu, 34), uu, Lex.CSpace{}, {==}, e, {==})
    case Lex.COther{}:
      nq(U32.is_eq(uu, 34), uu, Lex.COther{}, {==}, e, {==})

law cq:
  for +ch: Char
  {Laws.is_cp(ch, 34) == is_quote(Lex.classify(ch)) : Bool}

def cq(ch):
  match ch:
    case Chr{+uu}:
      cq.at(uu, Lex.classify(Chr{uu}), {==})

# is_cp 92 is classify's reverse solidus
law cb.at:
  for +uu: U32
  for cls: Lex.Class
  for e: {Lex.classify(Chr{uu}) == cls : Lex.Class}
  {U32.is_eq(uu, 92) == is_back(cls) : Bool}

def cb.at(uu, cls, e):
  match cls:
    case Lex.CPunct{+tk}:
      nb(U32.is_eq(uu, 92), uu, Lex.CPunct{tk}, {==}, e, {==})
    case Lex.CQuote{}:
      nb(U32.is_eq(uu, 92), uu, Lex.CQuote{}, {==}, e, {==})
    case Lex.CBack{}:
      Equal.cong(U32, Bool, zz => U32.is_eq(zz, 92), uu, 92, cls_back(Chr{uu}, e))
    case Lex.CSpace{}:
      nb(U32.is_eq(uu, 92), uu, Lex.CSpace{}, {==}, e, {==})
    case Lex.COther{}:
      nb(U32.is_eq(uu, 92), uu, Lex.COther{}, {==}, e, {==})

law cb:
  for +ch: Char
  {Laws.is_cp(ch, 92) == is_back(Lex.classify(ch)) : Bool}

def cb(ch):
  match ch:
    case Chr{+uu}:
      cb.at(uu, Lex.classify(Chr{uu}), {==})

# the gap scan's step reads only the character's class
law gp_eq:
  for +gg: Laws.Gp
  for +ch: Char
  {Laws.gp.step(gg, ch) == gps(gg, Lex.classify(ch)) : Laws.Gp}

def gp_eq(gg, ch):
  match gg:
    case Laws.GpOut{_ww}:
      e1 = cq(ch)
      %e1 : {Bool.pick(Laws.Gp, Laws.is_cp(ch, 34), Laws.GpIn{}, Laws.GpOut{Laws.word_char(ch)}) == Bool.pick(Laws.Gp,
        _,
        Laws.GpIn{}, Laws.GpOut{is_oth(Lex.classify(ch))}) : Laws.Gp}
      e2 = cw(ch)
      %e2 : {Bool.pick(Laws.Gp, Laws.is_cp(ch, 34), Laws.GpIn{}, Laws.GpOut{Laws.word_char(ch)}) == Bool.pick(Laws.Gp,
        Laws.is_cp(ch, 34), Laws.GpIn{}, Laws.GpOut{_}) : Laws.Gp}
      {==}
    case Laws.GpIn{}:
      e1 = cb(ch)
      %e1 : {Bool.pick(Laws.Gp, Laws.is_cp(ch, 92), Laws.GpEsc{}, Bool.pick(Laws.Gp, Laws.is_cp(ch, 34),
        Laws.GpOut{False{}},
        Laws.GpIn{})) == Bool.pick(Laws.Gp, _, Laws.GpEsc{}, Bool.pick(Laws.Gp, is_quote(Lex.classify(ch)),
        Laws.GpOut{False{}}, Laws.GpIn{})) : Laws.Gp}
      e2 = cq(ch)
      %e2 : {Bool.pick(Laws.Gp, Laws.is_cp(ch, 92), Laws.GpEsc{}, Bool.pick(Laws.Gp, Laws.is_cp(ch, 34),
        Laws.GpOut{False{}},
        Laws.GpIn{})) == Bool.pick(Laws.Gp, Laws.is_cp(ch, 92), Laws.GpEsc{}, Bool.pick(Laws.Gp, _, Laws.GpOut{False{}},
        Laws.GpIn{})) : Laws.Gp}
      {==}
    case Laws.GpEsc{}:
      {==}

# a word on the left needs a word character before it
law cpw:
  for +ww: Bool
  for +ba: List<&2, Char>
  for +dd: Nat
  for +cls: Lex.Class
  for +ch: Char
  for h: wt(ww)
  cpt(sc.word(ba, dd, cls, ch), gps(Laws.GpOut{ww}, cls))

def cpw(ww, ba, dd, cls, ch, h):
  match ww:
    case True{}:
      cpw.t(ba, dd, cls, ch)
    case False{}:
      Empty.absurd(cpt(sc.word(ba, dd, cls, ch), gps(Laws.GpOut{False{}}, cls)), h)

# one character keeps the two scans agreeing
law cps:
  for +st: Sc
  for +gg: Laws.Gp
  for +cls: Lex.Class
  for +ch: Char
  for h: cpt(st, gg)
  cpt(sc.stepc(st, cls, ch), gps(gg, cls))

def cps(st, gg, cls, ch, h):
  match st gg:
    case SOut{lt, dd} Laws.GpOut{ww}:
      cpo(lt, dd, ww, cls, ch)
    case SOut{lt, dd} Laws.GpIn{}:
      Empty.absurd(cpt(sc.stepc(SOut{lt, dd}, cls, ch), gps(Laws.GpIn{}, cls)), h)
    case SOut{lt, dd} Laws.GpEsc{}:
      Empty.absurd(cpt(sc.stepc(SOut{lt, dd}, cls, ch), gps(Laws.GpEsc{}, cls)), h)
    case SWord{ba, dd} Laws.GpOut{ww}:
      cpw(ww, ba, dd, cls, ch, h)
    case SWord{ba, dd} Laws.GpIn{}:
      Empty.absurd(cpt(sc.stepc(SWord{ba, dd}, cls, ch), gps(Laws.GpIn{}, cls)), h)
    case SWord{ba, dd} Laws.GpEsc{}:
      Empty.absurd(cpt(sc.stepc(SWord{ba, dd}, cls, ch), gps(Laws.GpEsc{}, cls)), h)
    case SIn{dd} Laws.GpOut{ww}:
      Empty.absurd(cpt(sc.stepc(SIn{dd}, cls, ch), gps(Laws.GpOut{ww}, cls)), h)
    case SIn{dd} Laws.GpIn{}:
      cpi(dd, cls)
    case SIn{dd} Laws.GpEsc{}:
      Empty.absurd(cpt(sc.stepc(SIn{dd}, cls, ch), gps(Laws.GpEsc{}, cls)), h)
    case SEsc{dd} Laws.GpOut{ww}:
      Empty.absurd(cpt(sc.stepc(SEsc{dd}, cls, ch), gps(Laws.GpOut{ww}, cls)), h)
    case SEsc{dd} Laws.GpIn{}:
      Empty.absurd(cpt(sc.stepc(SEsc{dd}, cls, ch), gps(Laws.GpIn{}, cls)), h)
    case SEsc{_dd} Laws.GpEsc{}:
      Unit{}
    case SBad{} _gg:
      Unit{}

law cp1:
  for +st: Sc
  for +gg: Laws.Gp
  for +hd: Char
  for h: cpt(st, gg)
  cpt(sc.step(st, hd), Laws.gp.step(gg, hd))

def cp1(st, gg, hd, h):
  ge = Equal.sym(Laws.Gp, Laws.gp.step(gg, hd), gps(gg, Lex.classify(hd)), gp_eq(gg, hd))
  %ge : cpt(sc.step(st, hd), _)
  cps(st, gg, Lex.classify(hd), hd, h)

# the two scans agree over any text
law cp_run:
  for +txt: String
  for +st: Sc
  for +gg: Laws.Gp
  for h: cpt(st, gg)
  cpt(sc.run(txt, st), Laws.gp.run(txt, gg))

def cp_run(txt, st, gg, h):
  match txt:
    case SNil{}:
      h
    case SCon{+hd, +tl}:
      cp_run(tl, sc.step(st, hd), Laws.gp.step(gg, hd), cp1(st, gg, hd, h))

# JSON-TEXT-2: the classes of character put between tokens

# a word's end and a step, in either order
law pick_step2:
  for bv: Bool
  for +yy: Sc
  for +cls: Lex.Class
  for +ch: Char
  {Bool.pick(Sc, bv, sc.stepc(yy, cls, ch), SBad{}) == sc.stepc(Bool.pick(Sc, bv, yy, SBad{}), cls, ch) : Sc}

def pick_step2(bv, _yy, _cls, _ch):
  match bv:
    case True{}:
      {==}
    case False{}:
      {==}

# a separator right after a word, then no word character
law sep_w.k:
  for +ba: List<&2, Char>
  for +dd: Nat
  for +cls: Lex.Class
  for +ch: Char
  rel_s(Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), sc.out(LVal{}, dd, cls, ch), SBad{}),
    sc.stepc(Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, SBad{}), cls, ch))

def sep_w.k(ba, dd, cls, ch):
  ps = pick_step2(Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, cls, ch)
  %ps : rel_s(Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), sc.out(LVal{}, dd, cls, ch), SBad{}), _)
  pick_lr_s(Laws.lit_or_num(Lex.text(ba)), sc.out(LVal{}, dd, cls, ch), sc.stepc(SOut{LSt{}, dd}, cls, ch),
    cl_s_oo.s(LVal{}, dd, LSt{}, dd, cls, ch, Unit{}))

law sep_w:
  for +ba: List<&2, Char>
  for +dd: Nat
  for +cls: Lex.Class
  for +ch: Char
  for hn: {is_oth(cls) == False{} : Bool}
  rel_s(sc.word(ba, dd, cls, ch), sc.stepc(Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, SBad{}), cls,
    ch))

def sep_w(ba, dd, cls, ch, hn):
  match cls:
    case Lex.CPunct{+tk}:
      sep_w.k(ba, dd, Lex.CPunct{tk}, ch)
    case Lex.CQuote{}:
      sep_w.k(ba, dd, Lex.CQuote{}, ch)
    case Lex.CBack{}:
      sep_w.k(ba, dd, Lex.CBack{}, ch)
    case Lex.CSpace{}:
      sep_w.k(ba, dd, Lex.CSpace{}, ch)
    case Lex.COther{}:
      Empty.absurd(rel_s(sc.word(ba, dd, Lex.COther{}, ch), sc.stepc(Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)),
        SOut{LSt{}, dd}, SBad{}), Lex.COther{}, ch)), true_false(hn))

# a separator right after a word
law sep_word:
  for +ba: List<&2, Char>
  for +dd: Nat
  for +post: String
  for hg: gw(post)
  for ha: {sc.acc(sc.run(post, SWord{ba, dd})) == True{} : Bool}
  {sc.acc(sc.run(post, Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, SBad{}))) == False{} : Bool}

def sep_word(ba, dd, post, hg, ha):
  match post:
    case SNil{}:
      acc_pst(Laws.lit_or_num(Lex.text(ba)), dd)
    case SCon{+hd, +tl}:
      +bb = Bool.pick(Sc, Laws.lit_or_num(Lex.text(ba)), SOut{LSt{}, dd}, SBad{})
      acc_s(sc.run(tl, sc.step(SWord{ba, dd}, hd)), sc.run(tl, sc.step(bb, hd)), run_s(tl, sc.step(SWord{ba, dd}, hd),
        sc.step(bb, hd), sep_w(ba, dd, Lex.classify(hd), hd, hg)), ha)


law io_s_col:
  for +lt: Lt
  for +dd: Nat
  for +cc: Char
  rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TColon{}}, cc))

def io_s_col(lt, _dd, _cc):
  match lt:
    case LSt{}:
      Unit{}
    case LOp{}:
      Unit{}
    case LVal{}:
      Unit{}


law cls_s_col:
  for +yy: Sc
  for hb: bnd(yy)
  for +post: String
  for hg: gapw(yy, post)
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  for +cc: Char
  {sc.acc(sc.run(post, sc.stepc(yy, Lex.CPunct{Lex.TColon{}}, cc))) == False{} : Bool}

def cls_s_col(yy, hb, post, hg, ha, cc):
  match yy:
    case SOut{+lt, +dd}:
      acc_s(sc.run(post, SOut{lt, dd}), sc.run(post, sc.out(lt, dd, Lex.CPunct{Lex.TColon{}}, cc)), run_s(post,
        SOut{lt, dd}, sc.out(lt, dd,
        Lex.CPunct{Lex.TColon{}}, cc), io_s_col(lt, dd, cc)), ha)
    case SWord{+ba, +dd}:
      sep_word(ba, dd, post, hg, ha)
    case SIn{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SIn{dd}, Lex.CPunct{Lex.TColon{}}, cc))) == False{} : Bool}, hb)
    case SEsc{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SEsc{dd}, Lex.CPunct{Lex.TColon{}}, cc))) == False{} : Bool}, hb)
    case SBad{}:
      Equal.cong(Sc, Bool, zz => sc.acc(zz), sc.run(post, SBad{}), SBad{}, sc_bad(post))


law io_s_com:
  for +lt: Lt
  for +dd: Nat
  for +cc: Char
  rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TComma{}}, cc))

def io_s_com(lt, _dd, _cc):
  match lt:
    case LSt{}:
      Unit{}
    case LOp{}:
      Unit{}
    case LVal{}:
      Unit{}


law cls_s_com:
  for +yy: Sc
  for hb: bnd(yy)
  for +post: String
  for hg: gapw(yy, post)
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  for +cc: Char
  {sc.acc(sc.run(post, sc.stepc(yy, Lex.CPunct{Lex.TComma{}}, cc))) == False{} : Bool}

def cls_s_com(yy, hb, post, hg, ha, cc):
  match yy:
    case SOut{+lt, +dd}:
      acc_s(sc.run(post, SOut{lt, dd}), sc.run(post, sc.out(lt, dd, Lex.CPunct{Lex.TComma{}}, cc)), run_s(post,
        SOut{lt, dd}, sc.out(lt, dd,
        Lex.CPunct{Lex.TComma{}}, cc), io_s_com(lt, dd, cc)), ha)
    case SWord{+ba, +dd}:
      sep_word(ba, dd, post, hg, ha)
    case SIn{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SIn{dd}, Lex.CPunct{Lex.TComma{}}, cc))) == False{} : Bool}, hb)
    case SEsc{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SEsc{dd}, Lex.CPunct{Lex.TComma{}}, cc))) == False{} : Bool}, hb)
    case SBad{}:
      Equal.cong(Sc, Bool, zz => sc.acc(zz), sc.run(post, SBad{}), SBad{}, sc_bad(post))

# a word character where a value may come
law iw0:
  for +cc: Char
  for +lt: Lt
  for +dd: Nat
  rel_w(cc, SOut{lt, dd}, sc.wstart(lt, dd, cc))

def iw0(_cc, lt, _dd):
  match lt:
    case LSt{}:
      (Unit{}, {==})
    case LOp{}:
      (Unit{}, {==})
    case LVal{}:
      Unit{}

# a word character right after a word, then no word character
law ww1:
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +ba: List<&2, Char>
  for +dd: Nat
  for +cls: Lex.Class
  for +ch: Char
  for hc: {is_oth(cls) == False{} : Bool}
  rel_w(cc, sc.word(ba, dd, cls, ch), sc.word(cc <> ba, dd, cls, ch))

def ww1(cc, hn, ba, dd, cls, ch, hc):
  match cls:
    case Lex.CPunct{+tk}:
      pick2_w(cc, Laws.lit_or_num(Lex.text(ba)), Laws.lit_or_num(Lex.text(cc <> ba)), sc.out(LVal{}, dd, Lex.CPunct{tk},
        ch), sc.out(LVal{}, dd, Lex.CPunct{tk}, ch), ee => lon_cns(cc, hn, ba, ee))
    case Lex.CQuote{}:
      pick2_w(cc, Laws.lit_or_num(Lex.text(ba)), Laws.lit_or_num(Lex.text(cc <> ba)), sc.out(LVal{}, dd, Lex.CQuote{},
        ch), sc.out(LVal{}, dd, Lex.CQuote{}, ch), ee => lon_cns(cc, hn, ba, ee))
    case Lex.CBack{}:
      pick2_w(cc, Laws.lit_or_num(Lex.text(ba)), Laws.lit_or_num(Lex.text(cc <> ba)), sc.out(LVal{}, dd, Lex.CBack{},
        ch), sc.out(LVal{}, dd, Lex.CBack{}, ch), ee => lon_cns(cc, hn, ba, ee))
    case Lex.CSpace{}:
      pick2_w(cc, Laws.lit_or_num(Lex.text(ba)), Laws.lit_or_num(Lex.text(cc <> ba)), sc.out(LVal{}, dd, Lex.CSpace{},
        ch), sc.out(LVal{}, dd, Lex.CSpace{}, ch), ee => lon_cns(cc, hn, ba, ee))
    case Lex.COther{}:
      Empty.absurd(rel_w(cc, sc.word(ba, dd, Lex.COther{}, ch), sc.word(cc <> ba, dd, Lex.COther{}, ch)),
        true_false(hc))

# a word character right after a word
law word_word:
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +ba: List<&2, Char>
  for +dd: Nat
  for +post: String
  for hg: gw(post)
  for ha: {sc.acc(sc.run(post, SWord{ba, dd})) == True{} : Bool}
  {sc.acc(sc.run(post, SWord{cc <> ba, dd})) == False{} : Bool}

def word_word(cc, hn, ba, dd, post, hg, ha):
  match post:
    case SNil{}:
      ls = Equal.sym(Bool, Laws.lit_or_num(Lex.text(cc <> ba)), False{}, lon_cns(cc, hn, ba,
        tpt(Laws.lit_or_num(Lex.text(ba)), dd, ha)))
      %ls : {sc.top(Bool.pick(Sc, _, SOut{LVal{}, dd}, SBad{})) == False{} : Bool}
      {==}
    case SCon{+hd, +tl}:
      acc_w(cc, hn, sc.run(tl, sc.step(SWord{ba, dd}, hd)), sc.run(tl, sc.step(SWord{cc <> ba, dd}, hd)), run_w(cc, hn,
        tl, sc.step(SWord{ba, dd}, hd), sc.step(SWord{cc <> ba, dd}, hd), ww1(cc, hn, ba, dd, Lex.classify(hd), hd,
          hg)),
        ha)

law cls_w:
  for +yy: Sc
  for hb: bnd(yy)
  for +post: String
  for hg: gapw(yy, post)
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  {sc.acc(sc.run(post, sc.stepc(yy, Lex.COther{}, cc))) == False{} : Bool}

def cls_w(yy, hb, post, hg, ha, cc, hn):
  match yy:
    case SOut{+lt, +dd}:
      acc_w(cc, hn, sc.run(post, SOut{lt, dd}), sc.run(post, sc.wstart(lt, dd, cc)), run_w(cc, hn, post, SOut{lt, dd},
        sc.wstart(lt, dd, cc), iw0(cc, lt, dd)), ha)
    case SWord{+ba, +dd}:
      word_word(cc, hn, ba, dd, post, hg, ha)
    case SIn{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SIn{dd}, Lex.COther{}, cc))) == False{} : Bool}, hb)
    case SEsc{dd}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(SEsc{dd}, Lex.COther{}, cc))) == False{} : Bool}, hb)
    case SBad{}:
      Equal.cong(Sc, Bool, zz => sc.acc(zz), sc.run(post, SBad{}), SBad{}, sc_bad(post))

# a character the scan faults on outside strings
def tbad(tk: Lex.Tok) -> Bool:
  match tk:
    case Lex.TStr{_}:
      True{}
    case Lex.TWord{_}:
      True{}
    case Lex.TStrS{_, _}:
      True{}
    case Lex.TWordS{_, _}:
      True{}
    case Lex.TBad{}:
      True{}
    case _:
      False{}

def cbad(cls: Lex.Class) -> Bool:
  match cls:
    case Lex.CPunct{tk}:
      tbad(tk)
    case Lex.CBack{}:
      True{}
    case _:
      False{}

law ib_o:
  for +cls: Lex.Class
  for +cc: Char
  for +lt: Lt
  for +dd: Nat
  for hbad: {cbad(cls) == True{} : Bool}
  rel_s(SOut{lt, dd}, sc.out(lt, dd, cls, cc))

def ib_o(cls, cc, lt, dd, hbad):
  match cls:
    case Lex.CPunct{tk}:
      match tk:
        case Lex.TOpenArr{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TOpenArr{}}, cc)), hbad)
        case Lex.TCloseArr{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TCloseArr{}}, cc)), hbad)
        case Lex.TOpenObj{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TOpenObj{}}, cc)), hbad)
        case Lex.TCloseObj{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TCloseObj{}}, cc)), hbad)
        case Lex.TColon{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TColon{}}, cc)), hbad)
        case Lex.TComma{}:
          no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CPunct{Lex.TComma{}}, cc)), hbad)
        case Lex.TStr{_x0}:
          Unit{}
        case Lex.TWord{_x0}:
          Unit{}
        case Lex.TStrS{_x0, _x1}:
          Unit{}
        case Lex.TWordS{_x0, _x1}:
          Unit{}
        case Lex.TBad{}:
          Unit{}
    case Lex.CQuote{}:
      no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CQuote{}, cc)), hbad)
    case Lex.CBack{}:
      Unit{}
    case Lex.CSpace{}:
      no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.CSpace{}, cc)), hbad)
    case Lex.COther{}:
      no(rel_s(SOut{lt, dd}, sc.out(lt, dd, Lex.COther{}, cc)), hbad)

law ib_w:
  for +cls: Lex.Class
  for +cc: Char
  for +ba: List<&2, Char>
  for +dd: Nat
  for hbad: {cbad(cls) == True{} : Bool}
  rel_s(SWord{ba, dd}, sc.word(ba, dd, cls, cc))

def ib_w(cls, cc, ba, dd, hbad):
  match cls:
    case Lex.CPunct{tk}:
      match tk:
        case Lex.TOpenArr{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TOpenArr{}}, cc)), hbad)
        case Lex.TCloseArr{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TCloseArr{}}, cc)), hbad)
        case Lex.TOpenObj{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TOpenObj{}}, cc)), hbad)
        case Lex.TCloseObj{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TCloseObj{}}, cc)), hbad)
        case Lex.TColon{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TColon{}}, cc)), hbad)
        case Lex.TComma{}:
          no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CPunct{Lex.TComma{}}, cc)), hbad)
        case Lex.TStr{_x0}:
          pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
        case Lex.TWord{_x0}:
          pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
        case Lex.TStrS{_x0, _x1}:
          pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
        case Lex.TWordS{_x0, _x1}:
          pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
        case Lex.TBad{}:
          pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
    case Lex.CQuote{}:
      no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CQuote{}, cc)), hbad)
    case Lex.CBack{}:
      pick_r_s(Laws.lit_or_num(Lex.text(ba)), SWord{ba, dd}, SBad{}, Unit{})
    case Lex.CSpace{}:
      no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.CSpace{}, cc)), hbad)
    case Lex.COther{}:
      no(rel_s(SWord{ba, dd}, sc.word(ba, dd, Lex.COther{}, cc)), hbad)

law init_b:
  for +yy: Sc
  for hb: bnd(yy)
  for +cls: Lex.Class
  for +cc: Char
  for +hbad: {cbad(cls) == True{} : Bool}
  rel_s(yy, sc.stepc(yy, cls, cc))

def init_b(yy, hb, cls, cc, hbad):
  match yy:
    case SOut{lt, dd}:
      ib_o(cls, cc, lt, dd, hbad)
    case SWord{ba, dd}:
      ib_w(cls, cc, ba, dd, hbad)
    case SIn{dd}:
      Empty.absurd(rel_s(SIn{dd}, sc.stepc(SIn{dd}, cls, cc)), hb)
    case SEsc{dd}:
      Empty.absurd(rel_s(SEsc{dd}, sc.stepc(SEsc{dd}, cls, cc)), hb)
    case SBad{}:
      Unit{}

law cls_b:
  for +yy: Sc
  for hb: bnd(yy)
  for +post: String
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  for +cc: Char
  for +cls: Lex.Class
  for hbad: {cbad(cls) == True{} : Bool}
  {sc.acc(sc.run(post, sc.stepc(yy, cls, cc))) == False{} : Bool}

def cls_b(yy, hb, post, ha, cc, cls, hbad):
  acc_s(sc.run(post, yy), sc.run(post, sc.stepc(yy, cls, cc)), run_s(post, yy, sc.stepc(yy, cls, cc), init_b(yy, hb,
    cls, cc, hbad)), ha)

# JSON-TEXT-2: any character but whitespace, a digit or `-` put at a place
# between tokens: the scan without it accepts, with it it does not
law by_cls.at:
  for +yy: Sc
  for hb: bnd(yy)
  for +post: String
  for hg: gapw(yy, post)
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +hw: {Laws.is_ws(cc) == False{} : Bool}
  for +cls: Lex.Class
  for +e: {Lex.classify(cc) == cls : Lex.Class}
  {sc.acc(sc.run(post, sc.stepc(yy, cls, cc))) == False{} : Bool}

def by_cls.at(yy, hb, post, hg, ha, cc, hn, hw, cls, e):
  match cls:
    case Lex.CPunct{tk}:
      match tk:
        case Lex.TOpenArr{}:
          cls_o_arr(yy, hb, post, ha, cc)
        case Lex.TCloseArr{}:
          cls_c_arr(yy, hb, post, ha, cc)
        case Lex.TOpenObj{}:
          cls_o_obj(yy, hb, post, ha, cc)
        case Lex.TCloseObj{}:
          cls_c_obj(yy, hb, post, ha, cc)
        case Lex.TColon{}:
          cls_s_col(yy, hb, post, hg, ha, cc)
        case Lex.TComma{}:
          cls_s_com(yy, hb, post, hg, ha, cc)
        case Lex.TStr{x0}:
          cls_b(yy, hb, post, ha, cc, Lex.CPunct{Lex.TStr{x0}}, {==})
        case Lex.TWord{x0}:
          cls_b(yy, hb, post, ha, cc, Lex.CPunct{Lex.TWord{x0}}, {==})
        case Lex.TStrS{x0, x1}:
          cls_b(yy, hb, post, ha, cc, Lex.CPunct{Lex.TStrS{x0, x1}}, {==})
        case Lex.TWordS{x0, x1}:
          cls_b(yy, hb, post, ha, cc, Lex.CPunct{Lex.TWordS{x0, x1}}, {==})
        case Lex.TBad{}:
          cls_b(yy, hb, post, ha, cc, Lex.CPunct{Lex.TBad{}}, {==})
    case Lex.CQuote{}:
      cls_q(yy, hb, post, ha, cc)
    case Lex.CBack{}:
      cls_b(yy, hb, post, ha, cc, Lex.CBack{}, {==})
    case Lex.CSpace{}:
      Empty.absurd({sc.acc(sc.run(post, sc.stepc(yy, Lex.CSpace{}, cc))) == False{} : Bool},
        true_false(Equal.trans(Bool, True{}, Laws.is_ws(cc), False{}, Equal.sym(Bool, Laws.is_ws(cc), True{},
        cls_space(cc, e)), hw)))
    case Lex.COther{}:
      cls_w(yy, hb, post, hg, ha, cc, hn)

# after a word, the text after the place starts with no word character
law gw_of:
  for +post: String
  for hg: {Laws.gap.at(Laws.GpOut{True{}}, post) == True{} : Bool}
  gw(post)

def gw_of(post, hg):
  match post:
    case SNil{}:
      Unit{}
    case SCon{+hd, _tl}:
      Equal.trans(Bool, is_oth(Lex.classify(hd)), Laws.word_char(hd), False{}, Equal.sym(Bool, Laws.word_char(hd),
        is_oth(Lex.classify(hd)), cw(hd)), not_true(Laws.word_char(hd), hg))

law ins_w:
  for +ww: Bool
  for +ba: List<&2, Char>
  for +dd: Nat
  for +post: String
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +hw: {Laws.is_ws(cc) == False{} : Bool}
  for hc: wt(ww)
  for hg: {Laws.gap.at(Laws.GpOut{ww}, post) == True{} : Bool}
  for ha: {sc.acc(sc.run(post, SWord{ba, dd})) == True{} : Bool}
  {sc.acc(sc.run(post, sc.step(SWord{ba, dd}, cc))) == False{} : Bool}

def ins_w(ww, ba, dd, post, cc, hn, hw, hc, hg, ha):
  match ww:
    case True{}:
      by_cls.at(SWord{ba, dd}, Unit{}, post, gw_of(post, hg), ha, cc, hn, hw, Lex.classify(cc), {==})
    case False{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SWord{ba, dd}, cc))) == False{} : Bool}, hc)

# the place after the scan of pre: a character put there makes the scan fail
law ins_at:
  for +yy: Sc
  for +gg: Laws.Gp
  for +post: String
  for +cc: Char
  for +hn: {Bool.or(Laws.digit(cc), Laws.is_cp(cc, 45)) == False{} : Bool}
  for +hw: {Laws.is_ws(cc) == False{} : Bool}
  for hc: cpt(yy, gg)
  for hg: {Laws.gap.at(gg, post) == True{} : Bool}
  for ha: {sc.acc(sc.run(post, yy)) == True{} : Bool}
  {sc.acc(sc.run(post, sc.step(yy, cc))) == False{} : Bool}

def ins_at(yy, gg, post, cc, hn, hw, hc, hg, ha):
  match yy gg:
    case SOut{+lt, +dd} Laws.GpOut{_ww}:
      by_cls.at(SOut{lt, dd}, Unit{}, post, Unit{}, ha, cc, hn, hw, Lex.classify(cc), {==})
    case SOut{lt, dd} Laws.GpIn{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SOut{lt, dd}, cc))) == False{} : Bool}, hc)
    case SOut{lt, dd} Laws.GpEsc{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SOut{lt, dd}, cc))) == False{} : Bool}, hc)
    case SWord{ba, dd} Laws.GpOut{ww}:
      ins_w(ww, ba, dd, post, cc, hn, hw, hc, hg, ha)
    case SWord{ba, dd} Laws.GpIn{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SWord{ba, dd}, cc))) == False{} : Bool}, hc)
    case SWord{ba, dd} Laws.GpEsc{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SWord{ba, dd}, cc))) == False{} : Bool}, hc)
    case SIn{dd} Laws.GpOut{ww}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SIn{dd}, cc))) == False{} : Bool}, hc)
    case SIn{dd} Laws.GpIn{}:
      no({sc.acc(sc.run(post, sc.step(SIn{dd}, cc))) == False{} : Bool}, hg)
    case SIn{dd} Laws.GpEsc{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SIn{dd}, cc))) == False{} : Bool}, hc)
    case SEsc{dd} Laws.GpOut{ww}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SEsc{dd}, cc))) == False{} : Bool}, hc)
    case SEsc{dd} Laws.GpIn{}:
      Empty.absurd({sc.acc(sc.run(post, sc.step(SEsc{dd}, cc))) == False{} : Bool}, hc)
    case SEsc{dd} Laws.GpEsc{}:
      no({sc.acc(sc.run(post, sc.step(SEsc{dd}, cc))) == False{} : Bool}, hg)
    case SBad{} _gg:
      no({sc.acc(sc.run(post, sc.step(SBad{}, cc))) == False{} : Bool}, Equal.trans(Bool, False{},
        sc.acc(sc.run(post, SBad{})), True{}, Equal.sym(Bool, sc.acc(sc.run(post, SBad{})), False{}, Equal.cong(Sc,
          Bool,
        zz => sc.acc(zz), sc.run(post, SBad{}), SBad{}, sc_bad(post))), ha))

# a text that parses passes the scan
law acc_td2:
  for +txt: String
  for +wa: String
  for +gg: Laws.Gv
  for +wb: String
  for e: {txt == wa ++ Laws.g.text(gg) ++ wb : String}
  for d: {Laws.derived(wa, gg, wb) == True{} : Bool}
  {sc.acc(sc.run(txt, SOut{LSt{}, 0n})) == True{} : Bool}

def acc_td2(txt, wa, gg, wb, e, d):
  Equal.trans(Bool, sc.acc(sc.run(txt, SOut{LSt{}, 0n})), sc.acc(sc.run(wa ++ Laws.g.text(gg) ++ wb, SOut{LSt{}, 0n})),
    True{}, Equal.cong(String, Bool, zz => sc.acc(sc.run(zz, SOut{LSt{}, 0n})), txt, wa ++ Laws.g.text(gg) ++ wb, e),
    acc_der(wa, gg, wb, d))

law acc_td:
  for +txt: String
  for r: (&wa: String -> &gg: Laws.Gv -> &wb: String -> ({txt == wa ++ Laws.g.text(gg) ++ wb : String} &
    {Laws.derived(wa, gg, wb) == True{} : Bool}))
  {sc.acc(sc.run(txt, SOut{LSt{}, 0n})) == True{} : Bool}

def acc_td(txt, r):
  (wa, (gg, (wb, (e, d)))) = r
  acc_td2(txt, wa, gg, wb, e, d)

law acc_txt:
  for +txt: String
  for h_s: {Laws.short(txt) == True{} : Bool}
  for h_p: {Laws.is_some(Ezjson.parse(txt)) == True{} : Bool}
  {sc.acc(sc.run(txt, SOut{LSt{}, 0n})) == True{} : Bool}

def acc_txt(txt, h_s, h_p):
  acc_td(txt, Laws.text_derives(txt, h_s, h_p))

# a parse result that is not Some is None
law none_of:
  for +mb: Maybe<&2, V.Json>
  for h: {Laws.is_some(mb) == False{} : Bool}
  {mb == None{} : Maybe<&2, V.Json>}

def none_of(mb, h):
  match mb:
    case None{}:
      {==}
    case Some{_jj}:
      Empty.absurd({Some{_jj} == None{} : Maybe<&2, V.Json>}, true_false(h))

# a text the scan does not accept does not parse
law none_by.at:
  for bv: Bool
  for +txt: String
  for e: {Laws.is_some(Ezjson.parse(txt)) == bv : Bool}
  for h_t: {Laws.short(txt) == True{} : Bool}
  for k: {sc.acc(sc.run(txt, SOut{LSt{}, 0n})) == False{} : Bool}
  {Ezjson.parse(txt) == None{} : Maybe<&2, V.Json>}

def none_by.at(bv, txt, e, h_t, k):
  match bv:
    case True{}:
      Empty.absurd({Ezjson.parse(txt) == None{} : Maybe<&2, V.Json>}, true_false(Equal.trans(Bool, True{},
        sc.acc(sc.run(txt, SOut{LSt{}, 0n})), False{}, Equal.sym(Bool, sc.acc(sc.run(txt, SOut{LSt{}, 0n})), True{},
        acc_txt(txt, h_t, e)), k)))
    case False{}:
      none_of(Ezjson.parse(txt), e)

def Laws.ins_none(pre, post, ch, h_p, h_g, h_w, h_n, h_s, h_t):
  k2 = Equal.trans(Bool, sc.acc(sc.run(post, sc.run(pre, SOut{LSt{}, 0n}))), sc.acc(sc.run(pre ++ post, SOut{LSt{},
    0n})), True{}, Equal.cong(Sc, Bool,
    zz => sc.acc(zz), sc.run(post, sc.run(pre, SOut{LSt{}, 0n})), sc.run(pre ++ post, SOut{LSt{}, 0n}), Equal.sym(Sc,
      sc.run(pre ++ post, SOut{LSt{}, 0n}), sc.run(post, sc.run(pre, SOut{LSt{}, 0n})),
    sc_app(pre, post, SOut{LSt{}, 0n}))), acc_txt(pre ++ post, h_s, h_p))
  k3 = ins_at(sc.run(pre, SOut{LSt{}, 0n}), Laws.gp.run(pre, Laws.GpOut{False{}}), post, ch, h_n, h_w, cp_run(pre,
    SOut{LSt{}, 0n}, Laws.GpOut{False{}},
    Unit{}), h_g, k2)
  k4 = Equal.trans(Bool, sc.acc(sc.run(pre ++ SCon{ch, post}, SOut{LSt{}, 0n})), sc.acc(sc.run(SCon{ch, post},
    sc.run(pre, SOut{LSt{}, 0n}))), False{},
    Equal.cong(Sc, Bool, zz => sc.acc(zz), sc.run(pre ++ SCon{ch, post}, SOut{LSt{}, 0n}), sc.run(SCon{ch, post},
      sc.run(pre, SOut{LSt{}, 0n})), sc_app(pre,
    SCon{ch, post}, SOut{LSt{}, 0n})), k3)
  none_by.at(Laws.is_some(Ezjson.parse(pre ++ SCon{ch, post})), pre ++ SCon{ch, post}, {==}, h_t, k4)

# JSON-TREE-6: Nat arithmetic, for as_u32's U32 steps

# the predecessor of a Nat
def npred(nn: Nat) -> Nat:
  match nn:
    case 0n:
      0n
    case 1n+(+pp):
      pp

# adding 0 on the right
law nat_add_zero:
  for +aa: Nat
  {Nat.add(aa, 0n) == aa : Nat}

def nat_add_zero(aa):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(pp, 0n), pp, nat_add_zero(pp))

# adding one more on the right
law nat_add_succ:
  for +aa: Nat
  for +bb: Nat
  {Nat.add(aa, 1n+bb) == 1n+Nat.add(aa, bb) : Nat}

def nat_add_succ(aa, bb):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(pp, 1n+bb), 1n+Nat.add(pp, bb), nat_add_succ(pp, bb))

# addition commutes
law nat_add_comm:
  for +aa: Nat
  for +bb: Nat
  {Nat.add(aa, bb) == Nat.add(bb, aa) : Nat}

def nat_add_comm(aa, bb):
  match aa:
    case 0n:
      Equal.sym(Nat, Nat.add(bb, 0n), bb, nat_add_zero(bb))
    case 1n+(+pp):
      Equal.trans(Nat, 1n+Nat.add(pp, bb), 1n+Nat.add(bb, pp), Nat.add(bb, 1n+pp),
        Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(pp, bb), Nat.add(bb, pp), nat_add_comm(pp, bb)),
        Equal.sym(Nat, Nat.add(bb, 1n+pp), 1n+Nat.add(bb, pp), nat_add_succ(bb, pp)))

# addition associates
law nat_add_assoc:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.add(Nat.add(aa, bb), cc) == Nat.add(aa, Nat.add(bb, cc)) : Nat}

def nat_add_assoc(aa, bb, cc):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(Nat.add(pp, bb), cc), Nat.add(pp, Nat.add(bb, cc)),
        nat_add_assoc(pp, bb, cc))

# the first two of three addends swap
law nat_add_lcomm:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.add(aa, Nat.add(bb, cc)) == Nat.add(bb, Nat.add(aa, cc)) : Nat}

def nat_add_lcomm(aa, bb, cc):
  Equal.trans(Nat, Nat.add(aa, Nat.add(bb, cc)), Nat.add(Nat.add(aa, bb), cc), Nat.add(bb, Nat.add(aa, cc)),
    Equal.sym(Nat, Nat.add(Nat.add(aa, bb), cc), Nat.add(aa, Nat.add(bb, cc)), nat_add_assoc(aa, bb, cc)),
    Equal.trans(Nat, Nat.add(Nat.add(aa, bb), cc), Nat.add(Nat.add(bb, aa), cc), Nat.add(bb, Nat.add(aa, cc)),
      Equal.cong(Nat, Nat, xx => Nat.add(xx, cc), Nat.add(aa, bb), Nat.add(bb, aa), nat_add_comm(aa, bb)),
      nat_add_assoc(bb, aa, cc)))

# a common left addend cancels
law nat_add_cancel:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  for h: {Nat.add(aa, bb) == Nat.add(aa, cc) : Nat}
  {bb == cc : Nat}

def nat_add_cancel(aa, bb, cc, h):
  match aa:
    case 0n:
      h
    case 1n+(+pp):
      nat_add_cancel(pp, bb, cc, Equal.cong(Nat, Nat, xx => npred(xx), 1n+Nat.add(pp, bb), 1n+Nat.add(pp, cc), h))

# doubling is adding to itself
law nat_double:
  for +aa: Nat
  {Nat.double(aa) == Nat.add(aa, aa) : Nat}

def nat_double(aa):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.trans(Nat, 2n+Nat.double(pp), 2n+Nat.add(pp, pp), 1n+Nat.add(pp, 1n+pp),
        Equal.cong(Nat, Nat, xx => 2n+xx, Nat.double(pp), Nat.add(pp, pp), nat_double(pp)),
        Equal.cong(Nat, Nat, xx => 1n+xx, 1n+Nat.add(pp, pp), Nat.add(pp, 1n+pp),
          Equal.sym(Nat, Nat.add(pp, 1n+pp), 1n+Nat.add(pp, pp), nat_add_succ(pp, pp))))

# doubling a sum doubles each addend
law nat_double_add:
  for +aa: Nat
  for +bb: Nat
  {Nat.double(Nat.add(aa, bb)) == Nat.add(Nat.double(aa), Nat.double(bb)) : Nat}

def nat_double_add(aa, bb):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.cong(Nat, Nat, xx => 2n+xx, Nat.double(Nat.add(pp, bb)), Nat.add(Nat.double(pp), Nat.double(bb)),
        nat_double_add(pp, bb))

# multiplication distributes over a sum on the left
law nat_mul_add_r:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.mul(Nat.add(aa, bb), cc) == Nat.add(Nat.mul(aa, cc), Nat.mul(bb, cc)) : Nat}

def nat_mul_add_r(aa, bb, cc):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.trans(Nat, Nat.add(cc, Nat.mul(Nat.add(pp, bb), cc)),
        Nat.add(cc, Nat.add(Nat.mul(pp, cc), Nat.mul(bb, cc))),
        Nat.add(Nat.add(cc, Nat.mul(pp, cc)), Nat.mul(bb, cc)),
        Equal.cong(Nat, Nat, xx => Nat.add(cc, xx), Nat.mul(Nat.add(pp, bb), cc),
          Nat.add(Nat.mul(pp, cc), Nat.mul(bb, cc)), nat_mul_add_r(pp, bb, cc)),
        Equal.sym(Nat, Nat.add(Nat.add(cc, Nat.mul(pp, cc)), Nat.mul(bb, cc)),
          Nat.add(cc, Nat.add(Nat.mul(pp, cc), Nat.mul(bb, cc))), nat_add_assoc(cc, Nat.mul(pp, cc), Nat.mul(bb, cc))))

# multiplication distributes over a sum on the right
law nat_mul_add_l:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.mul(aa, Nat.add(bb, cc)) == Nat.add(Nat.mul(aa, bb), Nat.mul(aa, cc)) : Nat}

def nat_mul_add_l(aa, bb, cc):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.trans(Nat, Nat.add(Nat.add(bb, cc), Nat.mul(pp, Nat.add(bb, cc))),
        Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))), Nat.add(Nat.add(bb, Nat.mul(pp, bb)),
          Nat.add(cc, Nat.mul(pp, cc))),
        Equal.cong(Nat, Nat, xx => Nat.add(Nat.add(bb, cc), xx), Nat.mul(pp, Nat.add(bb, cc)),
          Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc)), nat_mul_add_l(pp, bb, cc)),
        Equal.trans(Nat, Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))), Nat.add(Nat.mul(pp, bb),
          Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Nat.add(Nat.add(bb, Nat.mul(pp, bb)), Nat.add(cc, Nat.mul(pp,
          cc))), Equal.trans(Nat, Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))),
          Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))), Nat.add(Nat.mul(pp, bb),
          Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Equal.cong(Nat, Nat, z1 => Nat.add(z1, Nat.add(Nat.mul(pp, bb),
          Nat.mul(pp, cc))), Nat.add(bb, cc), Nat.add(bb, cc), {==}), Equal.trans(Nat, Nat.add(Nat.add(bb, cc),
          Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))), Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp,
          cc))), Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Equal.cong(Nat, Nat,
          z2 => Nat.add(Nat.add(bb, cc), z2), Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc)), Nat.add(Nat.mul(pp, bb),
          Nat.mul(pp, cc)), {==}), Equal.trans(Nat, Nat.add(Nat.add(bb, cc), Nat.add(Nat.mul(pp, bb), Nat.mul(pp,
          cc))), Nat.add(bb, Nat.add(cc, Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc)))), Nat.add(Nat.mul(pp, bb),
          Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), nat_add_assoc(bb, cc, Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))),
          Equal.trans(Nat, Nat.add(bb, Nat.add(cc, Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc)))), Nat.add(bb,
          Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), cc))), Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc),
          Nat.add(bb, cc))), Equal.cong(Nat, Nat, z4 => Nat.add(bb, z4), Nat.add(cc, Nat.add(Nat.mul(pp, bb),
          Nat.mul(pp, cc))), Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), cc)), Equal.trans(Nat, Nat.add(cc,
          Nat.add(Nat.mul(pp, bb), Nat.mul(pp, cc))), Nat.add(Nat.mul(pp, bb), Nat.add(cc, Nat.mul(pp, cc))),
          Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), cc)), nat_add_lcomm(cc, Nat.mul(pp, bb), Nat.mul(pp, cc)),
          Equal.cong(Nat, Nat, z3 => Nat.add(Nat.mul(pp, bb), z3), Nat.add(cc, Nat.mul(pp, cc)), Nat.add(Nat.mul(pp,
          cc), cc), nat_add_comm(cc, Nat.mul(pp, cc))))), Equal.trans(Nat, Nat.add(bb, Nat.add(Nat.mul(pp, bb),
          Nat.add(Nat.mul(pp, cc), cc))), Nat.add(Nat.mul(pp, bb), Nat.add(bb, Nat.add(Nat.mul(pp, cc), cc))),
          Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), nat_add_lcomm(bb, Nat.mul(pp, bb),
          Nat.add(Nat.mul(pp, cc), cc)), Equal.cong(Nat, Nat, z5 => Nat.add(Nat.mul(pp, bb), z5), Nat.add(bb,
          Nat.add(Nat.mul(pp, cc), cc)), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc)), nat_add_lcomm(bb, Nat.mul(pp, cc),
          cc))))))), Equal.sym(Nat, Nat.add(Nat.add(bb, Nat.mul(pp, bb)), Nat.add(cc, Nat.mul(pp, cc))),
          Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Equal.trans(Nat, Nat.add(Nat.add(bb,
          Nat.mul(pp, bb)), Nat.add(cc, Nat.mul(pp, cc))), Nat.add(Nat.add(Nat.mul(pp, bb), bb), Nat.add(cc,
          Nat.mul(pp, cc))), Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Equal.cong(Nat, Nat,
          z6 => Nat.add(z6, Nat.add(cc, Nat.mul(pp, cc))), Nat.add(bb, Nat.mul(pp, bb)), Nat.add(Nat.mul(pp, bb), bb),
          nat_add_comm(bb, Nat.mul(pp, bb))), Equal.trans(Nat, Nat.add(Nat.add(Nat.mul(pp, bb), bb), Nat.add(cc,
          Nat.mul(pp, cc))), Nat.add(Nat.add(Nat.mul(pp, bb), bb), Nat.add(Nat.mul(pp, cc), cc)), Nat.add(Nat.mul(pp,
          bb), Nat.add(Nat.mul(pp, cc), Nat.add(bb, cc))), Equal.cong(Nat, Nat, z7 => Nat.add(Nat.add(Nat.mul(pp, bb),
          bb), z7), Nat.add(cc, Nat.mul(pp, cc)), Nat.add(Nat.mul(pp, cc), cc), nat_add_comm(cc, Nat.mul(pp, cc))),
          Equal.trans(Nat, Nat.add(Nat.add(Nat.mul(pp, bb), bb), Nat.add(Nat.mul(pp, cc), cc)), Nat.add(Nat.mul(pp,
          bb), Nat.add(bb, Nat.add(Nat.mul(pp, cc), cc))), Nat.add(Nat.mul(pp, bb), Nat.add(Nat.mul(pp, cc),
          Nat.add(bb, cc))), nat_add_assoc(Nat.mul(pp, bb), bb, Nat.add(Nat.mul(pp, cc), cc)), Equal.cong(Nat, Nat,
          z8 => Nat.add(Nat.mul(pp, bb), z8), Nat.add(bb, Nat.add(Nat.mul(pp, cc), cc)), Nat.add(Nat.mul(pp, cc),
          Nat.add(bb, cc)), nat_add_lcomm(bb, Nat.mul(pp, cc), cc))))))))

# twice a on the left
law nat_mul_double_l:
  for +aa: Nat
  for +bb: Nat
  {Nat.mul(Nat.double(aa), bb) == Nat.double(Nat.mul(aa, bb)) : Nat}

def nat_mul_double_l(aa, bb):
  Equal.trans(Nat, Nat.mul(Nat.double(aa), bb), Nat.mul(Nat.add(aa, aa), bb), Nat.double(Nat.mul(aa, bb)),
    Equal.cong(Nat, Nat, xx => Nat.mul(xx, bb), Nat.double(aa), Nat.add(aa, aa), nat_double(aa)),
    Equal.trans(Nat, Nat.mul(Nat.add(aa, aa), bb), Nat.add(Nat.mul(aa, bb), Nat.mul(aa, bb)),
      Nat.double(Nat.mul(aa, bb)), nat_mul_add_r(aa, aa, bb),
      Equal.sym(Nat, Nat.double(Nat.mul(aa, bb)), Nat.add(Nat.mul(aa, bb), Nat.mul(aa, bb)),
        nat_double(Nat.mul(aa, bb)))))

# twice b on the right
law nat_mul_double_r:
  for +aa: Nat
  for +bb: Nat
  {Nat.mul(aa, Nat.double(bb)) == Nat.double(Nat.mul(aa, bb)) : Nat}

def nat_mul_double_r(aa, bb):
  Equal.trans(Nat, Nat.mul(aa, Nat.double(bb)), Nat.mul(aa, Nat.add(bb, bb)), Nat.double(Nat.mul(aa, bb)),
    Equal.cong(Nat, Nat, xx => Nat.mul(aa, xx), Nat.double(bb), Nat.add(bb, bb), nat_double(bb)),
    Equal.trans(Nat, Nat.mul(aa, Nat.add(bb, bb)), Nat.add(Nat.mul(aa, bb), Nat.mul(aa, bb)),
      Nat.double(Nat.mul(aa, bb)), nat_mul_add_l(aa, bb, bb),
      Equal.sym(Nat, Nat.double(Nat.mul(aa, bb)), Nat.add(Nat.mul(aa, bb), Nat.mul(aa, bb)),
        nat_double(Nat.mul(aa, bb)))))

# multiplication associates
law nat_mul_assoc:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.mul(Nat.mul(aa, bb), cc) == Nat.mul(aa, Nat.mul(bb, cc)) : Nat}

def nat_mul_assoc(aa, bb, cc):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.trans(Nat, Nat.mul(Nat.add(bb, Nat.mul(pp, bb)), cc),
        Nat.add(Nat.mul(bb, cc), Nat.mul(Nat.mul(pp, bb), cc)), Nat.add(Nat.mul(bb, cc), Nat.mul(pp, Nat.mul(bb, cc))),
        nat_mul_add_r(bb, Nat.mul(pp, bb), cc),
        Equal.cong(Nat, Nat, xx => Nat.add(Nat.mul(bb, cc), xx), Nat.mul(Nat.mul(pp, bb), cc),
          Nat.mul(pp, Nat.mul(bb, cc)), nat_mul_assoc(pp, bb, cc)))

# a multiple of 0 is 0
law nat_mul_zero:
  for +aa: Nat
  {Nat.mul(aa, 0n) == 0n : Nat}

def nat_mul_zero(aa):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      nat_mul_zero(pp)

# 1 times a
law nat_mul_one:
  for +aa: Nat
  {Nat.mul(aa, 1n) == aa : Nat}

def nat_mul_one(aa):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.mul(pp, 1n), pp, nat_mul_one(pp))

# a Nat compares equal to itself
law nat_cmp_refl:
  for +aa: Nat
  {Nat.cmp(aa, aa) == EQ{} : Cmp}

def nat_cmp_refl(aa):
  match aa:
    case 0n:
      {==}
    case 1n+(+pp):
      nat_cmp_refl(pp)

# a less 0 is a
law nat_sub_zero:
  for +aa: Nat
  {Nat.sub(aa, 0n) == aa : Nat}

def nat_sub_zero(aa):
  match aa:
    case 0n:
      {==}
    case 1n+_pp:
      {==}

# nothing is below 0
law nat_nlt_zero:
  for +aa: Nat
  {Nat.is_lt(aa, 0n) == False{} : Bool}

def nat_nlt_zero(aa):
  match aa:
    case 0n:
      {==}
    case 1n+_pp:
      {==}

# a sum is never below its left addend
law nat_nlt_add:
  for +aa: Nat
  for +bb: Nat
  {Nat.is_lt(Nat.add(aa, bb), aa) == False{} : Bool}

def nat_nlt_add(aa, bb):
  match aa:
    case 0n:
      nat_nlt_zero(bb)
    case 1n+(+pp):
      nat_nlt_add(pp, bb)

# a sum whose left addend is not below c is not below c
law nat_ge_add:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  for h: {Nat.is_lt(aa, cc) == False{} : Bool}
  {Nat.is_lt(Nat.add(aa, bb), cc) == False{} : Bool}

def nat_ge_add(aa, bb, cc, h):
  match aa cc:
    case 0n 0n:
      nat_nlt_zero(bb)
    case 0n 1n+_cp:
      Empty.absurd({Nat.is_lt(bb, cc) == False{} : Bool}, true_false(h))
    case 1n+_ap 0n:
      {==}
    case 1n+(+ap) 1n+(+cp):
      nat_ge_add(ap, bb, cp, h)

# below c is below c + 1
law nat_lt_succ:
  for +aa: Nat
  for +cc: Nat
  for h: {Nat.is_lt(aa, cc) == True{} : Bool}
  {Nat.is_lt(aa, 1n+cc) == True{} : Bool}

def nat_lt_succ(aa, cc, h):
  match aa cc:
    case 0n 0n:
      {==}
    case 0n 1n+_cp:
      {==}
    case 1n+_ap 0n:
      Empty.absurd({Nat.is_lt(aa, 1n) == True{} : Bool}, false_true(h))
    case 1n+(+ap) 1n+(+cp):
      nat_lt_succ(ap, cp, h)

# below c, the right addend of a sum below c is below c too
law nat_lt_add_l:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  for h: {Nat.is_lt(Nat.add(aa, bb), cc) == True{} : Bool}
  {Nat.is_lt(bb, cc) == True{} : Bool}

def nat_lt_add_l(aa, bb, cc, h):
  match aa:
    case 0n:
      h
    case 1n+(+ap):
      match cc:
        case 0n:
          Empty.absurd({Nat.is_lt(bb, 0n) == True{} : Bool}, false_true(h))
        case 1n+(+cp):
          nat_lt_succ(bb, cp, nat_lt_add_l(ap, bb, cp, h))

# a Nat below c is below c + y
law nat_lt_add_r:
  for +aa: Nat
  for +cc: Nat
  for +yy: Nat
  for h: {Nat.is_lt(aa, cc) == True{} : Bool}
  {Nat.is_lt(aa, Nat.add(cc, yy)) == True{} : Bool}

def nat_lt_add_r(aa, cc, yy, h):
  match aa cc:
    case 0n 0n:
      Empty.absurd({Nat.is_lt(0n, yy) == True{} : Bool}, false_true(h))
    case 0n 1n+_cp:
      {==}
    case 1n+_ap 0n:
      Empty.absurd({Nat.is_lt(aa, yy) == True{} : Bool}, false_true(h))
    case 1n+(+ap) 1n+(+cp):
      nat_lt_add_r(ap, cp, yy, h)

# the witness of a < b: b is a, one, and b - (a + 1)
law nat_lt_ex:
  for +aa: Nat
  for +bb: Nat
  for h: {Nat.is_lt(aa, bb) == True{} : Bool}
  {1n+Nat.add(aa, Nat.sub(bb, 1n+aa)) == bb : Nat}

def nat_lt_ex(aa, bb, h):
  match aa bb:
    case 0n 0n:
      Empty.absurd({1n == 0n : Nat}, false_true(h))
    case 0n 1n+(+bp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.sub(bp, 0n), bp, nat_sub_zero(bp))
    case 1n+_ap 0n:
      Empty.absurd({1n+Nat.add(aa, Nat.sub(0n, 1n+aa)) == 0n : Nat}, false_true(h))
    case 1n+(+ap) 1n+(+bp):
      Equal.cong(Nat, Nat, xx => 1n+xx, 1n+Nat.add(ap, Nat.sub(bp, 1n+ap)), bp, nat_lt_ex(ap, bp, h))

# the witness of a >= b: a is b and a - b
law nat_ge_ex:
  for +aa: Nat
  for +bb: Nat
  for h: {Nat.is_lt(aa, bb) == False{} : Bool}
  {Nat.add(bb, Nat.sub(aa, bb)) == aa : Nat}

def nat_ge_ex(aa, bb, h):
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+_bp:
      Empty.absurd({Nat.add(bb, Nat.sub(0n, bb)) == 0n : Nat}, true_false(h))
    case 1n+_ap 0n:
      {==}
    case 1n+(+ap) 1n+(+bp):
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(bp, Nat.sub(ap, bp)), ap, nat_ge_ex(ap, bp, h))

# a + 1 + z is never a
law nat_add_ne:
  for +aa: Nat
  for +zz: Nat
  for h: {Nat.add(aa, 1n+zz) == aa : Nat}
  Empty

def nat_add_ne(aa, zz, h):
  match aa:
    case 0n:
      false_true(Equal.cong(Nat, Bool, xx => Nat.is_eq(xx, 0n), 1n+zz, 0n, h))
    case 1n+(+ap):
      nat_add_ne(ap, zz, Equal.cong(Nat, Nat, xx => npred(xx), 1n+Nat.add(ap, 1n+zz), 1n+ap, h))

# a sum a + (c + y) is below c only when false
law nat_nlt_add2:
  for +aa: Nat
  for +cc: Nat
  for +yy: Nat
  {Nat.is_lt(Nat.add(aa, Nat.add(cc, yy)), cc) == False{} : Bool}

def nat_nlt_add2(aa, cc, yy):
  lc = Equal.sym(Nat, Nat.add(aa, Nat.add(cc, yy)), Nat.add(cc, Nat.add(aa, yy)), nat_add_lcomm(aa, cc, yy))
  %lc : {Nat.is_lt(_, cc) == False{} : Bool}
  nat_nlt_add(cc, Nat.add(aa, yy))

# s + k*t is e and e is below t: k is 0, and s is e
law nat_mod_small:
  for +kk: Nat
  for +ss: Nat
  for +ee: Nat
  for +tt: Nat
  for h: {Nat.add(ss, Nat.mul(kk, tt)) == ee : Nat}
  for he: {Nat.is_lt(ee, tt) == True{} : Bool}
  {ss == ee : Nat}

def nat_mod_small(kk, ss, ee, tt, h, he):
  match kk:
    case 0n:
      Equal.trans(Nat, ss, Nat.add(ss, 0n), ee, Equal.sym(Nat, Nat.add(ss, 0n), ss, nat_add_zero(ss)), h)
    case 1n+(+kp):
      Empty.absurd({ss == ee : Nat},
        true_false(Equal.trans(Bool, True{}, Nat.is_lt(ee, tt), False{},
          Equal.sym(Bool, Nat.is_lt(ee, tt), True{}, he),
          Equal.trans(Bool, Nat.is_lt(ee, tt), Nat.is_lt(Nat.add(ss, Nat.add(tt, Nat.mul(kp, tt))), tt), False{},
            Equal.cong(Nat, Bool, xx => Nat.is_lt(xx, tt), ee, Nat.add(ss, Nat.add(tt, Nat.mul(kp, tt))),
              Equal.sym(Nat, Nat.add(ss, Nat.add(tt, Nat.mul(kp, tt))), ee, h)),
            nat_nlt_add2(ss, tt, Nat.mul(kp, tt))))))

# JSON-TREE-6: words as Nats

# a bit as a Nat
def bit_nat(bb: Bool) -> Nat:
  match bb:
    case False{}:
      0n
    case True{}:
      1n

# 2^nn
def pow2(nn: Nat) -> Nat:
  match nn:
    case 0n:
      1n
    case 1n+pp:
      Nat.double(pow2(pp))

# 2^nn once uu is known. The checker expands a closed Nat to unary to compare
# it, and 2^32 is too large for that, so a lemma about U32s takes a unit uu
# and names 2^32 as pow2u(32n, uu), which stays unexpanded
def pow2u(nn: Nat, uu: Unit) -> Nat:
  match uu:
    case Unit{}:
      pow2(nn)

# a word one bit wider, as a Nat: its low bit and twice the rest
law w_nat_con:
  for pp: Nat
  for bb: Bool
  for ww: Word(pp)
  {Word.to_nat(1n+pp, WCon{bb, ww}) == Nat.add(bit_nat(bb), Nat.double(Word.to_nat(pp, ww))) : Nat}

def w_nat_con(_pp, bb, _ww):
  match bb:
    case False{}:
      {==}
    case True{}:
      {==}

# below y, twice x is below twice y
law nat_lt_dbl:
  for +xx: Nat
  for +yy: Nat
  for h: {Nat.is_lt(xx, yy) == True{} : Bool}
  {Nat.is_lt(Nat.double(xx), Nat.double(yy)) == True{} : Bool}

def nat_lt_dbl(xx, yy, h):
  match xx yy:
    case 0n 0n:
      h
    case 0n 1n+_yp:
      {==}
    case 1n+_xp 0n:
      Empty.absurd({Nat.is_lt(Nat.double(xx), 0n) == True{} : Bool}, false_true(h))
    case 1n+(+xp) 1n+(+yp):
      nat_lt_dbl(xp, yp, h)

# below y, twice x and one is below twice y
law nat_lt_dbl1:
  for +xx: Nat
  for +yy: Nat
  for h: {Nat.is_lt(xx, yy) == True{} : Bool}
  {Nat.is_lt(1n+Nat.double(xx), Nat.double(yy)) == True{} : Bool}

def nat_lt_dbl1(xx, yy, h):
  match xx yy:
    case 0n 0n:
      h
    case 0n 1n+_yp:
      {==}
    case 1n+_xp 0n:
      Empty.absurd({Nat.is_lt(1n+Nat.double(xx), 0n) == True{} : Bool}, false_true(h))
    case 1n+(+xp) 1n+(+yp):
      nat_lt_dbl1(xp, yp, h)

# a word of nn bits is below 2^nn
law w_bound:
  for +nn: Nat
  for ww: Word(nn)
  {Nat.is_lt(Word.to_nat(nn, ww), pow2(nn)) == True{} : Bool}

def w_bound(nn, ww):
  match nn:
    case 0n:
      match ww:
        case WNil{}:
          {==}
    case 1n+(+pp):
      match ww:
        case WCon{False{}, +tt}:
          nat_lt_dbl(Word.to_nat(pp, tt), pow2(pp), w_bound(pp, tt))
        case WCon{True{}, +tt}:
          nat_lt_dbl1(Word.to_nat(pp, tt), pow2(pp), w_bound(pp, tt))

# w_bound, with 2^nn named through uu
law w_bound_u:
  for +nn: Nat
  for uu: Unit
  for ww: Word(nn)
  {Nat.is_lt(Word.to_nat(nn, ww), pow2u(nn, uu)) == True{} : Bool}

def w_bound_u(nn, uu, ww):
  match uu:
    case Unit{}:
      w_bound(nn, ww)

# comparing a bit and twice a Nat: the rest decides, the bit breaks a tie
law nat_cmp_bits:
  for +aa: Nat
  for +bb: Nat
  for xx: Bool
  for yy: Bool
  {Nat.cmp(Nat.add(bit_nat(xx), Nat.double(aa)), Nat.add(bit_nat(yy), Nat.double(bb))) ==
    Word.cmp.fin(xx, yy, Nat.cmp(aa, bb)) : Cmp}

def nat_cmp_bits(aa, bb, xx, yy):
  match aa bb:
    case 0n 0n:
      match xx yy:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 1n+(+ap) 0n:
      match xx yy:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 0n 1n+(+bp):
      match xx yy:
        case False{} False{}:
          {==}
        case False{} True{}:
          {==}
        case True{} False{}:
          {==}
        case True{} True{}:
          {==}
    case 1n+(+ap) 1n+(+bp):
      match xx yy:
        case False{} False{}:
          nat_cmp_bits(ap, bp, False{}, False{})
        case False{} True{}:
          nat_cmp_bits(ap, bp, False{}, True{})
        case True{} False{}:
          nat_cmp_bits(ap, bp, True{}, False{})
        case True{} True{}:
          nat_cmp_bits(ap, bp, True{}, True{})

# words compare as the Nats they are
law w_cmp:
  for +nn: Nat
  for aa: Word(nn)
  for bb: Word(nn)
  {Word.cmp(nn, aa, bb) == Nat.cmp(Word.to_nat(nn, aa), Word.to_nat(nn, bb)) : Cmp}

def w_cmp(nn, aa, bb):
  match nn:
    case 0n:
      match aa bb:
        case WNil{} WNil{}:
          {==}
    case 1n+(+pp):
      match aa bb:
        case WCon{False{}, +at} WCon{False{}, +bt}:
          Equal.trans(Cmp, Word.cmp.fin(False{}, False{}, Word.cmp(pp, at, bt)), Word.cmp.fin(False{}, False{},
            Nat.cmp(Word.to_nat(pp, at), Word.to_nat(pp, bt))),
            Nat.cmp(Nat.add(bit_nat(False{}), Nat.double(Word.to_nat(pp, at))), Nat.add(bit_nat(False{}),
              Nat.double(Word.to_nat(pp, bt)))),
