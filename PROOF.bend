# pretty's text is its derivation's text
law pq.text:
  for +val: V.Json
  for +h_wf: {V.wf(val) == True{} : Bool}
  {Laws.g.text(pq.g(val, "", "")) ++ "" == Ezjson.pretty(val) : String}

def pq.text(val, h_wf):
  +gg = pq.g(val, "", "")
  Equal.trans(String, Laws.g.text(gg) ++ "", gt(gg, ""), Ezjson.pretty(val), gt_eq(gg, ""),
    Equal.trans(String, gt(gg, ""), Ezjson.pretty(val) ++ "", Ezjson.pretty(val),
      Equal.sym(String, Ezjson.pretty(val) ++ "", gt(gg, ""), pq.tl(val, "", "", V.WVal{}, "", h_wf)),
      append_nil(Ezjson.pretty(val))))

def Laws.pretty_parse(val, h_wf, h_s):
  +gg = pq.g(val, "", "")
  +et = pq.text(val, h_wf)
  es = Equal.trans(Bool, Laws.short(Laws.g.text(gg) ++ ""), Laws.short(Ezjson.pretty(val)), True{},
    Equal.cong(String, Bool, zz => Laws.short(zz), Laws.g.text(gg) ++ "", Ezjson.pretty(val), et), h_s)
  Equal.trans(Maybe<&2, V.Json>, Laws.own_m(Ezjson.parse(Ezjson.pretty(val))),
    Laws.own_m(Ezjson.parse(Laws.g.text(gg) ++ "")), Some{Laws.fixv(Laws.own(val))},
    Equal.cong(String, Maybe<&2, V.Json>, zz => Laws.own_m(Ezjson.parse(zz)), Ezjson.pretty(val),
      Laws.g.text(gg) ++ "", Equal.sym(String, Laws.g.text(gg) ++ "", Ezjson.pretty(val), et)),
    Equal.trans(Maybe<&2, V.Json>, Laws.own_m(Ezjson.parse(Laws.g.text(gg) ++ "")), Some{Laws.g.val(gg)},
      Some{Laws.fixv(Laws.own(val))},
      Laws.text_some(gg, "", "", pq.ok(val, "", "", V.WVal{}, h_wf, {==}, {==}), {==}, {==}, es),
      Equal.cong(V.Json, Maybe<&2, V.Json>, zz => Some{zz}, Laws.g.val(gg), Laws.fixv(Laws.own(val)),
        pq.val(val, "", "", V.WVal{}, h_wf))))
