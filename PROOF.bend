  rel_q(sc.in(da, Lex.CPunct{Lex.TOpenObj{}}), sc.out(lb, db, Lex.CPunct{Lex.TOpenObj{}}, ch))

def cl_q_io.s.c3(lb, _da, _db, _ch):
