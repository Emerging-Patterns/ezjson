# a Cmp below EQ is not at least EQ
law cmp_lt_nge:
  for cc: Cmp
  for h: {Cmp.is_lt(cc) == True{} : Bool}
  {Cmp.is_ge(cc) == False{} : Bool}

def cmp_lt_nge(cc, h):
  match cc:
    case LT{}:
      {==}
    case EQ{}:
      Empty.absurd({True{} == False{} : Bool}, false_true(h))
    case GT{}:
      Empty.absurd({True{} == False{} : Bool}, false_true(h))

# a Cmp not below EQ is at least EQ
law cmp_nlt_ge:
  for cc: Cmp
  for h: {Cmp.is_lt(cc) == False{} : Bool}
  {Cmp.is_ge(cc) == True{} : Bool}

def cmp_nlt_ge(cc, h):
  match cc:
    case LT{}:
      Empty.absurd({False{} == True{} : Bool}, true_false(h))
    case EQ{}:
      {==}
    case GT{}:
      {==}

# below b + 1 is at most b
law nat_lt_le:
  for aa: Nat
  for bb: Nat
  {Nat.is_lt(aa, 1n+bb) == Cmp.is_le(Nat.cmp(aa, bb)) : Bool}

def nat_lt_le(aa, bb):
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+_bp:
      {==}
    case 1n+ap 0n:
      nat_nlt_zero(ap)
    case 1n+ap 1n+bp:
      nat_lt_le(ap, bp)

# a Bool that is not True is False
law bool_false:
  for bb: Bool
  for h: {bb == True{} : Bool} -> Empty
  {bb == False{} : Bool}

def bool_false(bb, h):
  match bb:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({True{} == False{} : Bool}, h({==}))

