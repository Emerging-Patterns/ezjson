law cpo.c7:
  for +lt: Lt
  for +dd: Nat
  for +ww: Bool
  for +ch: Char
  cpt(sc.out(lt, dd, Lex.CQuote{}, ch), gps(Laws.GpOut{ww}, Lex.CQuote{}))

def cpo.c7(lt, _dd, _ww, _ch):
