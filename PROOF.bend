  {tj_r(V.JPair{sp, vh, Laws.g.val(rr)}, V.WObj{}) == Lex.TStr{sp} <> Lex.TColon{} <> List.append(&2, Lex.Tok, tj_r(vh,
    V.WVal{}), co(rr)) : List<&2, Lex.Tok>}

def co_eq(sp, vh, rr, h):
