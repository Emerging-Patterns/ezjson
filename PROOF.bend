# a scalar value's piece stands for the value
law pq.pl_char:
  for +uu: U32
  for b34: Bool
  for b92: Bool
  for b8: Bool
  for b12: Bool
  for b10: Bool
  for b13: Bool
  for b9: Bool
  for bc: Bool
  for e34: {U32.is_eq(uu, 34) == b34 : Bool}
  for e92: {U32.is_eq(uu, 92) == b92 : Bool}
  for e8: {U32.is_eq(uu, 8) == b8 : Bool}
  for e12: {U32.is_eq(uu, 12) == b12 : Bool}
  for e10: {U32.is_eq(uu, 10) == b10 : Bool}
  for e13: {U32.is_eq(uu, 13) == b13 : Bool}
  for e9: {U32.is_eq(uu, 9) == b9 : Bool}
  for ec: {U32.is_lt(uu, 32) == bc : Bool}
  {Laws.piece.char(pq.pl(uu, b34, b92, b8, b12, b10, b13, b9, bc)) == Chr{uu} : Char}

def pq.pl_char(uu, b34, b92, b8, b12, b10, b13, b9, bc, e34, e92, e8, e12, e10, e13, e9, ec):
  match b34:
    case True{}:
      Equal.sym(Char, Chr{uu}, Chr{34}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 34, ueq(uu, 34, e34)))
    case False{}:
      match b92:
        case True{}:
          Equal.sym(Char, Chr{uu}, Chr{92}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 92, ueq(uu, 92, e92)))
        case False{}:
          match b8:
            case True{}:
              Equal.sym(Char, Chr{uu}, Chr{8}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 8, ueq(uu, 8, e8)))
            case False{}:
              match b12:
                case True{}:
                  Equal.sym(Char, Chr{uu}, Chr{12}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 12, ueq(uu, 12, e12)))
                case False{}:
                  match b10:
                    case True{}:
                      Equal.sym(Char, Chr{uu}, Chr{10}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 10, ueq(uu, 10, e10)))
                    case False{}:
                      match b13:
                        case True{}:
                          Equal.sym(Char, Chr{uu}, Chr{13}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 13, ueq(uu, 13,
                            e13)))
                        case False{}:
                          match b9:
                            case True{}:
                              Equal.sym(Char, Chr{uu}, Chr{9}, Equal.cong(U32, Char, xx => Chr{xx}, uu, 9, ueq(uu, 9,
                                e9)))
                            case False{}:
                              match bc:
                                case True{}:
                                  pq.ctl_char(uu, ec)
                                case False{}:
                                  {==}

# a scalar value's piece is well spelled
law pq.pl_ok:
  for +uu: U32
  for b34: Bool
  for b92: Bool
  for b8: Bool
  for b12: Bool
  for b10: Bool
  for b13: Bool
  for b9: Bool
  for bc: Bool
  for e34: {U32.is_eq(uu, 34) == b34 : Bool}
  for e92: {U32.is_eq(uu, 92) == b92 : Bool}
  for e8: {U32.is_eq(uu, 8) == b8 : Bool}
  for e12: {U32.is_eq(uu, 12) == b12 : Bool}
  for e10: {U32.is_eq(uu, 10) == b10 : Bool}
  for e13: {U32.is_eq(uu, 13) == b13 : Bool}
  for e9: {U32.is_eq(uu, 9) == b9 : Bool}
  for ec: {U32.is_lt(uu, 32) == bc : Bool}
  {Laws.piece.ok(pq.pl(uu, b34, b92, b8, b12, b10, b13, b9, bc)) == True{} : Bool}

def pq.pl_ok(uu, b34, b92, b8, b12, b10, b13, b9, bc, e34, e92, _e8, _e12, _e10, _e13, _e9, ec):
  match b34:
    case True{}:
      {==}
    case False{}:
      match b92:
        case True{}:
          {==}
        case False{}:
          match b8:
            case True{}:
              {==}
            case False{}:
              match b12:
                case True{}:
                  {==}
                case False{}:
                  match b10:
                    case True{}:
                      {==}
                    case False{}:
                      match b13:
                        case True{}:
                          {==}
                        case False{}:
                          match b9:
                            case True{}:
                              {==}
                            case False{}:
                              match bc:
                                case True{}:
                                  pq.ctl_ok(uu, ec)
                                case False{}:
                                  s34 = Equal.sym(Bool, U32.is_eq(uu, 34), False{}, e34)
                                  s92 = Equal.sym(Bool, U32.is_eq(uu, 92), False{}, e92)
                                  sc = Equal.sym(Bool, U32.is_lt(uu, 32), False{}, ec)
                                  %s34 : {Bool.not(Bool.or(_, Bool.or(U32.is_eq(uu, 92), U32.is_lt(uu,
                                    32)))) == True{} : Bool}
                                  %s92 : {Bool.not(Bool.or(False{}, Bool.or(_, U32.is_lt(uu, 32)))) == True{} : Bool}
                                  %sc : {Bool.not(Bool.or(False{}, Bool.or(False{}, _))) == True{} : Bool}
                                  {==}

# a code point's piece stands for it as print writes it
law pq.sc_char:
  for +uu: U32
  for ns: Bool
  {Laws.piece.char(pq.sc(uu, ns)) == Bool.pick(Char, ns, Char.from_u32(65533), Chr{uu}) : Char}

def pq.sc_char(uu, ns):
  match ns:
    case True{}:
      {==}
    case False{}:
      pq.pl_char(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 8), U32.is_eq(uu, 12), U32.is_eq(uu, 10),
        U32.is_eq(uu, 13), U32.is_eq(uu, 9), U32.is_lt(uu, 32),
        {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a code point's piece is well spelled
law pq.sc_ok:
  for +uu: U32
  for ns: Bool
  {Laws.piece.ok(pq.sc(uu, ns)) == True{} : Bool}

def pq.sc_ok(uu, ns):
  match ns:
    case True{}:
      {==}
    case False{}:
      pq.pl_ok(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 8), U32.is_eq(uu, 12), U32.is_eq(uu, 10),
        U32.is_eq(uu, 13), U32.is_eq(uu, 9), U32.is_lt(uu, 32),
        {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==})

# a character's piece stands for the character as print writes it
law pq.pc_char:
  for +ch: Char
  {Laws.piece.char(pq.pc(ch)) == Laws.fix_char(ch) : Char}

def pq.pc_char(ch):
  match ch:
    case Chr{+uu}:
      pq.sc_char(uu, Laws.non_scalar(uu))

# a character's piece is well spelled
law pq.pc_ok:
  for +ch: Char
  {Laws.piece.ok(pq.pc(ch)) == True{} : Bool}

def pq.pc_ok(ch):
  match ch:
    case Chr{+uu}:
      pq.sc_ok(uu, Laws.non_scalar(uu))

# a string's pieces stand for the string as print writes it
law pq.pcs_spelled:
  for +txt: String
  {Laws.spelled(pq.pcs(txt)) == Laws.fix_str(txt) : String}

def pq.pcs_spelled(txt):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      Equal.trans(String, SCon{Laws.piece.char(pq.pc(hd)), Laws.spelled(pq.pcs(tl))},
        SCon{Laws.fix_char(hd), Laws.spelled(pq.pcs(tl))}, SCon{Laws.fix_char(hd), Laws.fix_str(tl)},
        Equal.cong(Char, String, zz => SCon{zz, Laws.spelled(pq.pcs(tl))}, Laws.piece.char(pq.pc(hd)),
          Laws.fix_char(hd), pq.pc_char(hd)),
        Equal.cong(String, String, zz => SCon{Laws.fix_char(hd), zz}, Laws.spelled(pq.pcs(tl)), Laws.fix_str(tl),
          pq.pcs_spelled(tl)))

# a string's pieces are well spelled
law pq.pcs_ok:
  for +txt: String
  {Laws.spell_ok(pq.pcs(txt)) == True{} : Bool}

def pq.pcs_ok(txt):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      eh = Equal.sym(Bool, Laws.piece.ok(pq.pc(hd)), True{}, pq.pc_ok(hd))
      et = Equal.sym(Bool, Laws.spell_ok(pq.pcs(tl)), True{}, pq.pcs_ok(tl))
      %eh : {Bool.and(_, Laws.spell_ok(pq.pcs(tl))) == True{} : Bool}
      %et : {Bool.and(True{}, _) == True{} : Bool}
      {==}


# Second, a derivation of pretty's text, built from the value. The
# whitespace after an element or member is `close` when it is the last
def pq.w(tl: V.Json, +close: String) -> String:
  match tl:
    case V.JNil{}:
      close
    case _:
      ""

# a derivation whose text is pretty.go's: a newline and `ind` start each
# element or member of a chain of cells, and `close` follows the last one
def pq.g(val: V.Json, +ind: String, +close: String) -> Laws.Gv:
  match val:
    case V.JNull{}:
      Laws.GWord{"null"}
    case V.JBool{True{}}:
      Laws.GWord{"true"}
    case V.JBool{False{}}:
      Laws.GWord{"false"}
    case V.JNum{raw}:
      Laws.GWord{raw}
    case V.JStr{s}:
      Laws.GStr{pq.pcs(s)}
    case V.JSpan{src, +n}:
      Laws.GStr{pq.pcs(V.span.str(src, n, U32.is_zero(n)))}
    case V.JArr{V.JCons{h, +t}}:
      +inner = "  " ++ ind
      Laws.GArr{"\n" ++ inner, pq.g(h, inner, ""), pq.w(t, "\n" ++ ind), pq.g(t, inner, "\n" ++ ind)}
    case V.JArr{_}:
      Laws.GArr0{""}
    case V.JObj{V.JPair{k, v, +r}}:
      +inner = "  " ++ ind
      Laws.GObj{"\n" ++ inner, pq.pcs(k), "", " ", pq.g(v, inner, ""), pq.w(r, "\n" ++ ind), pq.g(r, inner,
        "\n" ++ ind)}
    case V.JObj{V.JBind{src, +n, v, +r}}:
      +inner = "  " ++ ind
      Laws.GObj{"\n" ++ inner, pq.pcs(V.span.str(src, n, U32.is_zero(n))), "", " ", pq.g(v, inner, ""),
        pq.w(r, "\n" ++ ind), pq.g(r, inner, "\n" ++ ind)}
    case V.JObj{_}:
      Laws.GObj0{""}
    case V.JNil{}:
      Laws.GEnd{}
    case V.JCons{h, +t}:
      Laws.GNext{"\n" ++ ind, pq.g(h, ind, ""), pq.w(t, close), pq.g(t, ind, close)}
    case V.JPair{k, v, +r}:
      Laws.GNextM{"\n" ++ ind, pq.pcs(k), "", " ", pq.g(v, ind, ""), pq.w(r, close), pq.g(r, ind, close)}
    case V.JBind{src, +n, v, +r}:
      Laws.GNextM{"\n" ++ ind, pq.pcs(V.span.str(src, n, U32.is_zero(n))), "", " ", pq.g(v, ind, ""), pq.w(r, close),
        pq.g(r, ind, close)}

# the text of a chain of cells in front of a tail, from its first element or
# member on, grouped to the right as gt groups it
def pq.ct(val: V.Json, +ind: String, +close: String, tail: String) -> String:
  match val:
    case V.JCons{h, +t}:
      gt(pq.g(h, ind, ""), pq.w(t, close) ++ gt(pq.g(t, ind, close), tail))
    case V.JPair{k, v, +r}:
      SCon{'"', sp(pq.pcs(k), SCon{'"', "" ++ SCon{':', " " ++ gt(pq.g(v, ind, ""), pq.w(r, close) ++ gt(pq.g(r,
        ind, close), tail))}})}
    case V.JBind{src, +n, v, +r}:
      SCon{'"', sp(pq.pcs(V.span.str(src, n, U32.is_zero(n))), SCon{'"', "" ++ SCon{':', " " ++ gt(pq.g(v, ind, ""),
        pq.w(r, close) ++ gt(pq.g(r, ind, close), tail))}})}
    case _:
      tail

# what pretty.go's text in front of a tail is: a value's derivation, or a
# chain's cells
def pq.tx(val: V.Json, +ind: String, +close: String, sh: V.Shape, tail: String) -> String:
  match sh:
    case V.WVal{}:
      gt(pq.g(val, ind, close), tail)
    case _:
      pq.ct(val, ind, close, tail)

# the claim pq.tl makes of one value or chain
def pq.goal(val: V.Json, ind: String, close: String, sh: V.Shape, tail: String) -> Type:
  {Print.pretty.go(val, ind, close) ++ tail == pq.tx(val, ind, close, sh, tail) : String}

# print's escaped string in front of a quotation mark is the string's pieces
law pq.q:
  for +txt: String
  for +tail: String
  {Print.escape(String.to_list(txt)) ++ SCon{'"', tail} == sp(pq.pcs(txt), SCon{'"', tail}) : String}

def pq.q(txt, tail):
  Equal.trans(String, Print.escape(String.to_list(txt)) ++ SCon{'"', tail}, Laws.spell(pq.pcs(txt)) ++ SCon{'"', tail},
    sp(pq.pcs(txt), SCon{'"', tail}),
    Equal.cong(String, String, zz => zz ++ SCon{'"', tail}, Print.escape(String.to_list(txt)), Laws.spell(pq.pcs(txt)),
      Equal.sym(String, Laws.spell(pq.pcs(txt)), Print.escape(String.to_list(txt)), pq.pcs_text(txt))),
    sp_eq(pq.pcs(txt), SCon{'"', tail}))

# a quoted string in front of a tail
law pq.qt:
  for +txt: String
  for +tail: String
  {Print.quote(txt) ++ tail == SCon{'"', sp(pq.pcs(txt), SCon{'"', tail})} : String}

def pq.qt(txt, tail):
  Equal.cong(String, String, zz => SCon{'"', zz}, (Print.escape(String.to_list(txt)) ++ "\"") ++ tail,
    sp(pq.pcs(txt), SCon{'"', tail}),
    app3(Print.escape(String.to_list(txt)), "\"", tail, SCon{'"', tail}, sp(pq.pcs(txt), SCon{'"', tail}), {==},
      pq.q(txt, tail)))

# a member's name, then the rest, in front of a tail
law pq.mem:
  for +txt: String
  for +mm: String
  for +tail: String
  for +qq: String
  for em: {mm ++ tail == qq : String}
  {(Print.quote(txt) ++ mm) ++ tail == SCon{'"', sp(pq.pcs(txt), SCon{'"', qq})} : String}

def pq.mem(txt, mm, tail, qq, em):
  Equal.trans(String, (Print.quote(txt) ++ mm) ++ tail, Print.quote(txt) ++ (mm ++ tail),
    SCon{'"', sp(pq.pcs(txt), SCon{'"', qq})}, sassoc(Print.quote(txt), mm, tail),
    Equal.trans(String, Print.quote(txt) ++ (mm ++ tail), Print.quote(txt) ++ qq,
      SCon{'"', sp(pq.pcs(txt), SCon{'"', qq})},
      Equal.cong(String, String, zz => Print.quote(txt) ++ zz, mm ++ tail, qq, em), pq.qt(txt, qq)))

# an element or member that is not the last: its text, a comma, `ind` and the
# rest, in front of a tail
law pq.cell:
  for +aa: String
  for +ind: String
  for +rr: String
  for +tail: String
  for +cc: String
  for +gg: String
  for er: {rr ++ tail == cc : String}
  for eh: {aa ++ SCon{',', ind ++ cc} == gg : String}
  {(aa ++ ("," ++ (ind ++ rr))) ++ tail == gg : String}

def pq.cell(aa, ind, rr, tail, cc, gg, er, eh):
  app3(aa, "," ++ (ind ++ rr), tail, SCon{',', ind ++ cc}, gg,
    Equal.cong(String, String, zz => SCon{',', zz}, (ind ++ rr) ++ tail, ind ++ cc, app3(ind, rr, tail, cc, ind ++ cc,
      er, {==})), eh)

# the last element or member: its text and `close`, in front of a tail
law pq.last:
  for +aa: String
  for +close: String
  for +tail: String
  for +gg: String
  for eh: {aa ++ (close ++ tail) == gg : String}
  {(aa ++ close) ++ tail == gg : String}

def pq.last(aa, close, tail, gg, eh):
  app3(aa, close, tail, close ++ tail, gg, {==}, eh)

# a container's inside and its closing bracket, in front of a tail
law pq.wrap:
  for +inner: String
  for +pp: String
  for +br: Char
  for +tail: String
  for +cc: String
  for ep: {pp ++ SCon{br, tail} == cc : String}
  {(inner ++ (pp ++ SCon{br, ""})) ++ tail == inner ++ cc : String}

def pq.wrap(inner, pp, br, tail, cc, ep):
  app3(inner, pp ++ SCon{br, ""}, tail, cc, inner ++ cc, app3(pp, SCon{br, ""}, tail, SCon{br, tail}, cc, {==}, ep),
    {==})


# the left side of a Lazy.stop that wf.go takes as an and
law pq.left:
  for aa: Bool
  for -bb: Bool
  for h: {Lazy.stop(Bool, Bool.not(aa), False{}, _u => bb) == True{} : Bool}
  {aa == True{} : Bool}

def pq.left(aa, _bb, h):
  match aa:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, false_true(h))

# the right side of a Lazy.stop that wf.go takes as an and
law pq.right:
  for aa: Bool
  for -bb: Bool
  for h: {Lazy.stop(Bool, Bool.not(aa), False{}, _u => bb) == True{} : Bool}
  {bb == True{} : Bool}

def pq.right(aa, bb, h):
  match aa:
    case True{}:
      h
    case False{}:
      Empty.absurd({bb == True{} : Bool}, false_true(h))

# pretty.go's text in front of a tail is the derivation's, for a
# well-formed value or chain
law pq.tl:
  for +val: V.Json
  for +ind: String
  for +close: String
  for sh: V.Shape
  for +tail: String
  for +h: {V.wf.go(val, sh) == True{} : Bool}
  {Print.pretty.go(val, ind, close) ++ tail == pq.tx(val, ind, close, sh, tail) : String}

def pq.tl(val, ind, close, sh, tail, h):
  match val sh:
    case V.JNull{} V.WVal{}:
      {==}
    case V.JNull{} V.WArr{}:
      Empty.absurd(pq.goal(V.JNull{}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JNull{} V.WObj{}:
      Empty.absurd(pq.goal(V.JNull{}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JBool{True{}} V.WVal{}:
      {==}
    case V.JBool{False{}} V.WVal{}:
      {==}
    case V.JBool{bl} V.WArr{}:
      Empty.absurd(pq.goal(V.JBool{bl}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JBool{bl} V.WObj{}:
      Empty.absurd(pq.goal(V.JBool{bl}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JNum{raw} V.WVal{}:
      {==}
    case V.JNum{raw} V.WArr{}:
      Empty.absurd(pq.goal(V.JNum{raw}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JNum{raw} V.WObj{}:
      Empty.absurd(pq.goal(V.JNum{raw}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JStr{+s} V.WVal{}:
      pq.qt(s, tail)
    case V.JStr{s} V.WArr{}:
      Empty.absurd(pq.goal(V.JStr{s}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JStr{s} V.WObj{}:
      Empty.absurd(pq.goal(V.JStr{s}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JSpan{src, +n} V.WVal{}:
      pq.qt(V.span.str(src, n, U32.is_zero(n)), tail)
    case V.JSpan{src, n} V.WArr{}:
      Empty.absurd(pq.goal(V.JSpan{src, n}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JSpan{src, n} V.WObj{}:
      Empty.absurd(pq.goal(V.JSpan{src, n}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JArr{V.JNull{}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JNull{}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JBool{bl}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JBool{bl}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JNum{raw}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JNum{raw}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JStr{s}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JStr{s}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JSpan{src, n}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JSpan{src, n}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JArr{items}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JArr{items}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JObj{pairs}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JObj{pairs}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JNil{}} V.WVal{}:
      {==}
    case V.JArr{V.JCons{+hh, +tt}} V.WVal{}:
      +inner = "  " ++ ind
      Equal.cong(String, String, zz => SCon{'[', SCon{'\n', zz}}, (inner ++ (Print.pretty.go(V.JCons{hh, tt}, inner,
        "\n" ++ ind) ++ "]")) ++ tail,
        inner ++ pq.ct(V.JCons{hh, tt}, inner, "\n" ++ ind, SCon{']', tail}),
        pq.wrap(inner, Print.pretty.go(V.JCons{hh, tt}, inner, "\n" ++ ind), ']', tail, pq.ct(V.JCons{hh, tt}, inner,
          "\n" ++ ind, SCon{']', tail}),
          pq.tl(V.JCons{hh, tt}, inner, "\n" ++ ind, V.WArr{}, SCon{']', tail}, h)))
    case V.JArr{V.JPair{k, v, r}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JPair{k, v, r}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{V.JBind{src, n, v, r}} V.WVal{}:
      Empty.absurd(pq.goal(V.JArr{V.JBind{src, n, v, r}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JArr{items} V.WArr{}:
      Empty.absurd(pq.goal(V.JArr{items}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JArr{items} V.WObj{}:
      Empty.absurd(pq.goal(V.JArr{items}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JObj{V.JNull{}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JNull{}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JBool{bl}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JBool{bl}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JNum{raw}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JNum{raw}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JStr{s}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JStr{s}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JSpan{src, n}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JSpan{src, n}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JArr{items}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JArr{items}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JObj{pairs}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JObj{pairs}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JNil{}} V.WVal{}:
      {==}
    case V.JObj{V.JCons{hh, tt}} V.WVal{}:
      Empty.absurd(pq.goal(V.JObj{V.JCons{hh, tt}}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JObj{V.JPair{+k, +v, +r}} V.WVal{}:
      +inner = "  " ++ ind
      Equal.cong(String, String, zz => SCon{'{', SCon{'\n', zz}}, (inner ++ (Print.pretty.go(V.JPair{k, v, r}, inner,
        "\n" ++ ind) ++ "}")) ++ tail,
        inner ++ pq.ct(V.JPair{k, v, r}, inner, "\n" ++ ind, SCon{'}', tail}),
        pq.wrap(inner, Print.pretty.go(V.JPair{k, v, r}, inner, "\n" ++ ind), '}', tail, pq.ct(V.JPair{k, v, r}, inner,
          "\n" ++ ind, SCon{'}', tail}),
          pq.tl(V.JPair{k, v, r}, inner, "\n" ++ ind, V.WObj{}, SCon{'}', tail}, h)))
    case V.JObj{V.JBind{+src, +n, +v, +r}} V.WVal{}:
      +inner = "  " ++ ind
      Equal.cong(String, String, zz => SCon{'{', SCon{'\n', zz}}, (inner ++ (Print.pretty.go(V.JBind{src, n, v, r},
        inner, "\n" ++ ind) ++ "}")) ++ tail,
        inner ++ pq.ct(V.JBind{src, n, v, r}, inner, "\n" ++ ind, SCon{'}', tail}),
        pq.wrap(inner, Print.pretty.go(V.JBind{src, n, v, r}, inner, "\n" ++ ind), '}', tail, pq.ct(V.JBind{src, n, v,
          r}, inner, "\n" ++ ind, SCon{'}', tail}),
          pq.tl(V.JBind{src, n, v, r}, inner, "\n" ++ ind, V.WObj{}, SCon{'}', tail}, h)))
    case V.JObj{pairs} V.WArr{}:
      Empty.absurd(pq.goal(V.JObj{pairs}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JObj{pairs} V.WObj{}:
      Empty.absurd(pq.goal(V.JObj{pairs}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JNil{} V.WVal{}:
      Empty.absurd(pq.goal(V.JNil{}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JNil{} V.WArr{}:
      {==}
    case V.JNil{} V.WObj{}:
      {==}
    case V.JCons{hh, tt} V.WVal{}:
      Empty.absurd(pq.goal(V.JCons{hh, tt}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JCons{+hh, V.JNull{}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JNull{}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JNull{}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JBool{bl2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JBool{bl2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JBool{bl2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JNum{raw2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JNum{raw2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JNum{raw2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JStr{s2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JStr{s2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JStr{s2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JSpan{src2, n2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JSpan{src2, n2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JSpan{src2, n2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JArr{items2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JArr{items2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JArr{items2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JObj{pairs2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JObj{pairs2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JObj{pairs2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JNil{}} V.WArr{}:
      eh = pq.left(V.wf.go(hh, V.WVal{}), V.wf.go(V.JNil{}, V.WArr{}), h)
      pq.last(Print.pretty.go(hh, ind, ""), close, tail, gt(pq.g(hh, ind, ""), close ++ tail),
        pq.tl(hh, ind, "", V.WVal{}, close ++ tail, eh))
    case V.JCons{+hh, V.JCons{+h2, +t2}} V.WArr{}:
      eh = pq.left(V.wf.go(hh, V.WVal{}), V.wf.go(V.JCons{h2, t2}, V.WArr{}), h)
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JCons{h2, t2}, V.WArr{}), h)
      +cc = pq.ct(V.JCons{h2, t2}, ind, close, tail)
      pq.cell(Print.pretty.go(hh, ind, ""), "\n" ++ ind, Print.pretty.go(V.JCons{h2, t2}, ind, close), tail, cc,
        gt(pq.g(hh, ind, ""), SCon{',', "\n" ++ ind ++ cc}), pq.tl(V.JCons{h2, t2}, ind, close, V.WArr{}, tail, et),
        pq.tl(hh, ind, "", V.WVal{}, SCon{',', "\n" ++ ind ++ cc}, eh))
    case V.JCons{+hh, V.JPair{k2, v2, r2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JPair{k2, v2, r2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JPair{k2, v2, r2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{+hh, V.JBind{src2, n2, v2, r2}} V.WArr{}:
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(V.JBind{src2, n2, v2, r2}, V.WArr{}), h)
      Empty.absurd(pq.goal(V.JCons{hh, V.JBind{src2, n2, v2, r2}}, ind, close, V.WArr{}, tail), false_true(et))
    case V.JCons{hh, tt} V.WObj{}:
      Empty.absurd(pq.goal(V.JCons{hh, tt}, ind, close, V.WObj{}, tail), false_true(h))
    case V.JPair{k, v, r} V.WVal{}:
      Empty.absurd(pq.goal(V.JPair{k, v, r}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JPair{k, v, r} V.WArr{}:
      Empty.absurd(pq.goal(V.JPair{k, v, r}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JPair{+k, +v, V.JNull{}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JNull{}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JNull{}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JBool{bl2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JBool{bl2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JBool{bl2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JNum{raw2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JNum{raw2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JNum{raw2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JStr{s2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JStr{s2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JStr{s2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JSpan{src2, n2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JSpan{src2, n2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JSpan{src2, n2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JArr{items2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JArr{items2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JArr{items2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JObj{pairs2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JObj{pairs2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JObj{pairs2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JNil{}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JNil{}, V.WObj{}), h)
      +gv = gt(pq.g(v, ind, ""), close ++ tail)
      pq.mem(k, ": " ++ (Print.pretty.go(v, ind, "") ++ close), tail, SCon{':', SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, (Print.pretty.go(v, ind, "") ++ close) ++ tail,
          gv, pq.last(Print.pretty.go(v, ind, ""), close, tail, gv, pq.tl(v, ind, "", V.WVal{}, close ++ tail, ev))))
    case V.JPair{+k, +v, V.JCons{hh2, tt2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JCons{hh2, tt2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JPair{k, v, V.JCons{hh2, tt2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JPair{+k, +v, V.JPair{+k2, +v2, +r2}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JPair{k2, v2, r2}, V.WObj{}), h)
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JPair{k2, v2, r2}, V.WObj{}), h)
      +cc = pq.ct(V.JPair{k2, v2, r2}, ind, close, tail)
      +gv = gt(pq.g(v, ind, ""), SCon{',', "\n" ++ ind ++ cc})
      +rest = Print.pretty.go(v, ind, "") ++ (",\n" ++ ind ++ Print.pretty.go(V.JPair{k2, v2, r2}, ind, close))
      pq.mem(k, ": " ++ rest, tail, SCon{':', SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, rest ++ tail, gv,
          pq.cell(Print.pretty.go(v, ind, ""), "\n" ++ ind, Print.pretty.go(V.JPair{k2, v2, r2}, ind, close), tail, cc,
            gv,
            pq.tl(V.JPair{k2, v2, r2}, ind, close, V.WObj{}, tail, er), pq.tl(v, ind, "", V.WVal{}, SCon{',',
              "\n" ++ ind ++ cc}, ev))))
    case V.JPair{+k, +v, V.JBind{+src2, +n2, +v2, +r2}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JBind{src2, n2, v2, r2}, V.WObj{}), h)
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JBind{src2, n2, v2, r2}, V.WObj{}), h)
      +cc = pq.ct(V.JBind{src2, n2, v2, r2}, ind, close, tail)
      +gv = gt(pq.g(v, ind, ""), SCon{',', "\n" ++ ind ++ cc})
      +rest = Print.pretty.go(v, ind, "") ++ (",\n" ++ ind ++ Print.pretty.go(V.JBind{src2, n2, v2, r2}, ind, close))
      pq.mem(k, ": " ++ rest, tail, SCon{':', SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, rest ++ tail, gv,
          pq.cell(Print.pretty.go(v, ind, ""), "\n" ++ ind, Print.pretty.go(V.JBind{src2, n2, v2, r2}, ind, close),
            tail, cc, gv,
            pq.tl(V.JBind{src2, n2, v2, r2}, ind, close, V.WObj{}, tail, er), pq.tl(v, ind, "", V.WVal{}, SCon{',',
              "\n" ++ ind ++ cc}, ev))))
    case V.JBind{src, n, v, r} V.WVal{}:
      Empty.absurd(pq.goal(V.JBind{src, n, v, r}, ind, close, V.WVal{}, tail), false_true(h))
    case V.JBind{src, n, v, r} V.WArr{}:
      Empty.absurd(pq.goal(V.JBind{src, n, v, r}, ind, close, V.WArr{}, tail), false_true(h))
    case V.JBind{+src, +n, +v, V.JNull{}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JNull{}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JNull{}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JBool{bl2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JBool{bl2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JBool{bl2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JNum{raw2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JNum{raw2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JNum{raw2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JStr{s2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JStr{s2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JStr{s2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JSpan{src2, n2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JSpan{src2, n2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JSpan{src2, n2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JArr{items2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JArr{items2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JArr{items2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JObj{pairs2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JObj{pairs2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JObj{pairs2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JNil{}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JNil{}, V.WObj{}), h)
      +gv = gt(pq.g(v, ind, ""), close ++ tail)
      pq.mem(V.span.str(src, n, U32.is_zero(n)), ": " ++ (Print.pretty.go(v, ind, "") ++ close), tail, SCon{':',
        SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, (Print.pretty.go(v, ind, "") ++ close) ++ tail,
          gv, pq.last(Print.pretty.go(v, ind, ""), close, tail, gv, pq.tl(v, ind, "", V.WVal{}, close ++ tail, ev))))
    case V.JBind{+src, +n, +v, V.JCons{hh2, tt2}} V.WObj{}:
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JCons{hh2, tt2}, V.WObj{}), h)
      Empty.absurd(pq.goal(V.JBind{src, n, v, V.JCons{hh2, tt2}}, ind, close, V.WObj{}, tail), false_true(er))
    case V.JBind{+src, +n, +v, V.JPair{+k2, +v2, +r2}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JPair{k2, v2, r2}, V.WObj{}), h)
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JPair{k2, v2, r2}, V.WObj{}), h)
      +cc = pq.ct(V.JPair{k2, v2, r2}, ind, close, tail)
      +gv = gt(pq.g(v, ind, ""), SCon{',', "\n" ++ ind ++ cc})
      +rest = Print.pretty.go(v, ind, "") ++ (",\n" ++ ind ++ Print.pretty.go(V.JPair{k2, v2, r2}, ind, close))
      pq.mem(V.span.str(src, n, U32.is_zero(n)), ": " ++ rest, tail, SCon{':', SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, rest ++ tail, gv,
          pq.cell(Print.pretty.go(v, ind, ""), "\n" ++ ind, Print.pretty.go(V.JPair{k2, v2, r2}, ind, close), tail, cc,
            gv,
            pq.tl(V.JPair{k2, v2, r2}, ind, close, V.WObj{}, tail, er), pq.tl(v, ind, "", V.WVal{}, SCon{',',
              "\n" ++ ind ++ cc}, ev))))
    case V.JBind{+src, +n, +v, V.JBind{+src2, +n2, +v2, +r2}} V.WObj{}:
      ev = pq.left(V.wf.go(v, V.WVal{}), V.wf.go(V.JBind{src2, n2, v2, r2}, V.WObj{}), h)
      er = pq.right(V.wf.go(v, V.WVal{}), V.wf.go(V.JBind{src2, n2, v2, r2}, V.WObj{}), h)
      +cc = pq.ct(V.JBind{src2, n2, v2, r2}, ind, close, tail)
      +gv = gt(pq.g(v, ind, ""), SCon{',', "\n" ++ ind ++ cc})
      +rest = Print.pretty.go(v, ind, "") ++ (",\n" ++ ind ++ Print.pretty.go(V.JBind{src2, n2, v2, r2}, ind, close))
      pq.mem(V.span.str(src, n, U32.is_zero(n)), ": " ++ rest, tail, SCon{':', SCon{' ', gv}},
        Equal.cong(String, String, zz => SCon{':', SCon{' ', zz}}, rest ++ tail, gv,
          pq.cell(Print.pretty.go(v, ind, ""), "\n" ++ ind, Print.pretty.go(V.JBind{src2, n2, v2, r2}, ind, close),
            tail, cc, gv,
            pq.tl(V.JBind{src2, n2, v2, r2}, ind, close, V.WObj{}, tail, er), pq.tl(v, ind, "", V.WVal{}, SCon{',',
              "\n" ++ ind ++ cc}, ev))))


# Third, the derivation follows the rules, and stands for the value print
# would give back

# both sides of an and hold
law pq.and2:
  for aa: Bool
  for bb: Bool
  for ea: {aa == True{} : Bool}
  for eb: {bb == True{} : Bool}
  {Bool.and(aa, bb) == True{} : Bool}

def pq.and2(aa, bb, ea, eb):
  sa = Equal.sym(Bool, aa, True{}, ea)
  sb = Equal.sym(Bool, bb, True{}, eb)
  %sa : {Bool.and(_, bb) == True{} : Bool}
  %sb : {Bool.and(True{}, _) == True{} : Bool}
  {==}

# where a derivation of a value or a chain stands
def pq.gk(sh: V.Shape) -> Laws.GK:
  match sh:
    case V.WVal{}:
      Laws.GKVal{}
    case V.WArr{}:
      Laws.GKArr{}
    case V.WObj{}:
      Laws.GKObj{}

# a number's word follows the rules
law pq.num_ok:
  for +raw: String
  for both: ({Bool.pick(V.Json, String.eq(raw, "null"), V.JNull{}, Bool.pick(V.Json, String.eq(raw, "true"),
    V.JBool{True{}}, Bool.pick(V.Json, String.eq(raw, "false"), V.JBool{False{}}, V.JNum{raw}))) == V.JNum{raw}
    : V.Json} & {Bool.or(String.eq(raw, "null"), Bool.or(String.eq(raw, "true"), Bool.or(String.eq(raw, "false"),
    V.num.ok(raw)))) == True{} : Bool})
  {Laws.lit_or_num(raw) == True{} : Bool}

def pq.num_ok(raw, both):
  (_ew, eo) = both
  eg = Laws.num_grammar(raw)
  %eg : {Bool.or(String.eq(raw, "null"), Bool.or(String.eq(raw, "true"), Bool.or(String.eq(raw, "false"), _)))
    == True{} : Bool}
  eo

# a number's word stands for the number
law pq.num_val:
  for +raw: String
  for both: ({Bool.pick(V.Json, String.eq(raw, "null"), V.JNull{}, Bool.pick(V.Json, String.eq(raw, "true"),
    V.JBool{True{}}, Bool.pick(V.Json, String.eq(raw, "false"), V.JBool{False{}}, V.JNum{raw}))) == V.JNum{raw}
    : V.Json} & {Bool.or(String.eq(raw, "null"), Bool.or(String.eq(raw, "true"), Bool.or(String.eq(raw, "false"),
    V.num.ok(raw)))) == True{} : Bool})
  {Laws.g.word(raw) == V.JNum{raw} : V.Json}

def pq.num_val(_raw, both):
  (ew, _eo) = both
  ew

# two cells, equal field by field
law pq.cons2:
  for +aa: V.Json
  for +a2: V.Json
  for +bb: V.Json
  for +b2: V.Json
  for ea: {aa == a2 : V.Json}
  for eb: {bb == b2 : V.Json}
  {V.JCons{aa, bb} == V.JCons{a2, b2} : V.Json}

def pq.cons2(aa, a2, bb, b2, ea, eb):
  Equal.trans(V.Json, V.JCons{aa, bb}, V.JCons{a2, bb}, V.JCons{a2, b2},
    Equal.cong(V.Json, V.Json, zz => V.JCons{zz, bb}, aa, a2, ea),
    Equal.cong(V.Json, V.Json, zz => V.JCons{a2, zz}, bb, b2, eb))

# two members, equal field by field
law pq.pair3:
  for +kk: String
  for +k2: String
  for +aa: V.Json
  for +a2: V.Json
  for +bb: V.Json
  for +b2: V.Json
  for ek: {kk == k2 : String}
  for ea: {aa == a2 : V.Json}
  for eb: {bb == b2 : V.Json}
  {V.JPair{kk, aa, bb} == V.JPair{k2, a2, b2} : V.Json}

def pq.pair3(kk, k2, aa, a2, bb, b2, ek, ea, eb):
  Equal.trans(V.Json, V.JPair{kk, aa, bb}, V.JPair{k2, aa, bb}, V.JPair{k2, a2, b2},
    Equal.cong(String, V.Json, zz => V.JPair{zz, aa, bb}, kk, k2, ek),
    Equal.trans(V.Json, V.JPair{k2, aa, bb}, V.JPair{k2, a2, bb}, V.JPair{k2, a2, b2},
      Equal.cong(V.Json, V.Json, zz => V.JPair{k2, zz, bb}, aa, a2, ea),
      Equal.cong(V.Json, V.Json, zz => V.JPair{k2, a2, zz}, bb, b2, eb)))

# the whitespace after an element or member is whitespace
law pq.ww:
  for +tl: V.Json
  for +close: String
  for hc: {Laws.all_ws(close) == True{} : Bool}
  {Laws.all_ws(pq.w(tl, close)) == True{} : Bool}

def pq.ww(tl, _close, hc):
  match tl:
    case V.JNull{}:
      {==}
    case V.JBool{_bl}:
      {==}
    case V.JNum{_raw}:
      {==}
    case V.JStr{_s}:
      {==}
    case V.JSpan{_src, _n}:
      {==}
    case V.JArr{_items}:
      {==}
    case V.JObj{_pairs}:
      {==}
    case V.JNil{}:
      hc
    case V.JCons{_hh, _tt}:
      {==}
    case V.JPair{_k, _v, _r}:
      {==}
    case V.JBind{_src, _n, _v, _r}:
      {==}

# the derivation of a well-formed value or chain follows the rules where it
# stands, when `ind` and `close` are whitespace
law pq.ok:
  for +val: V.Json
  for +ind: String
  for +close: String
  for sh: V.Shape
  for +h: {V.wf.go(val, sh) == True{} : Bool}
  for +hi: {Laws.all_ws(ind) == True{} : Bool}
  for +hc: {Laws.all_ws(close) == True{} : Bool}
  {Laws.g.ok(pq.g(val, ind, close), pq.gk(sh)) == True{} : Bool}

def pq.ok(val, ind, close, sh, h, hi, hc):
  match val sh:
    case V.JNull{} V.WVal{}:
      {==}
    case V.JNull{} V.WArr{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JNull{}, ind, close), pq.gk(V.WArr{})) == True{} : Bool}, false_true(h))
    case V.JNull{} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JNull{}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JBool{True{}} V.WVal{}:
      {==}
    case V.JBool{False{}} V.WVal{}:
      {==}
    case V.JBool{bl} V.WArr{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JBool{bl}, ind, close), pq.gk(V.WArr{})) == True{} : Bool}, false_true(h))
    case V.JBool{bl} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JBool{bl}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JNum{+raw} V.WVal{}:
      pq.num_ok(raw, word_num.at(String.eq(raw, "null"), String.eq(raw, "true"), String.eq(raw, "false"), raw, {==},
        {==},
        {==}, h))
    case V.JNum{raw} V.WArr{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JNum{raw}, ind, close), pq.gk(V.WArr{})) == True{} : Bool}, false_true(h))
    case V.JNum{raw} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JNum{raw}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JStr{s} V.WVal{}:
      pq.pcs_ok(s)
    case V.JStr{s} V.WArr{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JStr{s}, ind, close), pq.gk(V.WArr{})) == True{} : Bool}, false_true(h))
    case V.JStr{s} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JStr{s}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JSpan{src, +n} V.WVal{}:
      pq.pcs_ok(V.span.str(src, n, U32.is_zero(n)))
    case V.JSpan{src, n} V.WArr{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JSpan{src, n}, ind, close), pq.gk(V.WArr{})) == True{} : Bool}, false_true(h))
    case V.JSpan{src, n} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JSpan{src, n}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JArr{V.JNull{}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JNull{}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool}, false_true(h))
    case V.JArr{V.JBool{bl}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JBool{bl}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool}, false_true(h))
    case V.JArr{V.JNum{raw}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JNum{raw}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool}, false_true(h))
    case V.JArr{V.JStr{s}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JStr{s}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool}, false_true(h))
    case V.JArr{V.JSpan{src, n}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JSpan{src, n}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool},
        false_true(h))
    case V.JArr{V.JArr{items}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JArr{items}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool},
        false_true(h))
    case V.JArr{V.JObj{pairs}} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JArr{V.JObj{pairs}}, ind, close), pq.gk(V.WVal{})) == True{} : Bool},
        false_true(h))
    case V.JArr{V.JNil{}} V.WVal{}:
      {==}
    case V.JArr{V.JCons{+hh, +tt}} V.WVal{}:
      +inner = "  " ++ ind
      eh = pq.left(V.wf.go(hh, V.WVal{}), V.wf.go(tt, V.WArr{}), h)
      et = pq.right(V.wf.go(hh, V.WVal{}), V.wf.go(tt, V.WArr{}), h)
      +gh = pq.g(hh, inner, "")
      +gr = pq.g(tt, inner, "\n" ++ ind)
      pq.and2(Laws.all_ws("\n" ++ inner), Bool.and(Laws.g.ok(gh, Laws.GKVal{}), Bool.and(Laws.all_ws(pq.w(tt,
        "\n" ++ ind)), Laws.g.ok(gr, Laws.GKArr{}))), hi, pq.and2(Laws.g.ok(gh, Laws.GKVal{}),
        Bool.and(Laws.all_ws(pq.w(tt, "\n" ++ ind)), Laws.g.ok(gr, Laws.GKArr{})), pq.ok(hh, inner, "", V.WVal{}, eh,
