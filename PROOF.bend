        pq.and2(Laws.g.ok(gv, Laws.GKVal{}), Bool.and(Laws.all_ws(pq.w(r, close)), Laws.g.ok(gr, Laws.GKObj{})),
          pq.ok(v, ind, "", V.WVal{}, ev, hi, {==}),
        pq.and2(Laws.all_ws(pq.w(r, close)), Laws.g.ok(gr, Laws.GKObj{}), pq.ww(r, close, hc),
        pq.ok(r, ind, close, V.WObj{}, er, hi, hc)))))))
    case V.JBind{src, n, v, r} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JBind{src, n, v, r}, ind, close), pq.gk(V.WVal{})) == True{} : Bool},
