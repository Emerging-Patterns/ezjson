# the derivation of a well-formed value or chain stands for it as print
# writes it, owned
law pq.val:
  for +val: V.Json
  for +ind: String
  for +close: String
  for sh: V.Shape
  for +h: {V.wf.go(val, sh) == True{} : Bool}
  {Laws.g.val(pq.g(val, ind, close)) == Laws.fixv(Laws.own(val)) : V.Json}

def pq.val(val, ind, close, sh, h):
  match val sh:
    case V.JNull{} V.WVal{}:
      {==}
