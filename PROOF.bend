# JSON-TEXT-2: whitespace between tokens

# a derivation's value does not depend on its whitespace
law val_bare:
  for +gg: Laws.Gv
  {Laws.g.val(Laws.g.bare(gg)) == Laws.g.val(gg) : V.Json}

def val_bare(gg):
  match gg:
    case Laws.GWord{_a1}:
      {==}
    case Laws.GStr{_a1}:
      {==}
    case Laws.GArr0{_a1}:
      {==}
    case Laws.GArr{_a1, +a2, _a3, +a4}:
