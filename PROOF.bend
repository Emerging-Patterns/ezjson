    case V.JObj{pairs} V.WObj{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JObj{pairs}, ind, close), pq.gk(V.WObj{})) == True{} : Bool}, false_true(h))
    case V.JNil{} V.WVal{}:
      Empty.absurd({Laws.g.ok(pq.g(V.JNil{}, ind, close), pq.gk(V.WVal{})) == True{} : Bool}, false_true(h))
    case V.JNil{} V.WArr{}:
