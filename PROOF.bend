    case True{} True{} True{} False{} True{}:
      {==}
    case True{} True{} True{} True{} False{}:
      {==}
    case True{} True{} True{} True{} True{}:
      {==}

# pq.ctl_char, once bit 5 and the bits above are known
law pq.ctl_char.at:
  for cc: Cmp
  for b5: Bool
  for b0: Bool
  for b1: Bool
  for b2: Bool
  for b3: Bool
  for b4: Bool
  for +rest: Word(26n)
  for ec: {Word.cmp(26n, rest, zw(26n)) == cc : Cmp}
  for h_lt: {Cmp.is_lt(Word.cmp.fin(b5, True{}, cc)) == True{} : Bool}
  {Laws.piece.char(Laws.PU{'0', '0', Print.escape.nib(U32.div(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5,
    rest}}}}}}}, 16)), Print.escape.nib(U32.mod(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}},
    16))}) == Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}} : Char}

def pq.ctl_char.at(cc, b5, b0, b1, b2, b3, b4, rest, ec, h_lt):
  match cc:
    case LT{}:
      ez = Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Word.cmp(26n, rest, zw(26n)), LT{}, ec)
      Empty.absurd(pq.ctl_char.goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}),
        true_false(Equal.trans(Bool, True{}, Cmp.is_lt(Word.cmp(26n, rest, zw(26n))), False{},
        Equal.sym(Bool, Cmp.is_lt(Word.cmp(26n, rest, zw(26n))), True{}, ez), zw_nlt(26n, rest))))
    case GT{}:
      match b5:
        case False{}:
          Empty.absurd(pq.ctl_char.goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}),
            false_true(h_lt))
        case True{}:
          Empty.absurd(pq.ctl_char.goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}),
            false_true(h_lt))
    case EQ{}:
      match b5:
        case True{}:
          Empty.absurd(pq.ctl_char.goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}),
            false_true(h_lt))
        case False{}:
          er = Equal.sym(Word(26n), rest, zw(26n),
            weq(26n, rest, zw(26n), Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx), Word.cmp(26n, rest, zw(26n)), EQ{}, ec)))
          %er : {Laws.piece.char(Laws.PU{'0', '0', Print.escape.nib(U32.div(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3,
            WCon{b4, WCon{False{}, _}}}}}}}, 16)), Print.escape.nib(U32.mod(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3,
            WCon{b4, WCon{False{}, _}}}}}}}, 16))}) == Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4,
            WCon{False{}, _}}}}}}}} : Char}
          pq.ctl_char.five(b0, b1, b2, b3, b4)

# a control's \u00XX piece stands for the control
law pq.ctl_char:
  for +uu: U32
  for h_lt: {U32.is_lt(uu, 32) == True{} : Bool}
  {Laws.piece.char(Laws.PU{'0', '0', Print.escape.nib(U32.div(uu, 16)), Print.escape.nib(U32.mod(uu,
    16))}) == Chr{uu} : Char}

def pq.ctl_char(uu, h_lt):
  match uu:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, +rest}}}}}}}:
      +c5 = Word.cmp.fin(b5, True{}, Word.cmp(26n, rest, zw(26n)))
      +c4 = Word.cmp.fin(b4, False{}, c5)
      +c3 = Word.cmp.fin(b3, False{}, c4)
      +c2 = Word.cmp.fin(b2, False{}, c3)
      +c1 = Word.cmp.fin(b1, False{}, c2)
      h5 = lt_up(b4, c5, lt_up(b3, c4, lt_up(b2, c3, lt_up(b1, c2, lt_up(b0, c1, h_lt)))))
      pq.ctl_char.at(Word.cmp(26n, rest, zw(26n)), b5, b0, b1, b2, b3, b4, rest, {==}, h5)


