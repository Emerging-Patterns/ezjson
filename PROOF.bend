        zz => Lex.step.hi.go(hi, bf, tk, U32.is_eq(zz, 92)), Char.to_u32(ch), 92, cls_back(ch, ecls)))), ({==}, hp)))))
    case Lex.CPunct{_}:
      Unit{}
    case Lex.CQuote{}:
      Unit{}
    case Lex.CSpace{}:
      Unit{}
    case Lex.COther{}:
      Unit{}

# the character after a high surrogate's escape and a backslash, once whether it is u is named
