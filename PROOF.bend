        pq.and2(Laws.all_ws(""), Bool.and(Laws.all_ws(" "), Bool.and(Laws.g.ok(gv, Laws.GKVal{}),
          Bool.and(Laws.all_ws(pq.w(r, close)), Laws.g.ok(gr, Laws.GKObj{})))), {==}, pq.and2(Laws.all_ws(" "),
          Bool.and(Laws.g.ok(gv, Laws.GKVal{}), Bool.and(Laws.all_ws(pq.w(r, close)), Laws.g.ok(gr, Laws.GKObj{}))),
