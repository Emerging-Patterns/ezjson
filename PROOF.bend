# cpl_rl, with the budget named through uu
law cplu_rl:
  for +pp: Nat
  for +lvl: Nat
  for +uu: Unit
  {Nat.add(cplu(lvl, pp, uu), rlu(lvl, uu)) == rlu(1n+Nat.add(lvl, pp), uu) : Nat}

def cplu_rl(pp, lvl, uu):
  match uu:
    case Unit{}:
      cpl_rl(pp, lvl)

