        Print.print(Laws.fixv(V.JCons{t1, t2})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ _ ++ "," ++ Print.print(V.JCons{t1, t2}) : String}
      %er : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JCons{t1, t2})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JPair{+t1, +t2, +t3}:
      %ek : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JPair{t1, t2, t3})) ==
        _ ++ ":" ++ Print.print(vv) ++ "," ++ Print.print(V.JPair{t1, t2, t3}) : String}
      %ev : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JPair{t1, t2, t3})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ _ ++ "," ++ Print.print(V.JPair{t1, t2, t3}) : String}
      %er : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JPair{t1, t2, t3})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JSpan{+t1, +t2}:
      %ek : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JSpan{t1, t2})) ==
        _ ++ ":" ++ Print.print(vv) ++ "," ++ Print.print(V.JSpan{t1, t2}) : String}
      %ev : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JSpan{t1, t2})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ _ ++ "," ++ Print.print(V.JSpan{t1, t2}) : String}
      %er : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JSpan{t1, t2})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JBind{+t1, +t2, +t3, +t4}:
      %ek : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JBind{t1, t2, t3, t4})) ==
        _ ++ ":" ++ Print.print(vv) ++ "," ++ Print.print(V.JBind{t1, t2, t3, t4}) : String}
      %ev : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JBind{t1, t2, t3, t4})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ _ ++ "," ++ Print.print(V.JBind{t1, t2, t3, t4}) : String}
      %er : {Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++
        Print.print(Laws.fixv(V.JBind{t1, t2, t3, t4})) ==
        Print.quote(Laws.fix_str(kk)) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}

# print_fix for an object cell with a span key, by what follows it
law pf_bind:
  for rr: V.Json
  for +src: String
  for +nn: U32
  for +vv: V.Json
  for +ev: {Print.print(Laws.fixv(vv)) == Print.print(vv) : String}
  for +er: {Print.print(Laws.fixv(rr)) == Print.print(rr) : String}
  {Print.print(Laws.fixv(V.JBind{src, nn, vv, rr})) == Print.print(V.JBind{src, nn, vv, rr}) : String}

def pf_bind(rr, src, nn, vv, ev, er):
  match rr:
    case V.JNil{}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) == Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ _ : String}
      {==}
    case V.JNull{}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JNull{})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JNull{}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JNull{})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JBool{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JBool{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JBool{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JBool{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JNum{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JNum{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JNum{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JNum{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JStr{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JStr{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JStr{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JStr{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JArr{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JArr{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JArr{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JArr{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JObj{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JObj{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JObj{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JObj{t1})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JCons{+t1, +t2}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JCons{t1, t2})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JCons{t1, t2}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JCons{t1, t2})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JPair{+t1, +t2, +t3}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JPair{t1, t2, t3})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JPair{t1, t2,
          t3}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JPair{t1, t2, t3})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JSpan{+t1, +t2}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JSpan{t1, t2})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JSpan{t1, t2}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JSpan{t1, t2})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}
    case V.JBind{+t1, +t2, +t3, +t4}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JBind{t1, t2, t3,
        t4})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JBind{t1, t2, t3,
          t4}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ Print.print(Laws.fixv(V.JBind{t1, t2, t3,
        t4})) ==
        Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.fixv(vv)) ++ "," ++ _ : String}
      {==}

# a value and its fix print the same
law print_fix:
  for +val: V.Json
  {Print.print(Laws.fixv(val)) == Print.print(val) : String}

def print_fix(val):
  match val:
    case V.JNull{}:
      {==}
    case V.JBool{+x1}:
      {==}
    case V.JNum{+x1}:
      {==}
    case V.JStr{+x1}:
      e1 = quote_fix(x1)
      %e1 : {"\"" ++ Print.escape(String.to_list(Laws.fix_str(x1))) ++ "\"" == "\"" ++ _ ++ "\"" : String}
      {==}
    case V.JArr{+x1}:
      e1 = print_fix(x1)
      %e1 : {"[" ++ Print.print(Laws.fixv(x1)) ++ "]" == "[" ++ _ ++ "]" : String}
      {==}
    case V.JObj{+x1}:
      e1 = print_fix(x1)
      %e1 : {"{" ++ Print.print(Laws.fixv(x1)) ++ "}" == "{" ++ _ ++ "}" : String}
      {==}
    case V.JNil{}:
      {==}
    case V.JCons{+x1, +x2}:
      pf_cons(x2, x1, print_fix(x1), print_fix(x2))
    case V.JPair{+x1, +x2, +x3}:
      pf_pair(x3, x1, x2, Equal.cong(String, String, zz => "\"" ++ zz ++ "\"",
        Print.escape(String.to_list(Laws.fix_str(x1))), Print.escape(String.to_list(x1)), quote_fix(x1)), print_fix(x2),
        print_fix(x3))
    case V.JSpan{+x1, +x2}:
      {==}
    case V.JBind{+x1, +x2, +x3, +x4}:
      pf_bind(x4, x1, x2, x3, print_fix(x3), print_fix(x4))

# print_own for an array cell, by what follows it
law po_cons:
  for tl: V.Json
  for +hd: V.Json
  for +eh: {Print.print(Laws.own(hd)) == Print.print(hd) : String}
  for +et: {Print.print(Laws.own(tl)) == Print.print(tl) : String}
  {Print.print(Laws.own(V.JCons{hd, tl})) == Print.print(V.JCons{hd, tl}) : String}

def po_cons(tl, hd, eh, et):
  match tl:
    case V.JNil{}:
      eh
    case V.JNull{}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JNull{})) == _ ++ "," ++
        Print.print(V.JNull{}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JNull{})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JBool{+t1}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) == _ ++ "," ++
        Print.print(V.JBool{t1}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JNum{+t1}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) == _ ++ "," ++
        Print.print(V.JNum{t1}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JStr{+t1}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) == _ ++ "," ++
        Print.print(V.JStr{t1}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JArr{+t1}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) == _ ++ "," ++
        Print.print(V.JArr{t1}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JObj{+t1}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) == _ ++ "," ++
        Print.print(V.JObj{t1}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) == Print.print(Laws.own(hd)) ++
        "," ++ _ : String}
      {==}
    case V.JCons{+t1, +t2}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == _ ++ "," ++ Print.print(V.JCons{t1, t2}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == Print.print(Laws.own(hd)) ++ "," ++ _ : String}
      {==}
    case V.JPair{+t1, +t2, +t3}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == _ ++ "," ++ Print.print(V.JPair{t1, t2, t3}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == Print.print(Laws.own(hd)) ++ "," ++ _ : String}
      {==}
    case V.JSpan{+t1, +t2}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == _ ++ "," ++ Print.print(V.JSpan{t1, t2}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == Print.print(Laws.own(hd)) ++ "," ++ _ : String}
      {==}
    case V.JBind{+t1, +t2, +t3, +t4}:
      %eh : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == _ ++ "," ++ Print.print(V.JBind{t1, t2, t3, t4}) : String}
      %et : {Print.print(Laws.own(hd)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == Print.print(Laws.own(hd)) ++ "," ++ _ : String}
      {==}

# print_own for an object cell, by what follows it
law po_pair:
  for rr: V.Json
  for +kk: String
  for +vv: V.Json
  for +ev: {Print.print(Laws.own(vv)) == Print.print(vv) : String}
  for +er: {Print.print(Laws.own(rr)) == Print.print(rr) : String}
  {Print.print(Laws.own(V.JPair{kk, vv, rr})) == Print.print(V.JPair{kk, vv, rr}) : String}

def po_pair(rr, kk, vv, ev, er):
  match rr:
    case V.JNil{}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) == Print.quote(kk) ++ ":" ++ _ : String}
      {==}
    case V.JNull{}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNull{})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JNull{}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNull{})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JBool{+t1}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JBool{t1}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JNum{+t1}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JNum{t1}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JStr{+t1}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JStr{t1}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JArr{+t1}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JArr{t1}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JObj{+t1}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) ==
        Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JObj{t1}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) ==
        Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JCons{+t1, +t2}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JCons{t1, t2}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JPair{+t1, +t2, +t3}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JPair{t1, t2, t3}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JSpan{+t1, +t2}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JSpan{t1, t2}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JBind{+t1, +t2, +t3, +t4}:
      %ev : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == Print.quote(kk) ++ ":" ++ _ ++ "," ++ Print.print(V.JBind{t1, t2, t3, t4}) : String}
      %er : {Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == Print.quote(kk) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}

# print_own for an object cell, by what follows it
law po_bind:
  for rr: V.Json
  for +src: String
  for +nn: U32
  for +vv: V.Json
  for +ev: {Print.print(Laws.own(vv)) == Print.print(vv) : String}
  for +er: {Print.print(Laws.own(rr)) == Print.print(rr) : String}
  {Print.print(Laws.own(V.JBind{src, nn, vv, rr})) == Print.print(V.JBind{src, nn, vv, rr}) : String}

def po_bind(rr, src, nn, vv, ev, er):
  match rr:
    case V.JNil{}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) == Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ _ : String}
      {==}
    case V.JNull{}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNull{})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JNull{}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNull{})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JBool{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JBool{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBool{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JNum{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JNum{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JNum{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JStr{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JStr{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JStr{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JArr{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JArr{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JArr{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JObj{+t1}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JObj{t1}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JObj{t1})) ==
          Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JCons{+t1, +t2}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JCons{t1,
        t2}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JCons{t1,
        t2})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JPair{+t1, +t2, +t3}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JPair{t1, t2,
        t3}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JPair{t1, t2,
        t3})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JSpan{+t1, +t2}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JSpan{t1,
        t2}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JSpan{t1,
        t2})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}
    case V.JBind{+t1, +t2, +t3, +t4}:
      %ev : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ _ ++ "," ++ Print.print(V.JBind{t1, t2,
        t3, t4}) : String}
      %er : {Print.quote(V.span.str(src, nn,
        U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ Print.print(Laws.own(V.JBind{t1, t2, t3,
        t4})) == Print.quote(V.span.str(src, nn, U32.is_zero(nn))) ++ ":" ++ Print.print(Laws.own(vv)) ++ "," ++ _ :
        String}
      {==}

# a value and its owned form print the same
law print_own:
  for +val: V.Json
  {Print.print(Laws.own(val)) == Print.print(val) : String}

def print_own(val):
  match val:
    case V.JNull{}:
      {==}
    case V.JBool{+x1}:
      {==}
    case V.JNum{+x1}:
      {==}
    case V.JStr{+x1}:
      {==}
    case V.JArr{+x1}:
      e1 = print_own(x1)
      %e1 : {"[" ++ Print.print(Laws.own(x1)) ++ "]" == "[" ++ _ ++ "]" : String}
      {==}
    case V.JObj{+x1}:
      e1 = print_own(x1)
      %e1 : {"{" ++ Print.print(Laws.own(x1)) ++ "}" == "{" ++ _ ++ "}" : String}
      {==}
    case V.JNil{}:
      {==}
    case V.JCons{+x1, +x2}:
      po_cons(x2, x1, print_own(x1), print_own(x2))
    case V.JPair{+x1, +x2, +x3}:
      po_pair(x3, x1, x2, print_own(x2), print_own(x3))
    case V.JSpan{+x1, +x2}:
      {==}
    case V.JBind{+x1, +x2, +x3, +x4}:
      po_bind(x4, x1, x2, x3, print_own(x3), print_own(x4))

# a parse result and its owned form print the same
law print_m_own:
  for mb: Maybe<&2, V.Json>
  {Laws.print_m(Laws.own_m(mb)) == Laws.print_m(mb) : Maybe<&2, String>}

def print_m_own(mb):
  match mb:
    case None{}:
      {==}
    case Some{+jj}:
      Equal.cong(String, Maybe<&2, String>, zz => Some{zz}, Print.print(Laws.own(jj)), Print.print(jj), print_own(jj))

# JSON-PRINT-2, the second half
def Laws.print_stable(txt, jj, e_p, h_s):
  +mm = Ezjson.parse(Ezjson.print(jj))
  hw = Equal.trans(Bool, V.wf(jj), Laws.wf_m(Ezjson.parse(txt)), True{},
    Equal.sym(Bool, Laws.wf_m(Ezjson.parse(txt)), V.wf(jj), Equal.cong(Maybe<&2, V.Json>, Bool, zz => Laws.wf_m(zz),
      Ezjson.parse(txt),
      Some{jj}, e_p)), Laws.parse_wf(txt))
  Equal.trans(Maybe<&2, String>, Laws.print_m(mm), Laws.print_m(Laws.own_m(mm)), Some{Print.print(jj)},
    Equal.sym(Maybe<&2, String>, Laws.print_m(Laws.own_m(mm)), Laws.print_m(mm), print_m_own(mm)),
    Equal.trans(Maybe<&2, String>, Laws.print_m(Laws.own_m(mm)), Laws.print_m(Some{Laws.fixv(Laws.own(jj))}),
      Some{Print.print(jj)},
      Equal.cong(Maybe<&2, V.Json>, Maybe<&2, String>, zz => Laws.print_m(zz), Laws.own_m(mm),
        Some{Laws.fixv(Laws.own(jj))},
        Laws.print_parse(jj, hw, h_s)),
      Equal.trans(Maybe<&2, String>, Some{Print.print(Laws.fixv(Laws.own(jj)))}, Some{Print.print(Laws.own(jj))},
        Some{Print.print(jj)},
        Equal.cong(String, Maybe<&2, String>, zz => Some{zz}, Print.print(Laws.fixv(Laws.own(jj))),
          Print.print(Laws.own(jj)),
          print_fix(Laws.own(jj))),
        Equal.cong(String, Maybe<&2, String>, zz => Some{zz}, Print.print(Laws.own(jj)), Print.print(jj),
          print_own(jj)))))


# JSON-PRINT-2, the first half: print writes whitespace only inside strings

# the scan on two strings is the scan on the first, then the second
law tx_app:
  for +aa: String
  for +bb: String
  for st: Laws.Tx
  {Laws.tx.run(String.to_list(aa ++ bb), st) == Laws.tx.run(String.to_list(bb), Laws.tx.run(String.to_list(aa),
    st)) : Laws.Tx}

def tx_app(aa, bb, st):
  match aa:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      tx_app(tl, bb, Laws.tx.step(st, hd))

# the scan on two strings, where the first leads to a known state
law tseq:
  for +aa: String
  for +bb: String
  for +st: Laws.Tx
  for +mid: Laws.Tx
  for e1: {Laws.tx.run(String.to_list(aa), st) == mid : Laws.Tx}
  {Laws.tx.run(String.to_list(aa ++ bb), st) == Laws.tx.run(String.to_list(bb), mid) : Laws.Tx}

def tseq(aa, bb, st, mid, e1):
  Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(aa ++ bb), st), Laws.tx.run(String.to_list(bb),
    Laws.tx.run(String.to_list(aa), st)), Laws.tx.run(String.to_list(bb), mid), tx_app(aa, bb, st),
    Equal.cong(Laws.Tx, Laws.Tx, zz => Laws.tx.run(String.to_list(bb), zz), Laws.tx.run(String.to_list(aa), st), mid,
      e1))

# whether a class is Lex.COther{}
def is_other(cls: Lex.Class) -> Bool:
  match cls:
    case Lex.COther{}:
      True{}
    case _:
      False{}

# a word character is not a code point classify tests
law neq_cls:
  for bb: Bool
  for +uu: U32
  for +kk: U32
  for eb: {U32.is_eq(uu, kk) == bb : Bool}
  for h: {Lex.classify.go(uu) == Lex.COther{} : Lex.Class}
  for hk: {is_other(Lex.classify.go(kk)) == False{} : Bool}
  {U32.is_eq(uu, kk) == False{} : Bool}

def neq_cls(bb, uu, kk, eb, h, hk):
  match bb:
    case False{}:
      eb
    case True{}:
      Empty.absurd({U32.is_eq(uu, kk) == False{} : Bool}, true_false(Equal.trans(Bool, True{},
        is_other(Lex.classify.go(uu)), False{}, Equal.sym(Bool, is_other(Lex.classify.go(uu)), True{},
          Equal.cong(Lex.Class, Bool, zz => is_other(zz), Lex.classify.go(uu), Lex.COther{}, h)),
        Equal.trans(Bool, is_other(Lex.classify.go(uu)), is_other(Lex.classify.go(kk)), False{},
          Equal.cong(U32, Bool, zz => is_other(Lex.classify.go(zz)), uu, kk, ueq(uu, kk, eb)), hk))))

# tx_other, with the code point's tests known
law tx_other.go:
  for +uu: U32
  for e34: {U32.is_eq(uu, 34) == False{} : Bool}
  for e32: {U32.is_eq(uu, 32) == False{} : Bool}
  for e9: {U32.is_eq(uu, 9) == False{} : Bool}
  for e10: {U32.is_eq(uu, 10) == False{} : Bool}
  for e13: {U32.is_eq(uu, 13) == False{} : Bool}
  {Laws.tx.step(Laws.TxOut{}, Chr{uu}) == Laws.TxOut{} : Laws.Tx}

def tx_other.go(uu, e34, e32, e9, e10, e13):
  s34 = Equal.sym(Bool, U32.is_eq(uu, 34), False{}, e34)
  s32 = Equal.sym(Bool, U32.is_eq(uu, 32), False{}, e32)
  s9 = Equal.sym(Bool, U32.is_eq(uu, 9), False{}, e9)
  s10 = Equal.sym(Bool, U32.is_eq(uu, 10), False{}, e10)
  s13 = Equal.sym(Bool, U32.is_eq(uu, 13), False{}, e13)
  %s34 : {Bool.pick(Laws.Tx, _, Laws.TxIn{}, Bool.pick(Laws.Tx, Bool.or(U32.is_eq(uu, 32), Bool.or(U32.is_eq(uu, 9),
    Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)))), Laws.TxWs{}, Laws.TxOut{})) == Laws.TxOut{} : Laws.Tx}
  %s32 : {Bool.pick(Laws.Tx, Bool.or(_, Bool.or(U32.is_eq(uu, 9), Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13)))),
    Laws.TxWs{}, Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  %s9 : {Bool.pick(Laws.Tx, Bool.or(_, Bool.or(U32.is_eq(uu, 10), U32.is_eq(uu, 13))), Laws.TxWs{}, Laws.TxOut{}) ==
    Laws.TxOut{} : Laws.Tx}
  %s10 : {Bool.pick(Laws.Tx, Bool.or(_, U32.is_eq(uu, 13)), Laws.TxWs{}, Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  %s13 : {Bool.pick(Laws.Tx, _, Laws.TxWs{}, Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  {==}

# a word character outside strings keeps the scan outside
law tx_other:
  for +ch: Char
  for +h: {Lex.classify(ch) == Lex.COther{} : Lex.Class}
  {Laws.tx.step(Laws.TxOut{}, ch) == Laws.TxOut{} : Laws.Tx}

def tx_other(ch, h):
  match ch:
    case Chr{+uu}:
      tx_other.go(uu, neq_cls(U32.is_eq(uu, 34), uu, 34, {==}, h, {==}), neq_cls(U32.is_eq(uu, 32), uu, 32, {==}, h,
        {==}),
        neq_cls(U32.is_eq(uu, 9), uu, 9, {==}, h, {==}), neq_cls(U32.is_eq(uu, 10), uu, 10, {==}, h, {==}),
        neq_cls(U32.is_eq(uu, 13), uu, 13, {==}, h, {==}))


# word characters outside strings keep the scan outside
law tx_word:
  for +cs: List<&2, Char>
  for hw: others(cs)
  {Laws.tx.run(cs, Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def tx_word(cs, hw):
  match cs:
    case Nil{}:
      {==}
    case Con{+hd, +tl}:
      (hc, ht) = hw
      Equal.trans(Laws.Tx, Laws.tx.run(tl, Laws.tx.step(Laws.TxOut{}, hd)), Laws.tx.run(tl, Laws.TxOut{}), Laws.TxOut{},
        Equal.cong(Laws.Tx, Laws.Tx, zz => Laws.tx.run(tl, zz), Laws.tx.step(Laws.TxOut{}, hd), Laws.TxOut{},
          tx_other(hd, hc)),
        tx_word(tl, ht))

# a JSON number keeps the scan outside strings
law tx_num:
  for +raw: String
  for h: {V.num.ok(raw) == True{} : Bool}
  {Laws.tx.run(String.to_list(raw), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def tx_num(raw, h):
  tx_word(String.to_list(raw), oth_number(String.to_list(raw), Equal.trans(Bool, Laws.number(String.to_list(raw)),
    V.num.ok(raw), True{}, Equal.sym(Bool, V.num.ok(raw), Laws.number(String.to_list(raw)), Laws.num_grammar(raw)), h)))

# what tx_ctl says of a code point: its \u00XX escape stays inside the string
def txu_goal(uu: U32) -> Type:
  {Laws.tx.run(String.to_list(Print.escape.u(uu)), Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}


# tx_ctl, one control at a time
law tx_ctl5:
  for b0: Bool
  for b1: Bool
  for b2: Bool
  for b3: Bool
  for b4: Bool
  txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{False{}, zw(26n)}}}}}}})

def tx_ctl5(b0, b1, b2, b3, b4):
  match b0 b1 b2 b3 b4:
    case False{} False{} False{} False{} False{}:
      {==}
    case False{} False{} False{} False{} True{}:
      {==}
    case False{} False{} False{} True{} False{}:
      {==}
    case False{} False{} False{} True{} True{}:
      {==}
    case False{} False{} True{} False{} False{}:
      {==}
    case False{} False{} True{} False{} True{}:
      {==}
    case False{} False{} True{} True{} False{}:
      {==}
    case False{} False{} True{} True{} True{}:
      {==}
    case False{} True{} False{} False{} False{}:
      {==}
    case False{} True{} False{} False{} True{}:
      {==}
    case False{} True{} False{} True{} False{}:
      {==}
    case False{} True{} False{} True{} True{}:
      {==}
    case False{} True{} True{} False{} False{}:
      {==}
    case False{} True{} True{} False{} True{}:
      {==}
    case False{} True{} True{} True{} False{}:
      {==}
    case False{} True{} True{} True{} True{}:
      {==}
    case True{} False{} False{} False{} False{}:
      {==}
    case True{} False{} False{} False{} True{}:
      {==}
    case True{} False{} False{} True{} False{}:
      {==}
    case True{} False{} False{} True{} True{}:
      {==}
    case True{} False{} True{} False{} False{}:
      {==}
    case True{} False{} True{} False{} True{}:
      {==}
    case True{} False{} True{} True{} False{}:
      {==}
    case True{} False{} True{} True{} True{}:
      {==}
    case True{} True{} False{} False{} False{}:
      {==}
    case True{} True{} False{} False{} True{}:
      {==}
    case True{} True{} False{} True{} False{}:
      {==}
    case True{} True{} False{} True{} True{}:
      {==}
    case True{} True{} True{} False{} False{}:
      {==}
    case True{} True{} True{} False{} True{}:
      {==}
    case True{} True{} True{} True{} False{}:
      {==}
    case True{} True{} True{} True{} True{}:
      {==}

# tx_ctl, once bit 5 and the bits above are known
law tx_ctl.at:
  for cc: Cmp
  for b5: Bool
  for b0: Bool
  for b1: Bool
  for b2: Bool
  for b3: Bool
  for b4: Bool
  for +rest: Word(26n)
  for ec: {Word.cmp(26n, rest, zw(26n)) == cc : Cmp}
  for h_lt: {Cmp.is_lt(Word.cmp.fin(b5, True{}, cc)) == True{} : Bool}
  txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}})

def tx_ctl.at(cc, b5, b0, b1, b2, b3, b4, rest, ec, h_lt):
  match cc:
    case LT{}:
      ez = Equal.cong(Cmp, Bool, xx => Cmp.is_lt(xx), Word.cmp(26n, rest, zw(26n)), LT{}, ec)
      Empty.absurd(txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{b5, rest}}}}}}}),
        true_false(Equal.trans(Bool, True{},
        Cmp.is_lt(Word.cmp(26n, rest, zw(26n))), False{},
        Equal.sym(Bool, Cmp.is_lt(Word.cmp(26n, rest, zw(26n))), True{}, ez), zw_nlt(26n, rest))))
    case GT{}:
      match b5:
        case False{}:
          Empty.absurd(txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{False{}, rest}}}}}}}),
            false_true(h_lt))
        case True{}:
          Empty.absurd(txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{True{}, rest}}}}}}}),
            false_true(h_lt))
    case EQ{}:
      match b5:
        case True{}:
          Empty.absurd(txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{True{}, rest}}}}}}}),
            false_true(h_lt))
        case False{}:
          er = Equal.sym(Word(26n), rest, zw(26n),
            weq(26n, rest, zw(26n), Equal.cong(Cmp, Bool, xx => Cmp.is_eq(xx), Word.cmp(26n, rest, zw(26n)), EQ{}, ec)))
          %er : txu_goal(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{False{}, _}}}}}}})
          tx_ctl5(b0, b1, b2, b3, b4)

# a control below U+0020, written as \u00XX, stays inside the string
law tx_ctl:
  for +uu: U32
  for h_lt: {U32.is_lt(uu, 32) == True{} : Bool}
  txu_goal(uu)

def tx_ctl(uu, h_lt):
  match uu:
    case U32{WCon{+b0, WCon{+b1, WCon{+b2, WCon{+b3, WCon{+b4, WCon{+b5, +rest}}}}}}}:
      +c5 = Word.cmp.fin(b5, True{}, Word.cmp(26n, rest, zw(26n)))
      +c4 = Word.cmp.fin(b4, False{}, c5)
      +c3 = Word.cmp.fin(b3, False{}, c4)
      +c2 = Word.cmp.fin(b2, False{}, c3)
      +c1 = Word.cmp.fin(b1, False{}, c2)
      h5 = lt_up(b4, c5, lt_up(b3, c4, lt_up(b2, c3, lt_up(b1, c2, lt_up(b0, c1, h_lt)))))
      tx_ctl.at(Word.cmp(26n, rest, zw(26n)), b5, b0, b1, b2, b3, b4, rest, {==}, h5)


# escape.plain's answer, with its tests named, stays inside the string
law tx_plain:
  for b34: Bool
  for b92: Bool
  for b8: Bool
  for b12: Bool
  for b10: Bool
  for b13: Bool
  for b9: Bool
  for ct: Bool
  for +uu: U32
  for e34: {U32.is_eq(uu, 34) == b34 : Bool}
  for e92: {U32.is_eq(uu, 92) == b92 : Bool}
  for ect: {U32.is_lt(uu, 32) == ct : Bool}
  {Laws.tx.run(String.to_list(Bool.pick(String, b34, "\\\"", Bool.pick(String, b92, "\\\\", Bool.pick(String, b8,
    "\\b", Bool.pick(String, b12, "\\f", Bool.pick(String, b10, "\\n", Bool.pick(String, b13, "\\r", Bool.pick(String,
    b9, "\\t", Print.escape.rest.go(uu, Chr{uu}, ct))))))))), Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}

def tx_plain(b34, b92, b8, b12, b10, b13, b9, ct, uu, e34, e92, ect):
  match b34:
    case True{}:
      {==}
    case False{}:
      match b92:
        case True{}:
          {==}
        case False{}:
          match b8:
            case True{}:
              {==}
            case False{}:
              match b12:
                case True{}:
                  {==}
                case False{}:
                  match b10:
                    case True{}:
                      {==}
                    case False{}:
                      match b13:
                        case True{}:
                          {==}
                        case False{}:
                          match b9:
                            case True{}:
                              {==}
                            case False{}:
                              match ct:
                                case True{}:
                                  tx_ctl(uu, ect)
                                case False{}:
                                  s92 = Equal.sym(Bool, U32.is_eq(uu, 92), False{}, e92)
                                  s34 = Equal.sym(Bool, U32.is_eq(uu, 34), False{}, e34)
                                  %s92 : {Bool.pick(Laws.Tx, _, Laws.TxEsc{}, Bool.pick(Laws.Tx, U32.is_eq(uu, 34),
                                    Laws.TxOut{}, Laws.TxIn{})) == Laws.TxIn{} : Laws.Tx}
                                  %s34 : {Bool.pick(Laws.Tx, _, Laws.TxOut{}, Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}
                                  {==}

# one character's escape, once it is known whether it is a scalar value
law tx_sc:
  for sc: Bool
  for +uu: U32
  {Laws.tx.run(String.to_list(Print.escape.scalar(uu, Chr{uu}, sc)), Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}

def tx_sc(sc, uu):
  match sc:
    case True{}:
      tx_plain(U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 8), U32.is_eq(uu, 12), U32.is_eq(uu, 10),
        U32.is_eq(uu, 13), U32.is_eq(uu, 9), U32.is_lt(uu, 32), uu, {==}, {==}, {==})
    case False{}:
      {==}

# a character print escapes stays inside the string
law tx_char:
  for +ch: Char
  {Laws.tx.run(String.to_list(Print.escape.char(ch)), Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}

def tx_char(ch):
  match ch:
    case Chr{+uu}:
      tx_sc(Print.scalar(uu), uu)

# print's escape of the characters stays inside the string
law tx_esc:
  for +cs: List<&2, Char>
  {Laws.tx.run(String.to_list(Print.escape(cs)), Laws.TxIn{}) == Laws.TxIn{} : Laws.Tx}

def tx_esc(cs):
  match cs:
    case Nil{}:
      {==}
    case Con{+hd, +tl}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.escape.char(hd) ++ Print.escape(tl)), Laws.TxIn{}),
        Laws.tx.run(String.to_list(Print.escape(tl)), Laws.TxIn{}), Laws.TxIn{},
        tseq(Print.escape.char(hd), Print.escape(tl), Laws.TxIn{}, Laws.TxIn{}, tx_char(hd)), tx_esc(tl))

# a quoted string leaves the scan outside strings
law tx_quote:
  for +txt: String
  {Laws.tx.run(String.to_list(Print.quote(txt)), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def tx_quote(txt):
  +ee = Print.escape(String.to_list(txt))
  Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("\"" ++ ee ++ "\""), Laws.TxOut{}),
    Laws.tx.run(String.to_list(ee ++ "\""), Laws.TxIn{}), Laws.TxOut{},
    tseq("\"", ee ++ "\"", Laws.TxOut{}, Laws.TxIn{}, {==}),
    tseq(ee, "\"", Laws.TxIn{}, Laws.TxIn{}, tx_esc(String.to_list(txt))))


# tx_print for an array cell, by what follows it
law txp_cons:
  for tl: V.Json
  for +hd: V.Json
  for +h: {V.wf.go(V.JCons{hd, tl}, V.WArr{}) == True{} : Bool}
  for ih_hd: {V.wf.go(hd, V.WVal{}) == True{} : Bool} -> {Laws.tx.run(String.to_list(Print.print(hd)),
    Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  for ih_tl: {V.wf.go(tl, V.WArr{}) == True{} : Bool} -> {Laws.tx.run(String.to_list(Print.print(tl)),
    Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  {Laws.tx.run(String.to_list(Print.print(V.JCons{hd, tl})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def txp_cons(tl, hd, h, ih_hd, ih_tl):
  match tl:
    case V.JNil{}:
      ih_hd(stop_l(V.wf.go(hd, V.WVal{}), V.wf.go(V.JNil{}, V.WArr{}), h))
    case V.JNull{}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JNull{}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JNull{})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JNull{}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JNull{}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JNull{})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JNull{})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JNull{}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JNull{}, V.WArr{}), h))))
    case V.JBool{+t1}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JBool{t1}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JBool{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JBool{t1}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JBool{t1}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JBool{t1})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JBool{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JBool{t1}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JBool{t1}, V.WArr{}), h))))
    case V.JNum{+t1}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JNum{t1}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JNum{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JNum{t1}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JNum{t1}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JNum{t1})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JNum{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JNum{t1}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JNum{t1}, V.WArr{}), h))))
    case V.JStr{+t1}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JStr{t1}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JStr{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JStr{t1}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JStr{t1}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JStr{t1})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JStr{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JStr{t1}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JStr{t1}, V.WArr{}), h))))
    case V.JArr{+t1}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JArr{t1}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JArr{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JArr{t1}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JArr{t1}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JArr{t1})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JArr{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JArr{t1}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JArr{t1}, V.WArr{}), h))))
    case V.JObj{+t1}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JObj{t1}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JObj{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JObj{t1}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JObj{t1}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JObj{t1})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JObj{t1})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JObj{t1}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JObj{t1}, V.WArr{}), h))))
    case V.JCons{+t1, +t2}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JCons{t1, t2}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JCons{t1, t2})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JCons{t1, t2}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JCons{t1, t2}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JCons{t1, t2})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JCons{t1, t2})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JCons{t1, t2}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JCons{t1, t2}, V.WArr{}), h))))
    case V.JPair{+t1, +t2, +t3}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JPair{t1, t2, t3}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JPair{t1, t2, t3})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JPair{t1, t2, t3}), Laws.TxOut{}, Laws.TxOut{},
          ih_hd(stop_l(V.wf.go(hd, V.WVal{}), V.wf.go(V.JPair{t1, t2, t3}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JPair{t1, t2, t3})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JPair{t1, t2, t3})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JPair{t1, t2, t3}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JPair{t1, t2, t3}, V.WArr{}), h))))
    case V.JSpan{+t1, +t2}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JSpan{t1, t2}))),
        Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JSpan{t1, t2})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JSpan{t1, t2}), Laws.TxOut{}, Laws.TxOut{}, ih_hd(stop_l(V.wf.go(hd,
          V.WVal{}), V.wf.go(V.JSpan{t1, t2}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JSpan{t1, t2})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JSpan{t1, t2})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JSpan{t1, t2}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JSpan{t1, t2}, V.WArr{}), h))))
    case V.JBind{+t1, +t2, +t3, +t4}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(hd) ++ ("," ++ Print.print(V.JBind{t1, t2, t3,
        t4}))), Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JBind{t1, t2, t3, t4})), Laws.TxOut{}),
        Laws.TxOut{},
        tseq(Print.print(hd), "," ++ Print.print(V.JBind{t1, t2, t3, t4}), Laws.TxOut{}, Laws.TxOut{},
          ih_hd(stop_l(V.wf.go(hd, V.WVal{}), V.wf.go(V.JBind{t1, t2, t3, t4}, V.WArr{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JBind{t1, t2, t3, t4})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JBind{t1, t2, t3, t4})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JBind{t1, t2, t3, t4}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_tl(stop_r(V.wf.go(hd, V.WVal{}), V.wf.go(V.JBind{t1, t2, t3, t4}, V.WArr{}), h))))

# tx_print for an object cell, by what follows it
law txp_pair:
  for rr: V.Json
  for +kk: String
  for +vv: V.Json
  for +h: {V.wf.go(V.JPair{kk, vv, rr}, V.WObj{}) == True{} : Bool}
  for ih_v: {V.wf.go(vv, V.WVal{}) == True{} : Bool} -> {Laws.tx.run(String.to_list(Print.print(vv)),
    Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  for ih_r: {V.wf.go(rr, V.WObj{}) == True{} : Bool} -> {Laws.tx.run(String.to_list(Print.print(rr)),
    Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}
  {Laws.tx.run(String.to_list(Print.print(V.JPair{kk, vv, rr})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def txp_pair(rr, kk, vv, h, ih_v, ih_r):
  match rr:
    case V.JNil{}:
      Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.quote(kk) ++ (":" ++ Print.print(vv))), Laws.TxOut{}),
        Laws.tx.run(String.to_list(":" ++ Print.print(vv)), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.quote(kk), ":" ++ Print.print(vv), Laws.TxOut{}, Laws.TxOut{}, tx_quote(kk)),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(":" ++ Print.print(vv)), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(vv)), Laws.TxOut{}), Laws.TxOut{},
        tseq(":", Print.print(vv), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_v(stop_l(V.wf.go(vv, V.WVal{}), V.wf.go(V.JNil{}, V.WObj{}), h))))
    case V.JNull{}:
      Equal.trans(Laws.Tx,
        Laws.tx.run(String.to_list(Print.quote(kk) ++ (":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JNull{}))))),
        Laws.TxOut{}), Laws.tx.run(String.to_list(":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JNull{})))),
        Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.quote(kk), ":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JNull{}))), Laws.TxOut{}, Laws.TxOut{},
          tx_quote(kk)),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JNull{})))),
          Laws.TxOut{}), Laws.tx.run(String.to_list(Print.print(vv) ++ ("," ++ Print.print(V.JNull{}))), Laws.TxOut{}),
          Laws.TxOut{},
        tseq(":", Print.print(vv) ++ ("," ++ Print.print(V.JNull{})), Laws.TxOut{}, Laws.TxOut{}, {==}),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(vv) ++ ("," ++ Print.print(V.JNull{}))),
          Laws.TxOut{}), Laws.tx.run(String.to_list("," ++ Print.print(V.JNull{})), Laws.TxOut{}), Laws.TxOut{},
        tseq(Print.print(vv), "," ++ Print.print(V.JNull{}), Laws.TxOut{}, Laws.TxOut{}, ih_v(stop_l(V.wf.go(vv,
          V.WVal{}), V.wf.go(V.JNull{}, V.WObj{}), h))),
        Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("," ++ Print.print(V.JNull{})), Laws.TxOut{}),
          Laws.tx.run(String.to_list(Print.print(V.JNull{})), Laws.TxOut{}), Laws.TxOut{},
        tseq(",", Print.print(V.JNull{}), Laws.TxOut{}, Laws.TxOut{}, {==}),
        ih_r(stop_r(V.wf.go(vv, V.WVal{}), V.wf.go(V.JNull{}, V.WObj{}), h))))))
    case V.JBool{+t1}:
      Equal.trans(Laws.Tx,
        Laws.tx.run(String.to_list(Print.quote(kk) ++ (":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JBool{t1}))))),
        Laws.TxOut{}), Laws.tx.run(String.to_list(":" ++ (Print.print(vv) ++ ("," ++ Print.print(V.JBool{t1})))),
