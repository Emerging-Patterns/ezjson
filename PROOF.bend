            ws_idle(a1, h, Lex.TOpenArr{} <> acc)), {==})))
        case Laws.GKArr{}:
          no(lgg(Laws.GArr0{a1}, Laws.GKArr{}, acc, ww, st), h)
        case Laws.GKObj{}:
