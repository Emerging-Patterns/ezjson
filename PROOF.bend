law cpo:
  for +lt: Lt
  for +dd: Nat
  for +ww: Bool
  for +cls: Lex.Class
  for +ch: Char
  cpt(sc.out(lt, dd, cls, ch), gps(Laws.GpOut{ww}, cls))

def cpo(lt, dd, ww, cls, ch):
  match cls:
    case Lex.CPunct{tk}:
      match tk:
        case Lex.TOpenArr{}:
          cpo.c1(lt, dd, ww, ch)
        case Lex.TCloseArr{}:
          cpo.c2(lt, dd, ww, ch)
        case Lex.TOpenObj{}:
          cpo.c3(lt, dd, ww, ch)
        case Lex.TCloseObj{}:
          cpo.c4(lt, dd, ww, ch)
        case Lex.TColon{}:
          cpo.c5(lt, dd, ww, ch)
        case Lex.TComma{}:
          cpo.c6(lt, dd, ww, ch)
        case Lex.TStr{_x0}:
          Unit{}
        case Lex.TWord{_x0}:
          Unit{}
        case Lex.TStrS{_x0, _x1}:
          Unit{}
        case Lex.TWordS{_x0, _x1}:
          Unit{}
        case Lex.TBad{}:
          Unit{}
    case Lex.CQuote{}:
      cpo.c7(lt, dd, ww, ch)
    case Lex.CBack{}:
      Unit{}
    case Lex.CSpace{}:
      Unit{}
    case Lex.COther{}:
      cpo.c8(lt, dd, ww, ch)


law cpw.t.c1:
  for +dd: Nat
  for +ba: List<&2, Char>
  for +ch: Char
  cpt(sc.word(ba, dd, Lex.CPunct{Lex.TCloseArr{}}, ch), gps(Laws.GpOut{True{}}, Lex.CPunct{Lex.TCloseArr{}}))

def cpw.t.c1(dd, ba, _ch):
  match dd:
    case 0n:
      pick_cp(Laws.lit_or_num(Lex.text(ba)), SBad{}, Laws.GpOut{False{}}, Unit{})
    case 1n+n0:
      pick_cp(Laws.lit_or_num(Lex.text(ba)), SOut{LVal{}, n0}, Laws.GpOut{False{}}, Unit{})

law cpw.t.c2:
  for +dd: Nat
  for +ba: List<&2, Char>
  for +ch: Char
  cpt(sc.word(ba, dd, Lex.CPunct{Lex.TCloseObj{}}, ch), gps(Laws.GpOut{True{}}, Lex.CPunct{Lex.TCloseObj{}}))

