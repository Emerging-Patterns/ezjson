      +r4 = and_right(Laws.g.ok(xvv, Laws.GKVal{}), Bool.and(Laws.all_ws(xw3), Laws.g.ok(xrr, Laws.GKObj{})), r3)
      +hw3 = and_left(Laws.all_ws(xw3), Laws.g.ok(xrr, Laws.GKObj{}), r4)
