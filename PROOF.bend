  for +elt: {Nat.is_lt(U32.to_nat(xx), 48n) == lt : Bool}
  for h: {Bool.and(Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))) == True{} : Bool}
  {U32.to_nat(U32.sub(xx, 48)) == Nat.sub(U32.to_nat(xx), 48n) : Nat}

def dig_val_nat(uu, xx, lt, elt, h):
  match lt:
    case True{}:
      Empty.absurd({U32.to_nat(U32.sub(xx, 48)) == Nat.sub(U32.to_nat(xx), 48n) : Nat}, false_true(Equal.trans(Bool,
        False{}, Bool.and(Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))), True{},
        Equal.cong(Bool, Bool, zz => Bool.and(zz, Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))), False{},
          Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)),
          Equal.sym(Bool, Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), False{}, cmp_lt_nge(Nat.cmp(U32.to_nat(xx), 48n),
            elt))), h)))
    case False{}:
      Equal.sym(Nat, Nat.sub(U32.to_nat(xx), 48n), U32.to_nat(U32.sub(xx, 48)),
        Equal.trans(Nat, Nat.sub(U32.to_nat(xx), 48n), Nat.sub(Nat.add(U32.to_nat(U32.sub(xx, 48)), 48n), 48n),
          U32.to_nat(U32.sub(xx, 48)),
          Equal.cong(Nat, Nat, zz => Nat.sub(zz, 48n), U32.to_nat(xx), Nat.add(U32.to_nat(U32.sub(xx, 48)), 48n),
            Equal.sym(Nat, Nat.add(U32.to_nat(U32.sub(xx, 48)), 48n), U32.to_nat(xx), u_sub_ge(uu, xx, 48, elt))),
          Equal.trans(Nat, Nat.sub(Nat.add(U32.to_nat(U32.sub(xx, 48)), 48n), 48n), Nat.sub(Nat.add(48n,
            U32.to_nat(U32.sub(xx, 48))), 48n), U32.to_nat(U32.sub(xx, 48)),
            Equal.cong(Nat, Nat, zz => Nat.sub(zz, 48n), Nat.add(U32.to_nat(U32.sub(xx, 48)), 48n), Nat.add(48n,
              U32.to_nat(U32.sub(xx, 48))), nat_add_comm(U32.to_nat(U32.sub(xx, 48)), 48n)),
            nat_sub_zero(U32.to_nat(U32.sub(xx, 48))))))

# a digit's value is its code point less 48
law dig_val:
  for +uu: Unit
  for +xx: U32
  for h: {Laws.digit(Chr{xx}) == True{} : Bool}
  {U32.to_nat(U32.sub(xx, 48)) == Nat.sub(U32.to_nat(xx), 48n) : Nat}

def dig_val(uu, xx, h):
  dig_val_nat(uu, xx, Nat.is_lt(U32.to_nat(xx), 48n), {==}, Equal.trans(Bool,
    Bool.and(Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))),
    Bool.and(Cmp.is_ge(U32.cmp(xx, 48)), Cmp.is_le(U32.cmp(xx, 57))), True{},
    Equal.trans(Bool, Bool.and(Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))),
      Bool.and(Cmp.is_ge(U32.cmp(xx, 48)), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))), Bool.and(Cmp.is_ge(U32.cmp(xx,
      48)), Cmp.is_le(U32.cmp(xx, 57))),
    Equal.cong(Cmp, Bool, zz => Bool.and(Cmp.is_ge(zz), Cmp.is_le(Nat.cmp(U32.to_nat(xx), 57n))),
      Nat.cmp(U32.to_nat(xx), 48n), U32.cmp(xx, 48),
      Equal.sym(Cmp, U32.cmp(xx, 48), Nat.cmp(U32.to_nat(xx), 48n), u_cmp(xx, 48))),
    Equal.cong(Cmp, Bool, zz => Bool.and(Cmp.is_ge(U32.cmp(xx, 48)), Cmp.is_le(zz)), Nat.cmp(U32.to_nat(xx), 57n),
      U32.cmp(xx, 57),
      Equal.sym(Cmp, U32.cmp(xx, 57), Nat.cmp(U32.to_nat(xx), 57n), u_cmp(xx, 57)))), h))

# JSON-TREE-6: fits, and the spec's texts

# half of v is below y exactly when v is below twice y
law half_lt:
  for vv: Nat
  for yy: Nat
  {Nat.is_lt(Laws.half(vv), yy) == Nat.is_lt(vv, Nat.double(yy)) : Bool}

def half_lt(vv, yy):
  match vv:
    case 0n:
      match yy:
        case 0n:
          {==}
        case 1n+_yp:
          {==}
    case 1n+pv:
      match pv:
        case 0n:
          match yy:
            case 0n:
              {==}
            case 1n+_yp:
              {==}
        case 1n+qq:
          match yy:
            case 0n:
              {==}
            case 1n+yp:
              half_lt(qq, yp)

# fitting in kk bits is being below 2^kk
law fits_lt:
  for +kk: Nat
  for +vv: Nat
  {Laws.fits(kk, vv) == Nat.is_lt(vv, pow2(kk)) : Bool}

def fits_lt(kk, vv):
  match kk:
    case 0n:
      match vv:
        case 0n:
          {==}
        case 1n+vp:
          Equal.sym(Bool, Nat.is_lt(vp, 0n), False{}, nat_nlt_zero(vp))
    case 1n+(+pp):
      Equal.trans(Bool, Laws.fits(pp, Laws.half(vv)), Nat.is_lt(Laws.half(vv), pow2(pp)), Nat.is_lt(vv,
        Nat.double(pow2(pp))),
        fits_lt(pp, Laws.half(vv)), half_lt(vv, pow2(pp)))

# fits_lt, with 2^kk named through uu
law fits_lt_u:
  for +kk: Nat
  for uu: Unit
  for +vv: Nat
  {Laws.fits(kk, vv) == Nat.is_lt(vv, pow2u(kk, uu)) : Bool}

def fits_lt_u(kk, uu, vv):
  match uu:
    case Unit{}:
      fits_lt(kk, vv)

# a true when: its condition
law when_c:
  for cc: Bool
  for -yy: Bool
  for h: {Laws.when(cc, yy, False{}) == True{} : Bool}
  {cc == True{} : Bool}

def when_c(cc, _yy, h):
  match cc:
    case True{}:
      {==}
    case False{}:
      Empty.absurd({False{} == True{} : Bool}, false_true(h))

# a true when: its first branch
law when_y:
  for cc: Bool
  for -yy: Bool
  for h: {Laws.when(cc, yy, False{}) == True{} : Bool}
  {yy == True{} : Bool}

def when_y(cc, _yy, h):
  match cc:
    case True{}:
      h
    case False{}:
      Empty.absurd({_yy == True{} : Bool}, false_true(h))

# ten times v is v and nine times v
law nat_mul10:
  for +vv: Nat
  {Nat.mul(vv, 10n) == Nat.add(vv, Nat.mul(vv, 9n)) : Nat}

def nat_mul10(vv):
  Equal.trans(Nat, Nat.mul(vv, 10n), Nat.add(Nat.mul(vv, 1n), Nat.mul(vv, 9n)), Nat.add(vv, Nat.mul(vv, 9n)),
    nat_mul_add_l(vv, 1n, 9n),
    Equal.cong(Nat, Nat, zz => Nat.add(zz, Nat.mul(vv, 9n)), Nat.mul(vv, 1n), vv, nat_mul_one(vv)))

# reading more digits never lowers the value below a bound it has reached
law dec_val_ge:
  for +cs: List<&2, Char>
  for +vv: Nat
  for +tt: Nat
  for h: {Nat.is_lt(vv, tt) == False{} : Bool}
  {Nat.is_lt(Laws.dec_val(cs, vv), tt) == False{} : Bool}

def dec_val_ge(cs, vv, tt, h):
  match cs:
    case Nil{}:
      h
    case ch <> tl:
      dec_val_ge(tl, Nat.add(Nat.mul(vv, 10n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)), tt,
        Equal.trans(Bool, Nat.is_lt(Nat.add(Nat.mul(vv, 10n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)), tt),
          Nat.is_lt(Nat.add(vv, Nat.add(Nat.mul(vv, 9n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n))), tt), False{},
          Equal.cong(Nat, Bool, zz => Nat.is_lt(zz, tt), Nat.add(Nat.mul(vv, 10n), Nat.sub(U32.to_nat(Char.to_u32(ch)),
            48n)),
            Nat.add(vv, Nat.add(Nat.mul(vv, 9n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n))),
            Equal.trans(Nat, Nat.add(Nat.mul(vv, 10n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)),
              Nat.add(Nat.add(vv, Nat.mul(vv, 9n)), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)),
              Nat.add(vv, Nat.add(Nat.mul(vv, 9n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n))),
              Equal.cong(Nat, Nat, zz => Nat.add(zz, Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)), Nat.mul(vv, 10n),
                Nat.add(vv, Nat.mul(vv, 9n)), nat_mul10(vv)),
              nat_add_assoc(vv, Nat.mul(vv, 9n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)))),
          nat_ge_add(vv, Nat.add(Nat.mul(vv, 9n), Nat.sub(U32.to_nat(Char.to_u32(ch)), 48n)), tt, h)))

# JSON-TREE-6: U32.read over digits

# one step of U32.read over a digit, once whether the value stays below 2^32
# is known
law rd_step:
  for +uu: Unit
  for +acc: U32
  for +xx: U32
  for +tt: String
  for bb: Bool
  for +eb: {Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))), pow2u(32n, uu)) == bb : Bool}
  for h1: {Nat.is_lt(U32.to_nat(U32.sub(xx, 48)), 10n) == True{} : Bool}
  for ih: {Laws.u32_nat(U32.read.go(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)))) == Laws.nat_if(Laws.fits(32n,
    Laws.dec_val(String.to_list(tt), U32.to_nat(U32.add(U32.mul(acc, 10), U32.sub(xx, 48))))),
    Laws.dec_val(String.to_list(tt), U32.to_nat(U32.add(U32.mul(acc, 10), U32.sub(xx, 48))))) : Maybe<&2, Nat>}
  {Laws.u32_nat(U32.read.if(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), U32.is_eq(U32.div(U32.add(U32.mul(acc, 10),
    U32.sub(xx, 48)), 10), acc))) == Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt),
    Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))))), Laws.dec_val(String.to_list(tt),
    Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))))) : Maybe<&2, Nat>}

def rd_step(uu, acc, xx, tt, bb, eb, h1, ih):
  match bb:
    case True{}:
      ok = Equal.sym(Bool, U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), 10), acc), True{}, step_ok(uu,
        acc, U32.sub(xx, 48), h1, eb))
      %ok : {Laws.u32_nat(U32.read.if(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), _)) == Laws.nat_if(Laws.fits(32n,
        Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))))),
        Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx,
        48))))) : Maybe<&2, Nat>}
      Equal.trans(Maybe<&2, Nat>, Laws.u32_nat(U32.read.go(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)))),
        Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt), U32.to_nat(U32.add(U32.mul(acc, 10), U32.sub(xx,
        48))))), Laws.dec_val(String.to_list(tt), U32.to_nat(U32.add(U32.mul(acc, 10), U32.sub(xx, 48))))),
        Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))), Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))), ih,
        Equal.cong(Nat, Maybe<&2, Nat>, zz => Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt), zz)),
          Laws.dec_val(String.to_list(tt), zz)), U32.to_nat(U32.add(U32.mul(acc, 10), U32.sub(xx, 48))),
          Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))), step_n(uu, acc, U32.sub(xx, 48), eb)))
    case False{}:
      bad = Equal.sym(Bool, U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), 10), acc), False{},
        bool_false(U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), 10), acc),
        hh => true_false(Equal.trans(Bool, True{},
        Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))), pow2u(32n, uu)), False{},
        Equal.sym(Bool, Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))), pow2u(32n, uu)),
          True{}, step_bad_t(uu, acc, U32.sub(xx, 48), hh)), eb))))
      %bad : {Laws.u32_nat(U32.read.if(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)),
        _)) == Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))), Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))) : Maybe<&2, Nat>}
      big = Equal.sym(Bool, Laws.fits(32n, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))), False{},
        Equal.trans(Bool, Laws.fits(32n, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
          U32.to_nat(U32.sub(xx, 48))))), Nat.is_lt(Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc),
          10n), U32.to_nat(U32.sub(xx, 48)))), pow2u(32n, uu)), False{},
          fits_lt_u(32n, uu, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
            U32.to_nat(U32.sub(xx, 48))))), dec_val_ge(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
            U32.to_nat(U32.sub(xx, 48))), pow2u(32n, uu), eb)))
      %big : {None{} == Laws.nat_if(_, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n),
        U32.to_nat(U32.sub(xx, 48))))) : Maybe<&2, Nat>}
      {==}

# over digits, U32.read reads their value when it is below 2^32, else none
law read_all:
  for +uu: Unit
  for ss: String
  for +acc: U32
  for +h: {Laws.digits_end(String.to_list(ss)) == True{} : Bool}
  {Laws.u32_nat(U32.read.go(ss, acc)) == Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(ss), U32.to_nat(acc))),
    Laws.dec_val(String.to_list(ss), U32.to_nat(acc))) : Maybe<&2, Nat>}

def read_all(uu, ss, acc, h):
  match ss:
    case SNil{}:
      ee = Equal.sym(Bool, Laws.fits(32n, U32.to_nat(acc)), True{},
        Equal.trans(Bool, Laws.fits(32n, U32.to_nat(acc)), Nat.is_lt(U32.to_nat(acc), pow2u(32n, uu)), True{},
          fits_lt_u(32n, uu, U32.to_nat(acc)), u_bound(uu, acc)))
      %ee : {Some{U32.to_nat(acc)} == Laws.nat_if(_, U32.to_nat(acc)) : Maybe<&2, Nat>}
      {==}
    case SCon{Chr{+xx}, +tt}:
      +hd = when_c(Laws.digit(Chr{xx}), Laws.digits_end(String.to_list(tt)), h)
      dv = dig_val(uu, xx, hd)
      %dv : {Laws.u32_nat(U32.read.if(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)),
        U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), 10), acc))) ==
        Laws.nat_if(Laws.fits(32n, Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n), _))),
          Laws.dec_val(String.to_list(tt), Nat.add(Nat.mul(U32.to_nat(acc), 10n), _))) : Maybe<&2, Nat>}
      rd_step(uu, acc, xx, tt, Nat.is_lt(Nat.add(Nat.mul(U32.to_nat(acc), 10n), U32.to_nat(U32.sub(xx, 48))),
        pow2u(32n, uu)), {==},
        Equal.trans(Bool, Nat.is_lt(U32.to_nat(U32.sub(xx, 48)), 10n), Laws.digit(Chr{xx}), True{}, dig_lt(uu, xx), hd),
        read_all(uu, tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), when_y(Laws.digit(Chr{xx}),
          Laws.digits_end(String.to_list(tt)), h)))

# U32.read.if on a false check is none, and on a true one continues
law rif_f:
  for tt: String
  for nn: U32
  for bb: Bool
  for h: {bb == False{} : Bool}
  {U32.read.if(tt, nn, bb) == None{} : Maybe<&2, U32>}

def rif_f(_tt, _nn, bb, h):
  match bb:
    case False{}:
      {==}
    case True{}:
      Empty.absurd({U32.read.if(_tt, _nn, True{}) == None{} : Maybe<&2, U32>}, true_false(h))

# U32.read.if whose continuation is none is none
law rif_n:
  for tt: String
  for +nn: U32
  for bb: Bool
  for h: {U32.read.go(tt, nn) == None{} : Maybe<&2, U32>}
  {U32.read.if(tt, nn, bb) == None{} : Maybe<&2, U32>}

def rif_n(_tt, _nn, bb, h):
  match bb:
    case False{}:
      {==}
    case True{}:
      h

# one step of U32.read, once whether the character is a digit is known,
# when some character is not a digit
law rb_step:
  for +uu: Unit
  for +acc: U32
  for +xx: U32
  for +tt: String
  for dg: Bool
  for edg: {Laws.digit(Chr{xx}) == dg : Bool}
  for h: {Laws.when(dg, Laws.digits_end(String.to_list(tt)), False{}) == False{} : Bool}
  for ih: {Laws.digits_end(String.to_list(tt)) == False{} : Bool} -> {U32.read.go(tt, U32.add(U32.mul(acc, 10),
    U32.sub(xx, 48))) == None{} : Maybe<&2, U32>}
  {U32.read.if(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx,
    48)), 10), acc)) == None{} : Maybe<&2, U32>}

def rb_step(uu, acc, xx, tt, dg, edg, h, ih):
  match dg:
    case True{}:
      rif_n(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx,
        48)), 10), acc), ih(h))
    case False{}:
      rif_f(tt, U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx,
        48)), 10), acc), bool_false(U32.is_eq(U32.div(U32.add(U32.mul(acc, 10), U32.sub(xx, 48)), 10), acc),
        hh => true_false(Equal.trans(Bool, True{}, Nat.is_lt(U32.to_nat(U32.sub(xx, 48)), 10n), False{},
        Equal.sym(Bool, Nat.is_lt(U32.to_nat(U32.sub(xx, 48)), 10n), True{}, step_bad_d(uu, acc, U32.sub(xx, 48), hh)),
        Equal.trans(Bool, Nat.is_lt(U32.to_nat(U32.sub(xx, 48)), 10n), Laws.digit(Chr{xx}), False{}, dig_lt(uu, xx),
          edg)))))

# over a text with a character that is not a digit, U32.read is none
law read_bad:
  for +uu: Unit
  for ss: String
  for +acc: U32
  for h: {Laws.digits_end(String.to_list(ss)) == False{} : Bool}
  {U32.read.go(ss, acc) == None{} : Maybe<&2, U32>}

def read_bad(uu, ss, acc, h):
  match ss:
    case SNil{}:
      Empty.absurd({Some{acc} == None{} : Maybe<&2, U32>}, true_false(h))
    case SCon{Chr{+xx}, +tt}:
      rb_step(uu, acc, xx, tt, Laws.digit(Chr{xx}), {==}, h, hh => read_bad(uu, tt, U32.add(U32.mul(acc, 10),
        U32.sub(xx, 48)), hh))

# JSON-TREE-6: the decimals are the JSON numbers that are all digits

# a character that is some code point is a character of it
law cp_eq:
  for xx: U32
  for kk: U32
  for +h: {Laws.is_cp(Chr{xx}, kk) == True{} : Bool}
  {kk == xx : U32}

def cp_eq(xx, kk, h):
  Equal.sym(U32, xx, kk, ueq(xx, kk, h))

# digits_end then digits_rest: digits end the rest of an int
law de_dr:
  for +cs: List<&2, Char>
  for +h: {Laws.digits_end(cs) == True{} : Bool}
  {Laws.digits_rest(cs) == True{} : Bool}

def de_dr(cs, h):
  match cs:
    case Nil{}:
      {==}
    case +ch <> +tl:
      dg = Equal.sym(Bool, Laws.digit(ch), True{}, when_c(Laws.digit(ch), Laws.digits_end(tl), h))
      %dg : {Laws.when(_, Laws.digits_rest(tl), Laws.when(Laws.is_cp(ch, 46), Laws.frac_body(tl),
        Laws.when(Laws.is_e(ch), Laws.exp_body(tl), False{}))) == True{} : Bool}
      de_dr(tl, when_y(Laws.digit(ch), Laws.digits_end(tl), h))

# nothing left: zero_rest holds
law nm_zr:
  for cs: List<&2, Char>
  for +h: {Laws.no_more(cs) == True{} : Bool}
  {Laws.zero_rest(cs) == True{} : Bool}

def nm_zr(cs, h):
  match cs:
    case Nil{}:
      {==}
    case _ch <> _tl:
      Empty.absurd({Laws.zero_rest(_ch <> _tl) == True{} : Bool}, false_true(h))

# nothing left: digits_end holds
law nm_de:
  for cs: List<&2, Char>
  for +h: {Laws.no_more(cs) == True{} : Bool}
  {Laws.digits_end(cs) == True{} : Bool}

def nm_de(cs, h):
  match cs:
    case Nil{}:
      {==}
    case _ch <> _tl:
      Empty.absurd({Laws.digits_end(_ch <> _tl) == True{} : Bool}, false_true(h))

# 45 is no digit 1-9
law d19_45:
  for +xx: U32
  for +h19: {Laws.digit19(Chr{xx}) == True{} : Bool}
  {Laws.is_cp(Chr{xx}, 45) == False{} : Bool}

def d19_45(xx, h19):
  bool_false(Laws.is_cp(Chr{xx}, 45), hh => false_true(Equal.trans(Bool, Laws.digit19(Chr{45}), Laws.digit19(Chr{xx}),
    True{},
    Equal.cong(U32, Bool, zz => Laws.digit19(Chr{zz}), 45, xx, cp_eq(xx, 45, hh)), h19)))

# 45 is no digit
law dig_45:
  for +xx: U32
  for +hd: {Laws.digit(Chr{xx}) == True{} : Bool}
  {Laws.is_cp(Chr{xx}, 45) == False{} : Bool}

def dig_45(xx, hd):
  bool_false(Laws.is_cp(Chr{xx}, 45), hh => false_true(Equal.trans(Bool, Laws.digit(Chr{45}), Laws.digit(Chr{xx}),
    True{},
    Equal.cong(U32, Bool, zz => Laws.digit(Chr{zz}), 45, xx, cp_eq(xx, 45, hh)), hd)))

# a decimal is a JSON number, once whether it starts with 0 is known
law num_of_dec:
  for +xx: U32
  for +tl: List<&2, Char>
  for zz: Bool
  for +ez: {Laws.is_cp(Chr{xx}, 48) == zz : Bool}
  for +h: {Laws.when(zz, Laws.no_more(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_end(tl),
    False{})) == True{} : Bool}
  {Laws.number(Chr{xx} <> tl) == True{} : Bool}

def num_of_dec(xx, tl, zz, ez, h):
  match zz:
    case True{}:
      e48 = cp_eq(xx, 48, ez)
      %e48 : {Laws.number(Chr{_} <> tl) == True{} : Bool}
      nm_zr(tl, h)
    case False{}:
      +d19 = when_c(Laws.digit19(Chr{xx}), Laws.digits_end(tl), h)
      c45 = Equal.sym(Bool, Laws.is_cp(Chr{xx}, 45), False{}, d19_45(xx, d19))
      %c45 : {Laws.when(_, Laws.int_end(tl), Laws.int_end(Chr{xx} <> tl)) == True{} : Bool}
      c48 = Equal.sym(Bool, Laws.is_cp(Chr{xx}, 48), False{}, ez)
      %c48 : {Laws.when(_, Laws.zero_rest(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_rest(tl),
        False{})) == True{} : Bool}
      e19 = Equal.sym(Bool, Laws.digit19(Chr{xx}), True{}, d19)
      %e19 : {Laws.when(_, Laws.digits_rest(tl), False{}) == True{} : Bool}
      de_dr(tl, when_y(Laws.digit19(Chr{xx}), Laws.digits_end(tl), h))

# a decimal is a JSON number
law dec_number:
  for cs: List<&2, Char>
  for +h: {Laws.decimal(cs) == True{} : Bool}
  {Laws.number(cs) == True{} : Bool}

def dec_number(cs, h):
  match cs:
    case Nil{}:
      Empty.absurd({False{} == True{} : Bool}, false_true(h))
    case Chr{+xx} <> +tl:
      num_of_dec(xx, tl, Laws.is_cp(Chr{xx}, 48), {==}, h)

# a when that is False first and one that is False last cannot both hold
law zr_nm.go:
  for dd: Bool
  for -xx: Bool
  for -yy: Bool
  for +hz: {Laws.when(dd, False{}, xx) == True{} : Bool}
  for +hd: {Laws.when(dd, yy, False{}) == True{} : Bool}
  Empty

def zr_nm.go(dd, _xx, _yy, hz, hd):
  match dd:
    case True{}:
      false_true(hz)
    case False{}:
      false_true(hd)

# zero_rest and digits_end together: nothing is left
law zr_nm:
  for cs: List<&2, Char>
  for +hz: {Laws.zero_rest(cs) == True{} : Bool}
  for +hd: {Laws.digits_end(cs) == True{} : Bool}
  {Laws.no_more(cs) == True{} : Bool}

def zr_nm(cs, hz, hd):
  match cs:
    case Nil{}:
      {==}
    case +ch <> +tl:
      Empty.absurd({False{} == True{} : Bool}, zr_nm.go(Laws.digit(ch), Laws.when(Laws.is_cp(ch, 46),
        Laws.frac_body(tl),
        Laws.when(Laws.is_e(ch), Laws.exp_body(tl), False{})), Laws.digits_end(tl), hz, hd))

# a text that is all digits and a JSON number, once whether it starts with 0
# is known, is a decimal
law dec_of_num:
  for +xx: U32
  for +tl: List<&2, Char>
  for zz: Bool
  for +ez: {Laws.is_cp(Chr{xx}, 48) == zz : Bool}
  for +hi: {Laws.when(zz, Laws.zero_rest(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_rest(tl),
    False{})) == True{} : Bool}
  for +de: {Laws.digits_end(tl) == True{} : Bool}
  {Laws.decimal(Chr{xx} <> tl) == True{} : Bool}

def dec_of_num(xx, tl, zz, ez, hi, de):
  match zz:
    case True{}:
      e48 = Equal.sym(Bool, Laws.is_cp(Chr{xx}, 48), True{}, ez)
      %e48 : {Laws.when(_, Laws.no_more(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_end(tl),
        False{})) == True{} : Bool}
      zr_nm(tl, hi, de)
    case False{}:
      e48 = Equal.sym(Bool, Laws.is_cp(Chr{xx}, 48), False{}, ez)
      %e48 : {Laws.when(_, Laws.no_more(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_end(tl),
        False{})) == True{} : Bool}
      e19 = Equal.sym(Bool, Laws.digit19(Chr{xx}), True{}, when_c(Laws.digit19(Chr{xx}), Laws.digits_rest(tl), hi))
      %e19 : {Laws.when(_, Laws.digits_end(tl), False{}) == True{} : Bool}
      de

# a JSON number that is all digits is a decimal
law num_dec:
  for +cs: List<&2, Char>
  for +hn: {Laws.number(cs) == True{} : Bool}
  for +hd: {Laws.digits_end(cs) == True{} : Bool}
  {Laws.decimal(cs) == True{} : Bool}

def num_dec(cs, hn, hd):
  match cs:
    case Nil{}:
      Empty.absurd({False{} == True{} : Bool}, false_true(hn))
    case Chr{+xx} <> +tl:
      c45 = dig_45(xx, when_c(Laws.digit(Chr{xx}), Laws.digits_end(tl), hd))
      hi = Equal.trans(Bool, Laws.int_end(Chr{xx} <> tl), Laws.number(Chr{xx} <> tl), True{},
        Equal.cong(Bool, Bool, zz => Laws.when(zz, Laws.int_end(tl), Laws.int_end(Chr{xx} <> tl)), False{},
          Laws.is_cp(Chr{xx}, 45), Equal.sym(Bool, Laws.is_cp(Chr{xx}, 45), False{}, c45)), hn)
      dec_of_num(xx, tl, Laws.is_cp(Chr{xx}, 48), {==}, hi, when_y(Laws.digit(Chr{xx}), Laws.digits_end(tl), hd))

# at least b + 1 is at least b
law ge_pred:
  for aa: Nat
  for bb: Nat
  for +h: {Cmp.is_ge(Nat.cmp(aa, 1n+bb)) == True{} : Bool}
  {Cmp.is_ge(Nat.cmp(aa, bb)) == True{} : Bool}

def ge_pred(aa, bb, h):
  match aa bb:
    case 0n 0n:
      {==}
    case 0n 1n+_bp:
      Empty.absurd({False{} == True{} : Bool}, false_true(h))
    case 1n+_ap 0n:
      {==}
    case 1n+ap 1n+bp:
      ge_pred(ap, bp, h)

# a digit 1-9 is a digit
law d19_dig:
  for +xx: U32
  for +h19: {Laws.digit19(Chr{xx}) == True{} : Bool}
  {Laws.digit(Chr{xx}) == True{} : Bool}

def d19_dig(xx, h19):
  Equal.trans(Bool, Bool.and(Cmp.is_ge(U32.cmp(xx, 48)), Cmp.is_le(U32.cmp(xx, 57))),
    Bool.and(True{}, Cmp.is_le(U32.cmp(xx, 57))), True{},
    Equal.cong(Bool, Bool, zz => Bool.and(zz, Cmp.is_le(U32.cmp(xx, 57))), Cmp.is_ge(U32.cmp(xx, 48)), True{},
      Equal.trans(Bool, Cmp.is_ge(U32.cmp(xx, 48)), Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 48n)), True{},
        Equal.cong(Cmp, Bool, zz => Cmp.is_ge(zz), U32.cmp(xx, 48), Nat.cmp(U32.to_nat(xx), 48n), u_cmp(xx, 48)),
        ge_pred(U32.to_nat(xx), 48n, Equal.trans(Bool, Cmp.is_ge(Nat.cmp(U32.to_nat(xx), 49n)), Cmp.is_ge(U32.cmp(xx,
          49)),
          True{},
          Equal.cong(Cmp, Bool, zz => Cmp.is_ge(zz), Nat.cmp(U32.to_nat(xx), 49n), U32.cmp(xx, 49),
            Equal.sym(Cmp, U32.cmp(xx, 49), Nat.cmp(U32.to_nat(xx), 49n), u_cmp(xx, 49))),
          and_left(Cmp.is_ge(U32.cmp(xx, 49)), Cmp.is_le(U32.cmp(xx, 57)), h19))))),
    and_right(Cmp.is_ge(U32.cmp(xx, 49)), Cmp.is_le(U32.cmp(xx, 57)), h19))

# a decimal is all digits, once whether it starts with 0 is known
law dec_digits_at:
  for +xx: U32
  for +tl: List<&2, Char>
  for zz: Bool
  for +ez: {Laws.is_cp(Chr{xx}, 48) == zz : Bool}
  for +h: {Laws.when(zz, Laws.no_more(tl), Laws.when(Laws.digit19(Chr{xx}), Laws.digits_end(tl),
    False{})) == True{} : Bool}
  {Laws.digits_end(Chr{xx} <> tl) == True{} : Bool}

def dec_digits_at(xx, tl, zz, ez, h):
  match zz:
    case True{}:
      e48 = cp_eq(xx, 48, ez)
      %e48 : {Laws.digits_end(Chr{_} <> tl) == True{} : Bool}
      nm_de(tl, h)
    case False{}:
      dg = Equal.sym(Bool, Laws.digit(Chr{xx}), True{}, d19_dig(xx, when_c(Laws.digit19(Chr{xx}), Laws.digits_end(tl),
        h)))
      %dg : {Laws.when(_, Laws.digits_end(tl), False{}) == True{} : Bool}
      when_y(Laws.digit19(Chr{xx}), Laws.digits_end(tl), h)

# a decimal is all digits
law dec_digits:
  for cs: List<&2, Char>
  for +h: {Laws.decimal(cs) == True{} : Bool}
  {Laws.digits_end(cs) == True{} : Bool}

def dec_digits(cs, h):
  match cs:
    case Nil{}:
      Empty.absurd({True{} == True{} : Bool}, false_true(h))
    case Chr{+xx} <> +tl:
      dec_digits_at(xx, tl, Laws.is_cp(Chr{xx}, 48), {==}, h)

# JSON-TREE-6: as_u32 of num

# U32.read of a JSON number, once whether it is all digits is known
law as_u32_digits:
  for +uu: Unit
  for +ss: String
  for +hn: {Laws.number(String.to_list(ss)) == True{} : Bool}
  for de: Bool
  for +ede: {Laws.digits_end(String.to_list(ss)) == de : Bool}
  {Laws.u32_nat(U32.read.go(ss, 0)) == Laws.dec_u32(String.to_list(ss)) : Maybe<&2, Nat>}

def as_u32_digits(uu, ss, hn, de, ede):
  match de:
    case True{}:
      ee = Equal.sym(Bool, Laws.decimal(String.to_list(ss)), True{}, num_dec(String.to_list(ss), hn, ede))
      %ee : {Laws.u32_nat(U32.read.go(ss, 0)) == Laws.nat_if(Bool.and(_, Laws.fits(32n,
        Laws.dec_val(String.to_list(ss), 0n))),
        Laws.dec_val(String.to_list(ss), 0n)) : Maybe<&2, Nat>}
      read_all(uu, ss, 0, ede)
    case False{}:
      ee = Equal.sym(Bool, Laws.decimal(String.to_list(ss)), False{}, bool_false(Laws.decimal(String.to_list(ss)),
        hh => true_false(
        Equal.trans(Bool, True{}, Laws.digits_end(String.to_list(ss)), False{},
          Equal.sym(Bool, Laws.digits_end(String.to_list(ss)), True{}, dec_digits(String.to_list(ss), hh)), ede))))
      %ee : {Laws.u32_nat(U32.read.go(ss, 0)) == Laws.nat_if(Bool.and(_, Laws.fits(32n,
        Laws.dec_val(String.to_list(ss), 0n))),
        Laws.dec_val(String.to_list(ss), 0n)) : Maybe<&2, Nat>}
      Equal.cong(Maybe<&2, U32>, Maybe<&2, Nat>, mm => Laws.u32_nat(mm), U32.read.go(ss, 0), None{},
        read_bad(uu, ss, 0, ede))

# U32.read of a JSON number
law as_u32_read:
  for +uu: Unit
  for txt: String
  for +hn: {Laws.number(String.to_list(txt)) == True{} : Bool}
  {Laws.u32_nat(U32.read(txt)) == Laws.dec_u32(String.to_list(txt)) : Maybe<&2, Nat>}

def as_u32_read(uu, txt, hn):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hh, +tt}:
      as_u32_digits(uu, SCon{hh, tt}, hn, Laws.digits_end(String.to_list(SCon{hh, tt})), {==})

# as_u32 of num, once whether the text is a JSON number is known
law as_u32_top:
  for +uu: Unit
  for +txt: String
  for ok: Bool
  for +eok: {V.num.ok(txt) == ok : Bool}
  {Laws.u32_nat(V.as_u32(V.num.go(txt, ok))) == Laws.dec_u32(String.to_list(txt)) : Maybe<&2, Nat>}

def as_u32_top(uu, txt, ok, eok):
  match ok:
    case True{}:
      as_u32_read(uu, txt, Equal.trans(Bool, Laws.number(String.to_list(txt)), V.num.ok(txt), True{},
        Equal.sym(Bool, V.num.ok(txt), Laws.number(String.to_list(txt)), Laws.num_grammar(txt)), eok))
    case False{}:
      ee = Equal.sym(Bool, Laws.decimal(String.to_list(txt)), False{}, bool_false(Laws.decimal(String.to_list(txt)),
        hh => true_false(Equal.trans(Bool, True{}, Laws.number(String.to_list(txt)), False{},
          Equal.sym(Bool, Laws.number(String.to_list(txt)), True{}, dec_number(String.to_list(txt), hh)),
          Equal.trans(Bool, Laws.number(String.to_list(txt)), V.num.ok(txt), False{},
            Equal.sym(Bool, V.num.ok(txt), Laws.number(String.to_list(txt)), Laws.num_grammar(txt)), eok)))))
      %ee : {Laws.u32_nat(V.as_u32(V.num.go(txt, False{}))) == Laws.nat_if(Bool.and(_,
        Laws.fits(32n, Laws.dec_val(String.to_list(txt), 0n))), Laws.dec_val(String.to_list(txt), 0n)) : Maybe<&2, Nat>}
      {==}

def Laws.as_u32_num(txt):
  as_u32_top(Unit{}, txt, V.num.ok(txt), {==})

def Laws.u32_nat_inj(aa, bb, h):
  ueq(aa, bb, Equal.trans(Bool, Cmp.is_eq(U32.cmp(aa, bb)), Cmp.is_eq(Nat.cmp(U32.to_nat(aa), U32.to_nat(bb))), True{},
    Equal.cong(Cmp, Bool, zz => Cmp.is_eq(zz), U32.cmp(aa, bb), Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)), u_cmp(aa, bb)),
    Equal.trans(Bool, Cmp.is_eq(Nat.cmp(U32.to_nat(aa), U32.to_nat(bb))), Cmp.is_eq(Nat.cmp(U32.to_nat(bb),
      U32.to_nat(bb))), True{},
      Equal.cong(Nat, Bool, zz => Cmp.is_eq(Nat.cmp(zz, U32.to_nat(bb))), U32.to_nat(aa), U32.to_nat(bb), h),
      Equal.cong(Cmp, Bool, zz => Cmp.is_eq(zz), Nat.cmp(U32.to_nat(bb), U32.to_nat(bb)), EQ{},
        nat_cmp_refl(U32.to_nat(bb))))))

# JSON-PULL-1: the cursor on a derivation's text

# a step that already stopped on the suffix in hand returns it
law go_rest:
  for +ff: Nat
  for +txt: String
  for stop: Pull.Stop
  for stack: List<&2, Pull.Frame>
  for goal: Pull.Goal
  for done: Bool
  for bad: Bool
  {Pull.next.go(1n+ff, txt, Pull.S{Pull.MRest{stop}, stack, goal, done, bad})
    == Pull.Fin{(stop, Pull.Cur{txt, stack, done, bad})} : Pull.Out}

def go_rest(_ff, txt, _stop, _stack, _goal, _done, _bad):
  match txt:
    case SNil{}:
      {==}
    case SCon{_, _}:
      {==}

# the cursor steps over whitespace between tokens, keeping its state, from
# one character on, the rest given, whether or not the root is over
law go_wsd.cons:
  for +ff: Nat
  for +uu: U32
  for +tl: String
  for +tail: String
  for +stack: List<&2, Pull.Frame>
  for +goal: Pull.Goal
  for +done: Bool
  for got: ({Laws.is_ws(Chr{uu}) == True{} : Bool} & {Laws.all_ws(tl) == True{} : Bool})
  for ih: {Laws.all_ws(tl) == True{} : Bool}
    -> {Pull.next.go(1n+ff, tl ++ tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}})
      == Pull.next.go(1n+ff, tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}}) : Pull.Out}
  {Pull.next.go(1n+ff, SCon{Chr{uu}, tl ++ tail}, Pull.S{Pull.MIdle{}, stack, goal, done, False{}})
    == Pull.next.go(1n+ff, tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}}) : Pull.Out}

def go_wsd.cons(ff, uu, tl, tail, stack, goal, done, got, ih):
  (e1, e2) = got
  cls = Equal.sym(Lex.Class, Lex.classify(Chr{uu}), Lex.CSpace{}, ws_a(uu, U32.is_eq(uu, 32), {==}, e1))
  %cls : {Pull.next.go(1n+ff, tl ++ tail, Pull.look.plan(Chr{uu}, stack, goal, done, _))
    == Pull.next.go(1n+ff, tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}}) : Pull.Out}
  ih(e2)

# the cursor steps over whitespace between tokens, keeping its state
law go_wsd:
  for +ff: Nat
  for +ws: String
  for +tail: String
  for +stack: List<&2, Pull.Frame>
  for +goal: Pull.Goal
  for +done: Bool
  for h_ws: {Laws.all_ws(ws) == True{} : Bool}
  {Pull.next.go(1n+ff, ws ++ tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}})
    == Pull.next.go(1n+ff, tail, Pull.S{Pull.MIdle{}, stack, goal, done, False{}}) : Pull.Out}

def go_wsd(ff, ws, tail, stack, goal, done, h_ws):
  match ws:
    case SNil{}:
      {==}
    case SCon{Chr{+uu}, +tl}:
      go_wsd.cons(ff, uu, tl, tail, stack, goal, done, and_both(Laws.is_ws(Chr{uu}), Laws.all_ws(tl), h_ws),
        hh => go_wsd(ff, tl, tail, stack, goal, done, hh))

# next steps over whitespace, whether or not the root is over
law next_ws:
  for +ws: String
  for +tail: String
  for +stack: List<&2, Pull.Frame>
  for +done: Bool
  for h_ws: {Laws.all_ws(ws) == True{} : Bool}
  {Ezjson.next(Pull.Cur{ws ++ tail, stack, done, False{}}) == Ezjson.next(Pull.Cur{tail, stack, done, False{}})
    : (Pull.Ev & Pull.Cur)}

def next_ws(ws, tail, stack, done, h_ws):
  Equal.cong(Pull.Out, (Pull.Ev & Pull.Cur), xx => Pull.next.use(Pull.next.fin(Pull.next.grow(32n, 1n, xx))),
    Pull.next.go(4n, ws ++ tail, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, done, False{}}),
    Pull.next.go(4n, tail, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, done, False{}}),
    go_wsd(3n, ws, tail, stack, Pull.GNext{}, done, h_ws))

# next, once the first budget's walk is known to have finished
law next_fin:
  for +txt: String
  for +stack: List<&2, Pull.Frame>
  for +done: Bool
  for got: (Pull.Stop & Pull.Cur)
  for ee: {Pull.next.go(4n, txt, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, done, False{}}) == Pull.Fin{got}
    : Pull.Out}
  {Ezjson.next(Pull.Cur{txt, stack, done, False{}}) == Pull.next.use(got) : (Pull.Ev & Pull.Cur)}

def next_fin(txt, stack, done, got, ee):
  Equal.cong(Pull.Out, (Pull.Ev & Pull.Cur), xx => Pull.next.use(Pull.next.fin(Pull.next.grow(32n, 1n, xx))),
    Pull.next.go(4n, txt, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, done, False{}}), Pull.Fin{got}, ee)

# after the root and whitespace, the text's end is the end
law next_eof:
  for +ws: String
  for +stack: List<&2, Pull.Frame>
  for h_ws: {Laws.all_ws(ws) == True{} : Bool}
  {Ezjson.next(Pull.Cur{ws, stack, True{}, False{}}) == (Pull.EEnd{}, Pull.Cur{"", stack, True{}, False{}})
    : (Pull.Ev & Pull.Cur)}

def next_eof(ws, stack, h_ws):
  ea = append_nil(ws)
  %ea : {Ezjson.next(Pull.Cur{_, stack, True{}, False{}}) == (Pull.EEnd{}, Pull.Cur{"", stack, True{}, False{}})
    : (Pull.Ev & Pull.Cur)}
  next_ws(ws, "", stack, True{}, h_ws)

# appending strings is associative
law sassoc:
  for +aa: String
  for +bb: String
  for +cc: String
  {(aa ++ bb) ++ cc == aa ++ (bb ++ cc) : String}

def sassoc(aa, bb, cc):
  match aa:
    case SNil{}:
      {==}
    case SCon{hd, tl}:
      Equal.cong(String, String, xx => SCon{hd, xx}, (tl ++ bb) ++ cc, tl ++ (bb ++ cc), sassoc(tl, bb, cc))

# an append regrouped, then its right side rewritten
law app3:
  for +aa: String
  for +bb: String
  for +tail: String
  for +mid: String
  for +rhs: String
  for e1: {bb ++ tail == mid : String}
  for e2: {aa ++ mid == rhs : String}
  {(aa ++ bb) ++ tail == rhs : String}

def app3(aa, bb, tail, mid, rhs, e1, e2):
  Equal.trans(String, (aa ++ bb) ++ tail, aa ++ (bb ++ tail), rhs, sassoc(aa, bb, tail),
    Equal.trans(String, aa ++ (bb ++ tail), aa ++ mid, rhs,
      Equal.cong(String, String, xx => aa ++ xx, bb ++ tail, mid, e1), e2))

# pieces spelled in front of a tail
def sp(ps: List<&2, Laws.Piece>, tail: String) -> String:
  match ps:
    case Nil{}:
      tail
    case pc <> tl:
      Laws.piece.text(pc) ++ sp(tl, tail)

# spelled pieces then a tail are sp
law sp_eq:
  for +ps: List<&2, Laws.Piece>
  for +tail: String
  {Laws.spell(ps) ++ tail == sp(ps, tail) : String}

def sp_eq(ps, tail):
  match ps:
    case Nil{}:
      {==}
    case +pc <> +tl:
      app3(Laws.piece.text(pc), Laws.spell(tl), tail, sp(tl, tail), Laws.piece.text(pc) ++ sp(tl, tail),
        sp_eq(tl, tail), {==})

# a derivation's text in front of a tail, grouped to the right
def gt(gg: Laws.Gv, tail: String) -> String:
  match gg:
    case Laws.GWord{w}:
      w ++ tail
    case Laws.GStr{ps}:
      SCon{'"', sp(ps, SCon{'"', tail})}
    case Laws.GArr0{w0}:
      SCon{'[', w0 ++ SCon{']', tail}}
    case Laws.GArr{w0, vv, w1, rr}:
      SCon{'[', w0 ++ gt(vv, w1 ++ gt(rr, SCon{']', tail}))}
    case Laws.GObj0{w0}:
      SCon{'{', w0 ++ SCon{'}', tail}}
    case Laws.GObj{w0, ps, w1, w2, vv, w3, rr}:
      SCon{'{', w0 ++ SCon{'"', sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, w3 ++ gt(rr, SCon{'}', tail}))}})}}
    case Laws.GEnd{}:
      tail
    case Laws.GNext{w2, vv, w1, rr}:
      SCon{',', w2 ++ gt(vv, w1 ++ gt(rr, tail))}
    case Laws.GNextM{w4, ps, w1, w2, vv, w3, rr}:
      SCon{',', w4 ++ SCon{'"', sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, w3 ++ gt(rr, tail))}})}}

# a member's text after its name's opening quote, in front of a tail
law mem_eq:
  for +ps: List<&2, Laws.Piece>
  for +w1: String
  for +w2: String
  for +vv: Laws.Gv
  for +w3: String
  for +rs: String
  for +rt: String
  for +tail: String
  for +ev: {Laws.g.text(vv) ++ (w3 ++ rt) == gt(vv, w3 ++ rt) : String}
  for +er: {rs ++ tail == rt : String}
  {(Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ rs) ++ tail
    == sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, w3 ++ rt)}}) : String}

def mem_eq(ps, w1, w2, vv, w3, rs, rt, tail, ev, er):
  +t3 = w3 ++ rt
  +t2 = w2 ++ gt(vv, t3)
  +t1 = w1 ++ SCon{':', t2}
  app3(Laws.spell(ps), "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ rs, tail, SCon{'"', t1},
    sp(ps, SCon{'"', t1}),
    Equal.cong(String, String, xx => SCon{'"', xx}, (w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ rs) ++ tail,
      t1,
      app3(w1, ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ rs, tail, SCon{':', t2}, t1,
        Equal.cong(String, String, xx => SCon{':', xx}, (w2 ++ Laws.g.text(vv) ++ w3 ++ rs) ++ tail, t2,
          app3(w2, Laws.g.text(vv) ++ w3 ++ rs, tail, gt(vv, t3), t2,
            app3(Laws.g.text(vv), w3 ++ rs, tail, t3, gt(vv, t3),
              app3(w3, rs, tail, rt, t3, er, {==}), ev), {==})), {==})),
    sp_eq(ps, SCon{'"', t1}))

# a derivation's text then a tail is gt
law gt_eq:
  for +gg: Laws.Gv
  for +tail: String
  {Laws.g.text(gg) ++ tail == gt(gg, tail) : String}

def gt_eq(gg, tail):
  match gg:
    case Laws.GWord{_}:
      {==}
    case Laws.GStr{+ps}:
      Equal.cong(String, String, xx => SCon{'"', xx}, (Laws.spell(ps) ++ "\"") ++ tail, sp(ps, SCon{'"', tail}),
        app3(Laws.spell(ps), "\"", tail, SCon{'"', tail}, sp(ps, SCon{'"', tail}), {==}, sp_eq(ps, SCon{'"', tail})))
    case Laws.GArr0{+w0}:
      Equal.cong(String, String, xx => SCon{'[', xx}, (w0 ++ "]") ++ tail, w0 ++ SCon{']', tail},
        app3(w0, "]", tail, SCon{']', tail}, w0 ++ SCon{']', tail}, {==}, {==}))
    case Laws.GArr{+w0, +vv, +w1, +rr}:
      +t1 = w1 ++ gt(rr, SCon{']', tail})
      Equal.cong(String, String, xx => SCon{'[', xx}, (w0 ++ Laws.g.text(vv) ++ w1 ++ Laws.g.text(rr) ++ "]") ++ tail,
        w0 ++ gt(vv, t1),
        app3(w0, Laws.g.text(vv) ++ w1 ++ Laws.g.text(rr) ++ "]", tail, gt(vv, t1), w0 ++ gt(vv, t1),
          app3(Laws.g.text(vv), w1 ++ Laws.g.text(rr) ++ "]", tail, t1, gt(vv, t1),
            app3(w1, Laws.g.text(rr) ++ "]", tail, gt(rr, SCon{']', tail}), t1,
              app3(Laws.g.text(rr), "]", tail, SCon{']', tail}, gt(rr, SCon{']', tail}), {==},
                gt_eq(rr, SCon{']', tail})), {==}),
            gt_eq(vv, t1)), {==}))
    case Laws.GObj0{+w0}:
      Equal.cong(String, String, xx => SCon{'{', xx}, (w0 ++ "}") ++ tail, w0 ++ SCon{'}', tail},
        app3(w0, "}", tail, SCon{'}', tail}, w0 ++ SCon{'}', tail}, {==}, {==}))
    case Laws.GObj{+w0, +ps, +w1, +w2, +vv, +w3, +rr}:
      +t3 = w3 ++ gt(rr, SCon{'}', tail})
      +t1 = "\"" ++ sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, t3)}})
      Equal.cong(String, String, xx => SCon{'{', xx},
        (w0 ++ "\"" ++ Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr) ++ "}")
          ++ tail, w0 ++ t1,
        app3(w0, "\"" ++ Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr) ++ "}",
          tail, t1, w0 ++ t1,
          Equal.cong(String, String, xx => SCon{'"', xx},
            (Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr) ++ "}") ++ tail,
            sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, t3)}}),
            mem_eq(ps, w1, w2, vv, w3, Laws.g.text(rr) ++ "}", gt(rr, SCon{'}', tail}), tail, gt_eq(vv, t3),
              app3(Laws.g.text(rr), "}", tail, SCon{'}', tail}, gt(rr, SCon{'}', tail}), {==},
                gt_eq(rr, SCon{'}', tail})))), {==}))
    case Laws.GEnd{}:
      {==}
    case Laws.GNext{+w2, +vv, +w1, +rr}:
      +t1 = w1 ++ gt(rr, tail)
      Equal.cong(String, String, xx => SCon{',', xx}, (w2 ++ Laws.g.text(vv) ++ w1 ++ Laws.g.text(rr)) ++ tail,
        w2 ++ gt(vv, t1),
        app3(w2, Laws.g.text(vv) ++ w1 ++ Laws.g.text(rr), tail, gt(vv, t1), w2 ++ gt(vv, t1),
          app3(Laws.g.text(vv), w1 ++ Laws.g.text(rr), tail, t1, gt(vv, t1),
            app3(w1, Laws.g.text(rr), tail, gt(rr, tail), t1, gt_eq(rr, tail), {==}),
            gt_eq(vv, t1)), {==}))
    case Laws.GNextM{+w4, +ps, +w1, +w2, +vv, +w3, +rr}:
      +t3 = w3 ++ gt(rr, tail)
      +t1 = "\"" ++ sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, t3)}})
      Equal.cong(String, String, xx => SCon{',', xx},
        (w4 ++ "\"" ++ Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr)) ++ tail,
        w4 ++ t1,
        app3(w4, "\"" ++ Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr),
          tail, t1, w4 ++ t1,
          Equal.cong(String, String, xx => SCon{'"', xx},
            (Laws.spell(ps) ++ "\"" ++ w1 ++ ":" ++ w2 ++ Laws.g.text(vv) ++ w3 ++ Laws.g.text(rr)) ++ tail,
            sp(ps, SCon{'"', w1 ++ SCon{':', w2 ++ gt(vv, t3)}}),
            mem_eq(ps, w1, w2, vv, w3, Laws.g.text(rr), gt(rr, tail), tail, gt_eq(vv, t3), gt_eq(rr, tail))), {==}))

# where the cursor is after a value that landed on `stack`, with `tail` left
def aft.on(tail: String, spot: Pull.Spot) -> Pull.Cur:
  match spot:
    case Pull.Spot{st, root}:
      Pull.Cur{tail, st, root, False{}}
    case Pull.SpotBad{}:
      Pull.Cur{"", [], False{}, True{}}

# where the cursor is after a value in the slot `stack` gives it
def aft(tail: String, stack: List<&2, Pull.Frame>) -> Pull.Cur:
  aft.on(tail, Pull.place.spot(stack))

# appending event lists is associative
law eapp_assoc:
  for +aa: List<&2, Laws.Evt>
  for +bb: List<&2, Laws.Evt>
  for +cc: List<&2, Laws.Evt>
  {List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb), cc)
    == List.append(&2, Laws.Evt, aa, List.append(&2, Laws.Evt, bb, cc)) : List<&2, Laws.Evt>}

def eapp_assoc(aa, bb, cc):
  match aa:
    case Nil{}:
      {==}
    case hd <> tl:
      Equal.cong(List<&2, Laws.Evt>, List<&2, Laws.Evt>, xx => hd <> xx,
        List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, tl, bb), cc),
        List.append(&2, Laws.Evt, tl, List.append(&2, Laws.Evt, bb, cc)), eapp_assoc(tl, bb, cc))

# adding is associative
law add_assoc:
  for +aa: Nat
  for +bb: Nat
  for +cc: Nat
  {Nat.add(Nat.add(aa, bb), cc) == Nat.add(aa, Nat.add(bb, cc)) : Nat}

def add_assoc(aa, bb, cc):
  match aa:
    case 0n:
      {==}
    case 1n+pp:
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(Nat.add(pp, bb), cc), Nat.add(pp, Nat.add(bb, cc)),
        add_assoc(pp, bb, cc))

# adding one is the successor
law add_one:
  for +aa: Nat
  {Nat.add(aa, 1n) == 1n+aa : Nat}

def add_one(aa):
  match aa:
    case 0n:
      {==}
    case 1n+pp:
      Equal.cong(Nat, Nat, xx => 1n+xx, Nat.add(pp, 1n), 1n+pp, add_one(pp))

# the length of appended event lists
law len_app:
  for +aa: List<&2, Laws.Evt>
  for +bb: List<&2, Laws.Evt>
  {List.length(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb))
    == Nat.add(List.length(&2, Laws.Evt, aa), List.length(&2, Laws.Evt, bb)) : Nat}

def len_app(aa, bb):
  match aa:
    case Nil{}:
      {==}
    case _hd <> tl:
      Equal.cong(Nat, Nat, xx => 1n+xx, List.length(&2, Laws.Evt, List.append(&2, Laws.Evt, tl, bb)),
        Nat.add(List.length(&2, Laws.Evt, tl), List.length(&2, Laws.Evt, bb)), len_app(tl, bb))

# the events from `c` start with `es`, after which the cursor is `c2`
def strm(_c: Pull.Cur, _es: List<&2, Laws.Evt>, _c2: Pull.Cur) -> Type:
  @nn: Nat -> {Laws.pulled(Nat.add(List.length(&2, Laws.Evt, _es), nn), _c)
    == List.append(&2, Laws.Evt, _es, Laws.pulled(nn, _c2)) : List<&2, Laws.Evt>}

# one step of next is one event
law strm_one:
  for +c: Pull.Cur
  for +ev: Pull.Ev
  for +c2: Pull.Cur
  for ee: {Ezjson.next(c) == (ev, c2) : (Pull.Ev & Pull.Cur)}
  strm(c, [Laws.view(ev)], c2)

def strm_one(c, ev, c2, ee):
  nn => Equal.cong((Pull.Ev & Pull.Cur), List<&2, Laws.Evt>,
    xx => Laws.view(Laws.ev_of(xx)) <> Laws.pulled(nn, Laws.cur_of(xx)), Ezjson.next(c), (ev, c2), ee)

# strm_app at one count
law strm_app.at:
  for +c: Pull.Cur
  for +aa: List<&2, Laws.Evt>
  for +c1: Pull.Cur
  for +bb: List<&2, Laws.Evt>
  for +c2: Pull.Cur
  for s1: strm(c, aa, c1)
  for s2: strm(c1, bb, c2)
  for +nn: Nat
  {Laws.pulled(Nat.add(List.length(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb)), nn), c)
    == List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb), Laws.pulled(nn, c2)) : List<&2, Laws.Evt>}

def strm_app.at(c, aa, c1, bb, c2, s1, s2, nn):
  +la = List.length(&2, Laws.Evt, aa)
  +lb = List.length(&2, Laws.Evt, bb)
  el = Equal.sym(Nat, List.length(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb)), Nat.add(la, lb),
    len_app(aa, bb))
  %el : {Laws.pulled(Nat.add(_, nn), c) == List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb),
    Laws.pulled(nn, c2)) : List<&2, Laws.Evt>}
  ea = Equal.sym(Nat, Nat.add(Nat.add(la, lb), nn), Nat.add(la, Nat.add(lb, nn)), add_assoc(la, lb, nn))
  %ea : {Laws.pulled(_, c) == List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb),
    Laws.pulled(nn, c2)) : List<&2, Laws.Evt>}
  Equal.trans(List<&2, Laws.Evt>, Laws.pulled(Nat.add(la, Nat.add(lb, nn)), c),
    List.append(&2, Laws.Evt, aa, Laws.pulled(Nat.add(lb, nn), c1)),
    List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb), Laws.pulled(nn, c2)),
    s1(Nat.add(lb, nn)),
    Equal.trans(List<&2, Laws.Evt>, List.append(&2, Laws.Evt, aa, Laws.pulled(Nat.add(lb, nn), c1)),
      List.append(&2, Laws.Evt, aa, List.append(&2, Laws.Evt, bb, Laws.pulled(nn, c2))),
      List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb), Laws.pulled(nn, c2)),
      Equal.cong(List<&2, Laws.Evt>, List<&2, Laws.Evt>, xx => List.append(&2, Laws.Evt, aa, xx),
        Laws.pulled(Nat.add(lb, nn), c1), List.append(&2, Laws.Evt, bb, Laws.pulled(nn, c2)), s2(nn)),
      Equal.sym(List<&2, Laws.Evt>, List.append(&2, Laws.Evt, List.append(&2, Laws.Evt, aa, bb),
        Laws.pulled(nn, c2)), List.append(&2, Laws.Evt, aa, List.append(&2, Laws.Evt, bb, Laws.pulled(nn, c2))),
        eapp_assoc(aa, bb, Laws.pulled(nn, c2)))))

# events one after another
law strm_app:
  for +c: Pull.Cur
  for +aa: List<&2, Laws.Evt>
  for +c1: Pull.Cur
  for +bb: List<&2, Laws.Evt>
  for +c2: Pull.Cur
  for s1: strm(c, aa, c1)
  for s2: strm(c1, bb, c2)
  strm(c, List.append(&2, Laws.Evt, aa, bb), c2)

def strm_app(c, aa, c1, bb, c2, s1, s2):
  nn => strm_app.at(c, aa, c1, bb, c2, s1, s2, nn)

# no events
law strm_nil:
  for c: Pull.Cur
  strm(c, [], c)

def strm_nil(_c):
  _nn => {==}

# an event, then more events
law strm_cons:
  for +c: Pull.Cur
  for +ev: Pull.Ev
  for +c1: Pull.Cur
  for +bb: List<&2, Laws.Evt>
  for +c2: Pull.Cur
  for ee: {Ezjson.next(c) == (ev, c1) : (Pull.Ev & Pull.Cur)}
  for s2: strm(c1, bb, c2)
  strm(c, Laws.view(ev) <> bb, c2)

def strm_cons(c, ev, c1, bb, c2, ee, s2):
  strm_app(c, [Laws.view(ev)], c1, bb, c2, strm_one(c, ev, c1, ee), s2)

# a cursor whose next step is another's gives the same events, when there are some
law strm_same:
  for +c: Pull.Cur
  for +c0: Pull.Cur
  for +e0: Laws.Evt
  for +es: List<&2, Laws.Evt>
  for +c2: Pull.Cur
  for ee: {Ezjson.next(c) == Ezjson.next(c0) : (Pull.Ev & Pull.Cur)}
  for s0: strm(c0, e0 <> es, c2)
  strm(c, e0 <> es, c2)

def strm_same(c, c0, e0, es, c2, ee, s0):
  +nn => Equal.trans(List<&2, Laws.Evt>, Laws.pulled(1n+Nat.add(List.length(&2, Laws.Evt, es), nn), c),
    Laws.pulled(1n+Nat.add(List.length(&2, Laws.Evt, es), nn), c0),
    List.append(&2, Laws.Evt, e0 <> es, Laws.pulled(nn, c2)),
    Equal.cong((Pull.Ev & Pull.Cur), List<&2, Laws.Evt>,
      xx => Laws.view(Laws.ev_of(xx)) <> Laws.pulled(Nat.add(List.length(&2, Laws.Evt, es), nn), Laws.cur_of(xx)),
      Ezjson.next(c), Ezjson.next(c0), ee), s0(nn))

# next from one walk equals next from another, once their first budgets agree
law go_next:
  for +x: String
  for +st: List<&2, Pull.Frame>
  for +dd: Bool
  for +y: String
  for +st2: List<&2, Pull.Frame>
  for +dd2: Bool
  for ee: {Pull.next.go(4n, x, Pull.S{Pull.MIdle{}, st, Pull.GNext{}, dd, False{}})
    == Pull.next.go(4n, y, Pull.S{Pull.MIdle{}, st2, Pull.GNext{}, dd2, False{}}) : Pull.Out}
  {Ezjson.next(Pull.Cur{x, st, dd, False{}}) == Ezjson.next(Pull.Cur{y, st2, dd2, False{}}) : (Pull.Ev & Pull.Cur)}

def go_next(x, st, dd, y, st2, dd2, ee):
  Equal.cong(Pull.Out, (Pull.Ev & Pull.Cur), xx => Pull.next.use(Pull.next.fin(Pull.next.grow(32n, 1n, xx))),
    Pull.next.go(4n, x, Pull.S{Pull.MIdle{}, st, Pull.GNext{}, dd, False{}}),
    Pull.next.go(4n, y, Pull.S{Pull.MIdle{}, st2, Pull.GNext{}, dd2, False{}}), ee)

# `[` where a value may go opens an array
law go_open_arr:
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for hs: {True{} == Pull.expect.val.go(stack) : Bool}
  {Pull.next.go(4n, SCon{'[', x}, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, False{}, False{}})
    == Pull.Fin{(Pull.SEv{Pull.EBeginArr{}}, Pull.Cur{x, Pull.FArr{Pull.SVal{}, True{}} <> stack, False{}, False{}})}
    : Pull.Out}

def go_open_arr(x, stack, hs):
  %hs : {Pull.next.go(4n, x, Pull.punct.arr.if(stack, Pull.GNext{}, _))
    == Pull.Fin{(Pull.SEv{Pull.EBeginArr{}}, Pull.Cur{x, Pull.FArr{Pull.SVal{}, True{}} <> stack, False{}, False{}})}
    : Pull.Out}
  go_rest(3n, x, Pull.SEv{Pull.EBeginArr{}}, Pull.FArr{Pull.SVal{}, True{}} <> stack, Pull.GNext{}, False{}, False{})

law next_oarr:
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for h: {Pull.expect.val.go(stack) == True{} : Bool}
  {Ezjson.next(Pull.Cur{SCon{'[', x}, stack, False{}, False{}})
    == (Pull.EBeginArr{}, Pull.Cur{x, Pull.FArr{Pull.SVal{}, True{}} <> stack, False{}, False{}})
    : (Pull.Ev & Pull.Cur)}

def next_oarr(x, stack, h):
  hs = Equal.sym(Bool, Pull.expect.val.go(stack), True{}, h)
  next_fin(SCon{'[', x}, stack, False{}, (Pull.SEv{Pull.EBeginArr{}}, Pull.Cur{x, Pull.FArr{Pull.SVal{},
    True{}} <> stack,
    False{}, False{}}),
    go_open_arr(x, stack, hs))

# `{` where a value may go opens an object
law go_open_obj:
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for hs: {True{} == Pull.expect.val.go(stack) : Bool}
  {Pull.next.go(4n, SCon{'{', x}, Pull.S{Pull.MIdle{}, stack, Pull.GNext{}, False{}, False{}})
    == Pull.Fin{(Pull.SEv{Pull.EBeginObj{}}, Pull.Cur{x, Pull.FObj{Pull.SKey{}, True{}} <> stack, False{}, False{}})}
    : Pull.Out}

def go_open_obj(x, stack, hs):
  %hs : {Pull.next.go(4n, x, Pull.punct.obj.if(stack, Pull.GNext{}, _))
    == Pull.Fin{(Pull.SEv{Pull.EBeginObj{}}, Pull.Cur{x, Pull.FObj{Pull.SKey{}, True{}} <> stack, False{}, False{}})}
    : Pull.Out}
  go_rest(3n, x, Pull.SEv{Pull.EBeginObj{}}, Pull.FObj{Pull.SKey{}, True{}} <> stack, Pull.GNext{}, False{}, False{})

# `{` where a value may go opens an object
law next_oobj:
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for h: {Pull.expect.val.go(stack) == True{} : Bool}
  {Ezjson.next(Pull.Cur{SCon{'{', x}, stack, False{}, False{}})
    == (Pull.EBeginObj{}, Pull.Cur{x, Pull.FObj{Pull.SKey{}, True{}} <> stack, False{}, False{}})
    : (Pull.Ev & Pull.Cur)}

def next_oobj(x, stack, h):
  hs = Equal.sym(Bool, Pull.expect.val.go(stack), True{}, h)
  next_fin(SCon{'{', x}, stack, False{}, (Pull.SEv{Pull.EBeginObj{}}, Pull.Cur{x, Pull.FObj{Pull.SKey{},
    True{}} <> stack,
    False{}, False{}}),
    go_open_obj(x, stack, hs))

# a container closed in a slot a value may go lands there
law close_ok:
  for +ev: Pull.Ev
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for h: {Pull.expect.val.go(stack) == True{} : Bool}
  {Pull.next.go(4n, x, Pull.close.out(ev, stack, Pull.GNext{})) == Pull.Fin{(Pull.SEv{ev}, aft(x, stack))} : Pull.Out}

def close_ok(ev, x, stack, h):
  match stack:
    case Nil{}:
      go_rest(3n, x, Pull.SEv{ev}, [], Pull.GNext{}, True{}, False{})
    case Pull.FArr{Pull.SVal{}, _} <> +oo:
      go_rest(3n, x, Pull.SEv{ev}, Pull.FArr{Pull.SCom{}, False{}} <> oo, Pull.GNext{}, False{}, False{})
    case Pull.FObj{Pull.SVal{}, _} <> +oo:
      go_rest(3n, x, Pull.SEv{ev}, Pull.FObj{Pull.SCom{}, False{}} <> oo, Pull.GNext{}, False{}, False{})
    case Pull.FArr{Pull.SCom{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FArr{Pull.SCom{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FArr{Pull.SCom{}, fr} <> oo))} : Pull.Out}, h)
    case Pull.FArr{Pull.SKey{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FArr{Pull.SKey{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FArr{Pull.SKey{}, fr} <> oo))} : Pull.Out}, h)
    case Pull.FArr{Pull.SCol{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FArr{Pull.SCol{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FArr{Pull.SCol{}, fr} <> oo))} : Pull.Out}, h)
    case Pull.FObj{Pull.SCom{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FObj{Pull.SCom{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FObj{Pull.SCom{}, fr} <> oo))} : Pull.Out}, h)
    case Pull.FObj{Pull.SKey{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FObj{Pull.SKey{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FObj{Pull.SKey{}, fr} <> oo))} : Pull.Out}, h)
    case Pull.FObj{Pull.SCol{}, fr} <> oo:
      no({Pull.next.go(4n, x, Pull.close.out(ev, Pull.FObj{Pull.SCol{}, fr} <> oo, Pull.GNext{}))
        == Pull.Fin{(Pull.SEv{ev}, aft(x, Pull.FObj{Pull.SCol{}, fr} <> oo))} : Pull.Out}, h)

# `]` after an element closes the array
law next_carr:
  for +x: String
  for +fr: Bool
  for +stack: List<&2, Pull.Frame>
  for h: {Pull.expect.val.go(stack) == True{} : Bool}
  {Ezjson.next(Pull.Cur{SCon{']', x}, Pull.FArr{Pull.SCom{}, fr} <> stack, False{}, False{}})
    == (Pull.EEndArr{}, aft(x, stack)) : (Pull.Ev & Pull.Cur)}

def next_carr(x, fr, stack, h):
  next_fin(SCon{']', x}, Pull.FArr{Pull.SCom{}, fr} <> stack, False{}, (Pull.SEv{Pull.EEndArr{}}, aft(x, stack)),
    close_ok(Pull.EEndArr{}, x, stack, h))

# `]` of an empty array closes it
law next_carr0:
  for +x: String
  for +stack: List<&2, Pull.Frame>
  for h: {Pull.expect.val.go(stack) == True{} : Bool}
  {Ezjson.next(Pull.Cur{SCon{']', x}, Pull.FArr{Pull.SVal{}, True{}} <> stack, False{}, False{}})
    == (Pull.EEndArr{}, aft(x, stack)) : (Pull.Ev & Pull.Cur)}

def next_carr0(x, stack, h):
  next_fin(SCon{']', x}, Pull.FArr{Pull.SVal{}, True{}} <> stack, False{}, (Pull.SEv{Pull.EEndArr{}}, aft(x, stack)),
    close_ok(Pull.EEndArr{}, x, stack, h))

# `}` after a member closes the object
law next_cobj:
  for +x: String
  for +fr: Bool
  for +stack: List<&2, Pull.Frame>
