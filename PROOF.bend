  for +rest: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +hs: {sok(Parse.FObj{items, ky, Parse.SComma{}} <> rest) == True{} : Bool}
  ti(Parse.step.comma(Parse.FObj{items, ky, Parse.SComma{}} <> rest, root, False{}), Lex.TComma{} <> rs(root,
    Parse.FObj{items, ky, Parse.SComma{}} <> rest))

def comma_ti.ocomma(items, ky, rest, root, hs):
  match items:
    case V.JNull{}:
      ({==}, hs)
    case V.JBool{+x1}:
      ({==}, hs)
    case V.JNum{+x1}:
      ({==}, hs)
    case V.JStr{+x1}:
      ({==}, hs)
    case V.JArr{+x1}:
      ({==}, hs)
    case V.JObj{+x1}:
      ({==}, hs)
    case V.JNil{}:
      no(ti(Parse.step.comma(Parse.FObj{V.JNil{}, ky, Parse.SComma{}} <> rest, root, False{}), Lex.TComma{} <> rs(root,
        Parse.FObj{V.JNil{}, ky, Parse.SComma{}} <> rest)), hs)
    case V.JCons{+x1, +x2}:
      ({==}, hs)
    case V.JPair{+x1, +x2, +x3}:
      ({==}, hs)
    case V.JSpan{+x1, +x2}:
      ({==}, hs)
    case V.JBind{+x1, +x2, +x3, +x4}:
      ({==}, hs)

# an opening bracket where a value may go pushes its frame
law oa_ti:
  for ok: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step.open_arr.go(False{}, root, stk, ok), Lex.TOpenArr{} <> rs(root, stk))

def oa_ti(ok, _root, _stk, hs):
  match ok:
    case True{}:
      ({==}, hs)
    case False{}:
      Unit{}

# an opening bracket where a value may go pushes its frame
law oo_ti:
  for ok: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step.open_obj.go(False{}, root, stk, ok), Lex.TOpenObj{} <> rs(root, stk))

def oo_ti(ok, _root, _stk, hs):
  match ok:
    case True{}:
      ({==}, hs)
    case False{}:
      Unit{}

# a closing bracket that ends an open array puts it
law ca_ti:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.close_arr(stk, root, False{}), Lex.TCloseArr{} <> rs(root, stk))

def ca_ti(stk, root, hs):
  match stk:
    case Nil{}:
      Unit{}
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, Parse.SValue{}}:
          ca_ti.avalue(items, rest, root, hs)
        case Parse.FArr{+items, Parse.SComma{}}:
          ca_ti.acomma(items, rest, root, hs)
        case Parse.FArr{+items, Parse.SKey{}}:
          ca_ti.akey(items, rest, root, hs)
        case Parse.FArr{+items, Parse.SColon{}}:
          ca_ti.acolon(items, rest, root, hs)
        case Parse.FObj{+items, +ky, Parse.SValue{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SComma{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SKey{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SColon{}}:
          Unit{}

# a closing bracket that ends an open object puts it
law co_ti:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.close_obj(stk, root, False{}), Lex.TCloseObj{} <> rs(root, stk))

def co_ti(stk, root, hs):
  match stk:
    case Nil{}:
      Unit{}
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, Parse.SValue{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SComma{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SKey{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SColon{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SValue{}}:
          co_ti.ovalue(items, ky, rest, root, hs)
        case Parse.FObj{+items, +ky, Parse.SComma{}}:
          co_ti.ocomma(items, ky, rest, root, hs)
        case Parse.FObj{+items, +ky, Parse.SKey{}}:
          co_ti.okey(items, ky, rest, root, hs)
        case Parse.FObj{+items, +ky, Parse.SColon{}}:
          co_ti.ocolon(items, ky, rest, root, hs)

# a colon after a member's name
law colon_ti:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step.colon(stk, root, False{}), Lex.TColon{} <> rs(root, stk))

def colon_ti(stk, _root, hs):
  match stk:
    case Nil{}:
      Unit{}
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, Parse.SValue{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SComma{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SKey{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SColon{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SValue{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SComma{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SKey{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SColon{}}:
          ({==}, hs)

# a comma after a value
law comma_ti:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step.comma(stk, root, False{}), Lex.TComma{} <> rs(root, stk))

def comma_ti(stk, root, hs):
  match stk:
    case Nil{}:
      Unit{}
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, Parse.SValue{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SComma{}}:
          comma_ti.acomma(items, rest, root, hs)
        case Parse.FArr{+items, Parse.SKey{}}:
          Unit{}
        case Parse.FArr{+items, Parse.SColon{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SValue{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SComma{}}:
          comma_ti.ocomma(items, ky, rest, root, hs)
        case Parse.FObj{+items, +ky, Parse.SKey{}}:
          Unit{}
        case Parse.FObj{+items, +ky, Parse.SColon{}}:
          Unit{}

# a string: a member's name where one goes, else a value
law str_ti:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +txt: String
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.put.str(stk, root, Parse.KOwn{txt}, False{}), Lex.TStr{txt} <> rs(root, stk))

def str_ti(stk, root, txt, hs):
  match stk:
    case Nil{}:
      put_ti([], root, V.JStr{txt}, hs)
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, Parse.SValue{}}:
          put_ti(Parse.FArr{items, Parse.SValue{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FArr{+items, Parse.SComma{}}:
          put_ti(Parse.FArr{items, Parse.SComma{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FArr{+items, Parse.SKey{}}:
          put_ti(Parse.FArr{items, Parse.SKey{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FArr{+items, Parse.SColon{}}:
          put_ti(Parse.FArr{items, Parse.SColon{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FObj{+items, +ky, Parse.SValue{}}:
          put_ti(Parse.FObj{items, ky, Parse.SValue{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FObj{+items, +ky, Parse.SComma{}}:
          put_ti(Parse.FObj{items, ky, Parse.SComma{}} <> rest, root, V.JStr{txt}, hs)
        case Parse.FObj{+items, +ky, Parse.SKey{}}:
          ({==}, hs)
        case Parse.FObj{+items, +ky, Parse.SColon{}}:
          put_ti(Parse.FObj{items, ky, Parse.SColon{}} <> rest, root, V.JStr{txt}, hs)

# a word, once whether it is a literal name or a number is known
law sw_ti:
  for ok: Bool
  for +raw: String
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step.word.go(raw, Parse.P{False{}, root, stk}, ok), Lex.TWord{raw} <> rs(root, stk))

def sw_ti(ok, raw, root, stk, hs):
  match ok:
    case True{}:
      %Equal.cong(List<&2, Lex.Tok>, List<&2, Lex.Tok>, zz => List.reverse.go(&2, Lex.Tok, zz, rs(root, stk)),
        tj_r(Parse.word(raw), V.WVal{}), [Lex.TWord{raw}], tjw.at(String.eq(raw, "null"), String.eq(raw, "true"),
        String.eq(raw, "false"), raw, {==}, {==}, {==})) : ti(Parse.put(stk, root, Parse.word(raw), False{}), _)
      put_ti(stk, root, Parse.word(raw), hs)
    case False{}:
      Unit{}

# one token, spans replaced, on a state that has not failed
law step_ti:
  for tok: Lex.Tok
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for +hs: {sok(stk) == True{} : Bool}
  ti(Parse.step(den(tok), Parse.P{False{}, root, stk}), den(tok) <> rs(root, stk))

def step_ti(tok, root, stk, hs):
  match tok:
    case Lex.TOpenArr{}:
      oa_ti(Parse.step.ready(stk, root), root, stk, hs)
    case Lex.TCloseArr{}:
      ca_ti(stk, root, hs)
    case Lex.TOpenObj{}:
      oo_ti(Parse.step.ready(stk, root), root, stk, hs)
    case Lex.TCloseObj{}:
      co_ti(stk, root, hs)
    case Lex.TColon{}:
      colon_ti(stk, root, hs)
    case Lex.TComma{}:
      comma_ti(stk, root, hs)
    case Lex.TStr{+txt}:
      str_ti(stk, root, txt, hs)
    case Lex.TWord{+raw}:
      sw_ti(Parse.word.ok(raw), raw, root, stk, hs)
    case Lex.TStrS{+src, +nn}:
      str_ti(stk, root, V.span.str(src, nn, U32.is_zero(nn)), hs)
    case Lex.TWordS{+src, +nn}:
      sw_ti(Parse.word.ok(V.span.str(src, nn, U32.is_zero(nn))), V.span.str(src, nn, U32.is_zero(nn)), root, stk, hs)
    case Lex.TBad{}:
      Unit{}

# one token, spans replaced, keeps the invariant
law step_gen:
  for st: Parse.P
  for +tok: Lex.Tok
  for +racc: List<&2, Lex.Tok>
  for h: ti(st, racc)
  ti(Parse.step(den(tok), st), den(tok) <> racc)

def step_gen(st, tok, racc, h):
  match st:
    case Parse.P{bb, +root, +stk}:
      match bb:
        case True{}:
          ti_bad(Parse.step(den(tok), Parse.P{True{}, root, stk}), den(tok) <> racc, step_bad(den(tok),
            Parse.P{True{}, root, stk}, {==}))
        case False{}:
          (ee, hs) = h
          %ee : ti(Parse.step(den(tok), Parse.P{False{}, root, stk}), den(tok) <> _)
          step_ti(tok, root, stk, hs)

# every token, spans replaced, keeps the invariant
law run_ti:
  for xs: List<&2, Lex.Tok>
  for +st: Parse.P
  for +racc: List<&2, Lex.Tok>
  for h: ti(st, racc)
  ti(Parse.run(dens(xs), st), List.reverse.go(&2, Lex.Tok, dens(xs), racc))

def run_ti(xs, st, racc, h):
  match xs:
    case Nil{}:
      h
    case +tok <> +tl:
      run_ti(tl, Parse.step(den(tok), st), den(tok) <> racc, step_gen(st, tok, racc, h))

# a finished parse has read its value's tokens, by its frames and root
law fin_go:
  for stk: List<&2, Parse.Frame>
  for root: Maybe<&2, V.Json>
  for +racc: List<&2, Lex.Tok>
  for +jj: V.Json
  for h: ti(Parse.P{False{}, root, stk}, racc)
  for hf: {Parse.finish(Parse.P{False{}, root, stk}) == Some{jj} : Maybe<&2, V.Json>}
  {List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []) == racc : List<&2, Lex.Tok>}

def fin_go(stk, root, racc, jj, h, hf):
  match stk:
    case Nil{}:
      match root:
        case None{}:
          no({List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []) == racc : List<&2, Lex.Tok>}, Equal.cong(Maybe<&2,
            V.Json>, Bool, zz => Laws.is_some(zz), None{}, Some{jj}, hf))
        case Some{+rr}:
          (ee, _hs) = h
          Equal.trans(List<&2, Lex.Tok>, List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []), List.reverse.go(&2,
            Lex.Tok, tj_r(rr, V.WVal{}), []), racc, Equal.cong(V.Json, List<&2, Lex.Tok>, zz => List.reverse.go(&2,
            Lex.Tok, tj_r(zz, V.WVal{}), []), jj, rr, Equal.sym(V.Json, rr, jj, Equal.cong(Maybe<&2, V.Json>, V.Json,
            zz => unsome(zz), Some{rr}, Some{jj}, hf))), ee)
    case +fr <> +rest:
      no({List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []) == racc : List<&2, Lex.Tok>}, Equal.cong(Maybe<&2,
        V.Json>, Bool, zz => Laws.is_some(zz), Parse.finish(Parse.P{False{}, root, fr <> rest}),
        Some{jj}, hf))

# a finished parse has read its value's tokens
law fin_ti:
  for st: Parse.P
  for +racc: List<&2, Lex.Tok>
  for +jj: V.Json
  for h: ti(st, racc)
  for hf: {Parse.finish(st) == Some{jj} : Maybe<&2, V.Json>}
  {List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []) == racc : List<&2, Lex.Tok>}

def fin_ti(st, racc, jj, h, hf):
  match st:
    case Parse.P{bb, root, stk}:
      match bb:
        case True{}:
          no({List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []) == racc : List<&2, Lex.Tok>}, Equal.cong(Maybe<&2,
            V.Json>, Bool, zz => Laws.is_some(zz), Parse.finish(Parse.P{True{}, root, stk}), Some{jj},
            hf))
        case False{}:
          fin_go(stk, root, racc, jj, h, hf)

# a list reversed twice
law rr_id:
  for +xs: List<&2, Lex.Tok>
  {List.reverse.go(&2, Lex.Tok, List.reverse.go(&2, Lex.Tok, xs, []), []) == xs : List<&2, Lex.Tok>}

def rr_id(xs):
  Equal.trans(List<&2, Lex.Tok>, List.reverse.go(&2, Lex.Tok, List.reverse.go(&2, Lex.Tok, xs, []), []),
    List.append(&2, Lex.Tok, xs, []), xs, rev_rev(xs, [], []), lapp_nil(xs))

# the tokens, spans replaced, of a token list the parser accepts are its
# value's
law parse_toks:
  for +xs: List<&2, Lex.Tok>
  for +jj: V.Json
  for h: {Parse.finish(Parse.run(dens(xs), Parse.P{False{}, None{}, Nil{}})) == Some{jj} : Maybe<&2, V.Json>}
  {tj_r(jj, V.WVal{}) == dens(xs) : List<&2, Lex.Tok>}

def parse_toks(xs, jj, h):
  Equal.trans(List<&2, Lex.Tok>, tj_r(jj, V.WVal{}), List.reverse.go(&2, Lex.Tok, List.reverse.go(&2, Lex.Tok, tj_r(jj,
    V.WVal{}), []), []), dens(xs), Equal.sym(List<&2, Lex.Tok>, List.reverse.go(&2, Lex.Tok, List.reverse.go(&2,
    Lex.Tok, tj_r(jj, V.WVal{}), []), []), tj_r(jj, V.WVal{}), rr_id(tj_r(jj, V.WVal{}))), Equal.trans(List<&2,
    Lex.Tok>, List.reverse.go(&2, Lex.Tok, List.reverse.go(&2, Lex.Tok, tj_r(jj, V.WVal{}), []), []),
    List.reverse.go(&2, Lex.Tok, List.reverse.go(&2, Lex.Tok, dens(xs), []), []), dens(xs), Equal.cong(List<&2,
    Lex.Tok>, List<&2, Lex.Tok>, zz => List.reverse.go(&2, Lex.Tok, zz, []), List.reverse.go(&2, Lex.Tok, tj_r(jj,
    V.WVal{}), []), List.reverse.go(&2, Lex.Tok, dens(xs), []), fin_ti(Parse.run(dens(xs), Parse.P{False{}, None{},
    Nil{}}), List.reverse.go(&2, Lex.Tok, dens(xs), []), jj, run_ti(xs, Parse.P{False{}, None{}, Nil{}}, [], ({==},
    {==})), h)), rr_id(dens(xs))))


# JSON-TEXT-1: a text the character lexer reads without failing is lexemes

# a lexeme: a punctuation character, a word, or a string's pieces
type Lx is Data:
  LP{ch: Char}
  LW{w: String}
  LS{ps: List<&2, Laws.Piece>}

# a lexeme and the whitespace before it, reversed
type It is Data:
  It{rws: List<&2, Char>, lx: Lx}

# a punctuation class's token
def ptok.go(cls: Lex.Class) -> Lex.Tok:
  match cls:
    case Lex.CPunct{tt}:
      tt
    case _:
      Lex.TBad{}

# a punctuation character's token
def ptok(ch: Char) -> Lex.Tok:
  ptok.go(Lex.classify(ch))

# a lexeme's token
def lxtok(lx: Lx) -> Lex.Tok:
  match lx:
    case LP{ch}:
      ptok(ch)
    case LW{w}:
      Lex.TWord{w}
    case LS{ps}:
      Lex.TStr{Laws.spelled(ps)}

# lexemes' tokens, in the order the lexemes are listed
def rtoks(its: List<&2, It>) -> List<&2, Lex.Tok>:
  match its:
    case Nil{}:
      []
    case It{_, lx} <> rest:
      lxtok(lx) <> rtoks(rest)

# a lexeme's characters, reversed onto acc
def rlx(lx: Lx, acc: List<&2, Char>) -> List<&2, Char>:
  match lx:
    case LP{ch}:
      ch <> acc
    case LW{w}:
      List.reverse.go(&2, Char, String.to_list(w), acc)
    case LS{ps}:
      '"' <> List.reverse.go(&2, Char, String.to_list(Laws.spell(ps)), '"' <> acc)

# lexemes listed last first, and the whitespace before each, as the
# characters they spell, reversed
def ritems(its: List<&2, It>) -> List<&2, Char>:
  match its:
    case Nil{}:
      []
    case It{rws, lx} <> rest:
      rlx(lx, List.append(&2, Char, rws, ritems(rest)))

# every character is whitespace
def allws(cs: List<&2, Char>) -> Bool:
  match cs:
    case Nil{}:
      True{}
    case ch <> tl:
      Bool.and(Laws.is_ws(ch), allws(tl))

# a lexeme is well spelled: a string's pieces are
def lxok(lx: Lx) -> Bool:
  match lx:
    case LS{ps}:
      Laws.spell_ok(ps)
    case _:
      True{}

# every lexeme is well spelled and follows whitespace
def itsok(its: List<&2, It>) -> Bool:
  match its:
    case Nil{}:
      True{}
    case It{rws, lx} <> rest:
      Bool.and(allws(rws), Bool.and(lxok(lx), itsok(rest)))

# pieces listed last first, spelled and reversed onto acc
def rsp(ps: List<&2, Laws.Piece>, acc: List<&2, Char>) -> List<&2, Char>:
  match ps:
    case Nil{}:
      acc
    case pc <> rest:
      List.reverse.go(&2, Char, String.to_list(Laws.piece.text(pc)), rsp(rest, acc))

# the characters pieces listed last first stand for, last first
def pchars(ps: List<&2, Laws.Piece>) -> List<&2, Char>:
  match ps:
    case Nil{}:
      []
    case pc <> rest:
      Laws.piece.char(pc) <> pchars(rest)

# both are true
law and2:
  for aa: Bool
  for bb: Bool
  for ha: {aa == True{} : Bool}
  for hb: {bb == True{} : Bool}
  {Bool.and(aa, bb) == True{} : Bool}

def and2(aa, bb, ha, hb):
  match aa:
    case True{}:
      hb
    case False{}:
      no({Bool.and(False{}, bb) == True{} : Bool}, ha)

# a character by its code
law chr_of:
  for ch: Char
  for +kk: U32
  for ee: {Char.to_u32(ch) == kk : U32}
  {ch == Chr{kk} : Char}

def chr_of(ch, kk, ee):
  match ch:
    case Chr{uu}:
      Equal.cong(U32, Char, zz => Chr{zz}, uu, kk, ee)

# a string's characters reversed onto acc go through an append
law srev_app:
  for +aa: String
  for +bb: String
  for +acc: List<&2, Char>
  {List.reverse.go(&2, Char, String.to_list(aa ++ bb), acc) == List.reverse.go(&2, Char, String.to_list(bb),
    List.reverse.go(&2, Char, String.to_list(aa), acc)) : List<&2, Char>}

def srev_app(aa, bb, acc):
  match aa:
    case SNil{}:
      {==}
    case SCon{+ch, +tl}:
      srev_app(tl, bb, ch <> acc)

# a buffer read back as text, reversed onto acc, is the buffer on acc
law text_rc:
  for +buf: List<&2, Char>
  for +txt: String
  for +acc: List<&2, Char>
  {List.reverse.go(&2, Char, String.to_list(Lex.text.go(buf, txt)), acc) == List.reverse.go(&2, Char,
    String.to_list(txt), List.append(&2, Char, buf, acc)) : List<&2, Char>}

def text_rc(buf, txt, acc):
  match buf:
    case Nil{}:
      {==}
    case +ch <> +tl:
      text_rc(tl, SCon{ch, txt}, acc)

# a string's characters read back from pieces listed last first
law text_pc:
  for +ps: List<&2, Laws.Piece>
  for +qs: List<&2, Laws.Piece>
  {Lex.text.go(pchars(ps), Laws.spelled(qs)) == Laws.spelled(List.reverse.go(&2, Laws.Piece, ps, qs)) : String}

def text_pc(ps, qs):
  match ps:
    case Nil{}:
      {==}
    case +pc <> +tl:
      text_pc(tl, pc <> qs)

# pieces listed last first, put back in order, spelled and reversed
law spell_rev:
  for +ps: List<&2, Laws.Piece>
  for +qs: List<&2, Laws.Piece>
  for +acc: List<&2, Char>
  {List.reverse.go(&2, Char, String.to_list(Laws.spell(List.reverse.go(&2, Laws.Piece, ps, qs))),
    acc) == List.reverse.go(&2, Char, String.to_list(Laws.spell(qs)), rsp(ps, acc)) : List<&2, Char>}

def spell_rev(ps, qs, acc):
  match ps:
    case Nil{}:
      {==}
    case +pc <> +tl:
      Equal.trans(List<&2, Char>, List.reverse.go(&2, Char, String.to_list(Laws.spell(List.reverse.go(&2, Laws.Piece,
        tl, pc <> qs))), acc), List.reverse.go(&2, Char, String.to_list(Laws.spell(pc <> qs)), rsp(tl, acc)),
        List.reverse.go(&2, Char, String.to_list(Laws.spell(qs)), List.reverse.go(&2, Char,
        String.to_list(Laws.piece.text(pc)), rsp(tl, acc))), spell_rev(tl, pc <> qs, acc),
        srev_app(Laws.piece.text(pc), Laws.spell(qs), rsp(tl, acc)))

# well spelled pieces stay well spelled put back in order
law spell_ok_rev:
  for +ps: List<&2, Laws.Piece>
  for +qs: List<&2, Laws.Piece>
  for +hp: {Laws.spell_ok(ps) == True{} : Bool}
  for hq: {Laws.spell_ok(qs) == True{} : Bool}
  {Laws.spell_ok(List.reverse.go(&2, Laws.Piece, ps, qs)) == True{} : Bool}

def spell_ok_rev(ps, qs, hp, hq):
  match ps:
    case Nil{}:
      hq
    case +pc <> +tl:
      spell_ok_rev(tl, pc <> qs, and_right(Laws.piece.ok(pc), Laws.spell_ok(tl), hp),
        and2(Laws.piece.ok(pc), Laws.spell_ok(qs), and_left(Laws.piece.ok(pc), Laws.spell_ok(tl), hp), hq))


# whether a class is whitespace's
def is_space(cls: Lex.Class) -> Bool:
  match cls:
    case Lex.CSpace{}:
      True{}
    case _:
      False{}

# whether a class is neither a quotation mark's nor a reverse solidus'
def notqb(cls: Lex.Class) -> Bool:
  match cls:
    case Lex.CQuote{}:
      False{}
    case Lex.CBack{}:
      False{}
    case _:
      True{}

# no class but whitespace's past classify's last test
law cls_space_end:
  for +cp: U32
  for h_c: {Lex.COther{} == Lex.CSpace{} : Lex.Class}
  {Laws.is_ws(Chr{cp}) == True{} : Bool}

def cls_space_end(cp, h_c):
  no({Laws.is_ws(Chr{cp}) == True{} : Bool}, Equal.cong(Lex.Class, Bool, xx => is_space(xx), Lex.COther{},
    Lex.CSpace{}, h_c))

# classify's test for 9, once its answer is named, read back as whitespace
law cls_space_11:
  for +cp: U32
  for bb: Bool
  for eb: {U32.is_eq(cp, 9) == bb : Bool}
  for h_c: {Bool.pick(Lex.Class, bb, Lex.CSpace{}, Lex.COther{}) == Lex.CSpace{} : Lex.Class}
  {Laws.is_ws(Chr{cp}) == True{} : Bool}

def cls_space_11(cp, bb, eb, h_c):
  match bb:
    case True{}:
      ek = Equal.sym(U32, cp, 9, ueq(cp, 9, eb))
      %ek : {Laws.is_ws(Chr{_}) == True{} : Bool}
      {==}
    case False{}:
      cls_space_end(cp, h_c)

