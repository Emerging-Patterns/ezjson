      match sh:
        case V.WVal{}:
          Equal.cong(List<&2, Lex.Tok>, List<&2, Lex.Tok>, yy => Lex.TOpenArr{} <> yy, dens(List.append(&2, Lex.Tok,
            tj_r(items, V.WArr{}), [Lex.TCloseArr{}])), List.append(&2, Lex.Tok, tj_r(items, V.WArr{}),
              [Lex.TCloseArr{}]),
