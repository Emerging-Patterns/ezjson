      cls_by(Chr{uu}, xx => Laws.word_char(Chr{xx}), h, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==}, {==},
        {==}, {==})

# word characters are word characters to the lexer
law oth_words:
  for +cs: List<&2, Char>
  for +h: {Laws.word_chars(cs) == True{} : Bool}
  others(cs)

