# the whole budget covers a text the length of a U32
law ar_u:
  for +xx: String
  for +uu32: U32
  for +uu: Unit
  for hh: {Laws.bounded(xx, uu32) == True{} : Bool}
  (&gg: Nat -> {cplu(0n, 32n, uu) == 1n+fu(xx, gg) : Nat})

def ar_u(xx, uu32, uu, hh):
  ar_w(xx, uu32, uu, sbnd(xx, uu32, hh))

# JSON-PULL-4: the law

# skip on a live cursor over a short text, once the whole budget is known to
# cover it
law pk_w:
  for +xx: String
  for +st: List<&2, Pull.Frame>
  for +mm: Nat
  for +uu: Unit
  for ss: (&gg: Nat -> {cplu(0n, 32n, uu) == 1n+fu(xx, gg) : Nat})
  for +hv: {Laws.val_len(Laws.pulled(mm, Pull.Cur{xx, st, False{}, False{}}), 0n) == Some{mm} : Maybe<&2, Nat>}
  {Ezjson.skip(Pull.Cur{xx, st, False{}, False{}}) == Laws.nexts(mm, Pull.Cur{xx, st, False{}, False{}}) : Pull.Cur}

def pk_w(xx, st, mm, uu, ss, hv):
  (+gg, ec) = ss
  Equal.trans(Pull.Cur, Ezjson.skip(Pull.Cur{xx, st, False{}, False{}}),
    Pull.skip.use(Pull.next.fin(Pull.next.go(cplu(0n, 32n, uu), xx, Pull.S{Pull.MIdle{}, st, Pull.GSkip{0n}, False{},
    False{}}))), Laws.nexts(mm, Pull.Cur{xx, st, False{}, False{}}), skip_ob(xx, st, uu),
    Equal.trans(Pull.Cur, Pull.skip.use(Pull.next.fin(Pull.next.go(cplu(0n, 32n, uu), xx, Pull.S{Pull.MIdle{}, st,
      Pull.GSkip{0n}, False{}, False{}}))), Pull.skip.use(Pull.next.fin(Pull.next.go(1n+fu(xx, gg), xx,
      Pull.S{Pull.MIdle{}, st, Pull.GSkip{0n}, False{}, False{}}))), Laws.nexts(mm, Pull.Cur{xx, st, False{}, False{}}),
      Equal.cong(Nat, Pull.Cur, zz => Pull.skip.use(Pull.next.fin(Pull.next.go(zz, xx, Pull.S{Pull.MIdle{}, st,
        Pull.GSkip{0n}, False{}, False{}}))), cplu(0n, 32n, uu), 1n+fu(xx, gg), ec),
      Equal.cong(Pull.Out, Pull.Cur, zz => Pull.skip.use(Pull.next.fin(zz)), Pull.next.go(1n+fu(xx, gg), xx,
        Pull.S{Pull.MIdle{}, st, Pull.GSkip{0n}, False{}, False{}}), Pull.Fin{(Pull.SSkip{}, Laws.nexts(mm, Pull.Cur{xx,
        st, False{}, False{}}))}, ko_go(mm, xx, st, 0n, gg, uu, hv))))

# skip drops one whole value, the budget named through uu
law pull_skip_u:
  for +cur: Pull.Cur
  for +mm: Nat
  for +uu: Unit
  for +h_s: {Laws.short(Laws.rest_of(cur)) == True{} : Bool}
  for +h_v: {Laws.val_len(Laws.pulled(mm, cur), 0n) == Some{mm} : Maybe<&2, Nat>}
  {Ezjson.skip(cur) == Laws.nexts(mm, cur) : Pull.Cur}

def pull_skip_u(cur, mm, uu, h_s, h_v):
  match cur mm:
    case Pull.Cur{+xx, +st, +dn, True{}} 0n:
      ms_no({Ezjson.skip(Pull.Cur{xx, st, dn, True{}}) == Pull.Cur{xx, st, dn, True{}} : Pull.Cur}, 0n, h_v)
    case Pull.Cur{+xx, +st, +dn, True{}} 1n+pp:
      ms_no({Ezjson.skip(Pull.Cur{xx, st, dn, True{}}) == Laws.nexts(1n+pp, Pull.Cur{xx, st, dn, True{}}) : Pull.Cur},
        1n+pp, h_v)
    case Pull.Cur{+xx, +st, True{}, False{}} 0n:
      ms_no({Ezjson.skip(Pull.Cur{xx, st, True{}, False{}}) == Pull.Cur{xx, st, True{}, False{}} : Pull.Cur}, 0n, h_v)
    case Pull.Cur{+xx, +st, True{}, False{}} 1n+pp:
      ms_no({Ezjson.skip(Pull.Cur{xx, st, True{}, False{}}) == Laws.nexts(1n+pp, Pull.Cur{xx, st, True{}, False{}})
        : Pull.Cur}, 1n+pp, Equal.trans(Maybe<&2, Nat>, None{}, Laws.val_len(Laws.pulled(1n+pp, Pull.Cur{xx, st, True{},
        False{}}), 0n), Some{1n+pp}, Equal.sym(Maybe<&2, Nat>, Laws.val_len(Laws.pulled(1n+pp, Pull.Cur{xx, st, True{},
        False{}}), 0n), None{}, dt_len(xx, st, Laws.pulled(pp, Laws.cur_of(Ezjson.next(Pull.Cur{xx, st, True{},
        False{}}))), 0n, uu)), h_v))
    case Pull.Cur{+xx, +st, False{}, False{}} +m2:
      pk_w(xx, st, m2, uu, ar_u(xx, 4294967295, uu, h_s), h_v)

def Laws.pull_skip(cur, mm, h_s, h_v):
  pull_skip_u(cur, mm, Unit{}, h_s, h_v)

def Laws.pull_skip_next(cur, mm, h_s, h_v):
  Equal.cong(Pull.Cur, Pull.Ev, zz => Laws.ev_of(Ezjson.next(zz)), Ezjson.skip(cur), Laws.nexts(mm, cur),
    pull_skip_u(cur, mm, Unit{}, h_s, h_v))


# JSON-PRINT-4: pretty's text is a derivation of RFC 8259's value rule, so
# text_some reads it back. First the pieces print writes, one character at a
# time.

# the piece for a control below U+0020, or the character itself
def pq.rest(+uu: U32, bc: Bool) -> Laws.Piece:
  match bc:
    case True{}:
      Laws.PU{'0', '0', Print.escape.nib(U32.div(uu, 16)), Print.escape.nib(U32.mod(uu, 16))}
    case False{}:
      Laws.PRaw{Chr{uu}}

# the piece print writes for a scalar value, one test of escape.plain at a
# time
def pq.pl(
  +uu: U32,
  b34: Bool,
  b92: Bool,
  b8: Bool,
  b12: Bool,
  b10: Bool,
  b13: Bool,
  b9: Bool,
  bc: Bool
) -> Laws.Piece:
  match b34:
    case True{}:
      Laws.PEsc{'"'}
    case False{}:
      match b92:
        case True{}:
          Laws.PEsc{'\\'}
        case False{}:
          match b8:
            case True{}:
              Laws.PEsc{'b'}
            case False{}:
              match b12:
                case True{}:
                  Laws.PEsc{'f'}
                case False{}:
                  match b10:
                    case True{}:
                      Laws.PEsc{'n'}
                    case False{}:
                      match b13:
                        case True{}:
                          Laws.PEsc{'r'}
                        case False{}:
                          match b9:
                            case True{}:
                              Laws.PEsc{'t'}
                            case False{}:
                              pq.rest(uu, bc)

# the piece print writes for a code point: U+FFFD for one that is not a
# scalar value
def pq.sc(+uu: U32, ns: Bool) -> Laws.Piece:
  match ns:
    case True{}:
      Laws.PRaw{Char.from_u32(65533)}
    case False{}:
      pq.pl(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 8), U32.is_eq(uu, 12), U32.is_eq(uu, 10),
        U32.is_eq(uu, 13), U32.is_eq(uu, 9), U32.is_lt(uu, 32))

# the piece print writes for a character
def pq.pc(ch: Char) -> Laws.Piece:
  match ch:
    case Chr{+uu}:
      pq.sc(uu, Laws.non_scalar(uu))

# the pieces print writes for a string
def pq.pcs(txt: String) -> List<&2, Laws.Piece>:
  match txt:
    case SNil{}:
      []
    case SCon{hd, tl}:
      pq.pc(hd) <> pq.pcs(tl)

# pq.pl is written as escape.plain writes, test for test
law pq.pl_text:
  for +uu: U32
  for b34: Bool
  for b92: Bool
  for b8: Bool
  for b12: Bool
  for b10: Bool
  for b13: Bool
  for b9: Bool
  for bc: Bool
  {Laws.piece.text(pq.pl(uu, b34, b92, b8, b12, b10, b13, b9, bc)) == Bool.pick(String, b34, "\\\"",
    Bool.pick(String, b92, "\\\\", Bool.pick(String, b8, "\\b", Bool.pick(String, b12, "\\f",
    Bool.pick(String, b10, "\\n", Bool.pick(String, b13, "\\r", Bool.pick(String, b9, "\\t",
    Print.escape.rest.go(uu, Chr{uu}, bc)))))))) : String}

def pq.pl_text(_uu, b34, b92, b8, b12, b10, b13, b9, bc):
  match b34:
    case True{}:
      {==}
    case False{}:
      match b92:
        case True{}:
          {==}
        case False{}:
          match b8:
            case True{}:
              {==}
            case False{}:
              match b12:
                case True{}:
                  {==}
                case False{}:
                  match b10:
                    case True{}:
                      {==}
                    case False{}:
                      match b13:
                        case True{}:
                          {==}
                        case False{}:
                          match b9:
                            case True{}:
                              {==}
                            case False{}:
                              match bc:
                                case True{}:
                                  {==}
                                case False{}:
                                  {==}

# pq.sc is written as escape.scalar writes
law pq.sc_text:
  for +uu: U32
  for ns: Bool
  {Laws.piece.text(pq.sc(uu, ns)) == Print.escape.scalar(uu, Chr{uu}, Bool.not(ns)) : String}

def pq.sc_text(uu, ns):
  match ns:
    case True{}:
      {==}
    case False{}:
      pq.pl_text(uu, U32.is_eq(uu, 34), U32.is_eq(uu, 92), U32.is_eq(uu, 8), U32.is_eq(uu, 12), U32.is_eq(uu, 10),
        U32.is_eq(uu, 13), U32.is_eq(uu, 9), U32.is_lt(uu, 32))

# a character's piece is written as print writes the character
law pq.pc_text:
  for +ch: Char
  {Laws.piece.text(pq.pc(ch)) == Print.escape.char(ch) : String}

def pq.pc_text(ch):
  match ch:
    case Chr{+uu}:
      pq.sc_text(uu, Laws.non_scalar(uu))

# a string's pieces are written as print escapes the string
law pq.pcs_text:
  for +txt: String
  {Laws.spell(pq.pcs(txt)) == Print.escape(String.to_list(txt)) : String}

def pq.pcs_text(txt):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      Equal.trans(String, Laws.piece.text(pq.pc(hd)) ++ Laws.spell(pq.pcs(tl)),
        Print.escape.char(hd) ++ Laws.spell(pq.pcs(tl)), Print.escape.char(hd) ++ Print.escape(String.to_list(tl)),
        Equal.cong(String, String, zz => zz ++ Laws.spell(pq.pcs(tl)), Laws.piece.text(pq.pc(hd)),
          Print.escape.char(hd), pq.pc_text(hd)),
        Equal.cong(String, String, zz => Print.escape.char(hd) ++ zz, Laws.spell(pq.pcs(tl)),
          Print.escape(String.to_list(tl)), pq.pcs_text(tl)))


# a control's \u00XX piece stands for the control
def pq.ctl_char.goal(uu: U32) -> Type:
  {Laws.piece.char(Laws.PU{'0', '0', Print.escape.nib(U32.div(uu, 16)), Print.escape.nib(U32.mod(uu,
    16))}) == Chr{uu} : Char}

# pq.ctl_char, one control at a time
law pq.ctl_char.five:
  for b0: Bool
  for b1: Bool
  for b2: Bool
  for b3: Bool
  for b4: Bool
  {Laws.piece.char(Laws.PU{'0', '0', Print.escape.nib(U32.div(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4,
    WCon{False{}, zw(26n)}}}}}}}, 16)), Print.escape.nib(U32.mod(U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4,
    WCon{False{}, zw(26n)}}}}}}}, 16))}) == Chr{U32{WCon{b0, WCon{b1, WCon{b2, WCon{b3, WCon{b4, WCon{False{},
    zw(26n)}}}}}}}} : Char}

def pq.ctl_char.five(b0, b1, b2, b3, b4):
  match b0 b1 b2 b3 b4:
    case False{} False{} False{} False{} False{}:
