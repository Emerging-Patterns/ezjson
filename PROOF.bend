            tail}))}})}, fr, stack, h_w, hw4), next_str_k(xps, xw1 ++ SCon{':', xw2 ++ gt(xvv, xw3 ++ gt(xrr, SCon{'}',
            tail}))}, False{}, stack, hps, s2)),
