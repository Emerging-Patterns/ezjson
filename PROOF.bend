  for +db: Nat
  for +ch: Char
  rel_q(sc.in(da, Lex.CPunct{Lex.TComma{}}), sc.out(lb, db, Lex.CPunct{Lex.TComma{}}, ch))

def cl_q_io.s.c6(lb, _da, _db, _ch):
  match lb:
