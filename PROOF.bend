  Equal.cong(Parse.P, Maybe<&2, V.Json>, zz => Parse.finish(zz), Parse.run(tj_r(val, V.WVal{}), Parse.P{False{}, None{},
    Nil{}}),
    Parse.P{False{}, Some{canon_r(val, V.WVal{})}, Nil{}}, pv_r(val, V.WVal{}, h_wf, False{}, None{}, Nil{},
      V.JNil{})({==}))

