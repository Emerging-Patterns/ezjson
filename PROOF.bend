  for +da: Nat
  for +db: Nat
  for +ch: Char
  rel_q(sc.in(da, Lex.CQuote{}), sc.out(lb, db, Lex.CQuote{}, ch))

def cl_q_io.s.c7(lb, _da, _db, _ch):
