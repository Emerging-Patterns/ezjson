    V.wf.go(fxv(val, V.WVal{}), V.WVal{}), V.wf.go(val, V.WVal{}), True{}, wf_fx(val, V.WVal{}), h_wf), False{},
    None{}, Nil{}, V.JNil{})({==}), Equal.cong(V.Json, Parse.P, zz => Parse.P{False{}, Some{zz}, Nil{}},
    canon_r(fxv(val, V.WVal{}), V.WVal{}), canon(val, V.WVal{}), Equal.sym(V.Json, canon(val, V.WVal{}),
    canon_r(fxv(val, V.WVal{}), V.WVal{}), canon_fx(val, V.WVal{})))))

# the parser reads a well-formed value's tokens as its canonical form
law parse_tj:
  for +val: V.Json
  for h_wf: {V.wf(val) == True{} : Bool}
  {Parse.finish(Parse.run(tj(val, V.WVal{}), Parse.P{False{}, None{}, Nil{}})) == Some{canon(val,
    V.WVal{})} : Maybe<&2, V.Json>}

def parse_tj(val, h_wf):
  Equal.cong(Parse.P, Maybe<&2, V.Json>, zz => Parse.finish(zz), Parse.run(tj(val, V.WVal{}), Parse.P{False{}, None{},
    Nil{}}), Parse.P{False{}, Some{canon(val, V.WVal{})}, Nil{}},
    pv_top(val, h_wf))

# JSON-PRINT-3, the parse half: parse's state only ever holds well-formed values

# a finished root is well-formed
def minv(root: Maybe<&2, V.Json>) -> Type:
  match root:
    case None{}:
      Unit
    case Some{jj}:
      {V.wf(jj) == True{} : Bool}

# an open frame's cells are well-formed
def frinv(fr: Parse.Frame) -> Type:
  match fr:
    case Parse.FArr{items, _}:
      {V.wf.go(items, V.WArr{}) == True{} : Bool}
    case Parse.FObj{pairs, _, _}:
      {V.wf.go(pairs, V.WObj{}) == True{} : Bool}

# every open frame's cells are well-formed
def finv(stk: List<&2, Parse.Frame>) -> Type:
  match stk:
    case Nil{}:
      Unit
    case fr <> rest:
      (frinv(fr) & finv(rest))

# the parser's state holds only well-formed values
def pinv(st: Parse.P) -> Type:
  match st:
    case Parse.P{_bad, root, stk}:
      (minv(root) & finv(stk))

# a well-formed value in front of well-formed cells
law cons_wf:
  for +vv: V.Json
  for +items: V.Json
  for hv: {V.wf(vv) == True{} : Bool}
  for hi: {V.wf.go(items, V.WArr{}) == True{} : Bool}
  {V.wf.go(V.JCons{vv, items}, V.WArr{}) == True{} : Bool}

def cons_wf(vv, items, hv, hi):
  hs = Equal.sym(Bool, V.wf(vv), True{}, hv)
  %hs : {Lazy.stop(Bool, Bool.not(_), False{}, _u => V.wf.go(items, V.WArr{})) == True{} : Bool}
  hi

# a well-formed value under a key, in front of well-formed cells
law pair_wf:
  for key: Parse.Key
  for +vv: V.Json
  for +pairs: V.Json
  for hv: {V.wf(vv) == True{} : Bool}
  for hp: {V.wf.go(pairs, V.WObj{}) == True{} : Bool}
  {V.wf.go(Parse.put.pair(key, vv, pairs), V.WObj{}) == True{} : Bool}

def pair_wf(key, vv, pairs, hv, hp):
  match key:
    case Parse.KOwn{_txt}:
      hs = Equal.sym(Bool, V.wf(vv), True{}, hv)
      %hs : {Lazy.stop(Bool, Bool.not(_), False{}, _u => V.wf.go(pairs, V.WObj{})) == True{} : Bool}
      hp
    case Parse.KCut{_src, _nn}:
      hs = Equal.sym(Bool, V.wf(vv), True{}, hv)
      %hs : {Lazy.stop(Bool, Bool.not(_), False{}, _u => V.wf.go(pairs, V.WObj{})) == True{} : Bool}
      hp

# a string key's text is well-formed
law text_wf:
  for key: Parse.Key
  {V.wf(Parse.put.text(key)) == True{} : Bool}

def text_wf(key):
  match key:
    case Parse.KOwn{_txt}:
      {==}
    case Parse.KCut{_src, _nn}:
      {==}

# well-formed array cells reversed onto well-formed cells
law rev_wf_arr:
  for +cells: V.Json
  for +acc: V.Json
  for +hc: {V.wf.go(cells, V.WArr{}) == True{} : Bool}
  for ha: {V.wf.go(acc, V.WArr{}) == True{} : Bool}
  {V.wf.go(V.reverse(cells, acc), V.WArr{}) == True{} : Bool}

def rev_wf_arr(cells, acc, hc, ha):
  match cells:
    case V.JNull{}:
      no({V.wf.go(V.reverse(V.JNull{}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JBool{+x1}:
      no({V.wf.go(V.reverse(V.JBool{x1}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JNum{+x1}:
      no({V.wf.go(V.reverse(V.JNum{x1}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JStr{+x1}:
      no({V.wf.go(V.reverse(V.JStr{x1}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JArr{+x1}:
      no({V.wf.go(V.reverse(V.JArr{x1}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JObj{+x1}:
      no({V.wf.go(V.reverse(V.JObj{x1}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JNil{}:
      ha
    case V.JCons{+x1, +x2}:
      rev_wf_arr(x2, V.JCons{x1, acc}, stop_r(V.wf(x1), V.wf.go(x2, V.WArr{}), hc),
        cons_wf(x1, acc, stop_l(V.wf(x1), V.wf.go(x2, V.WArr{}), hc), ha))
    case V.JPair{+x1, +x2, +x3}:
      no({V.wf.go(V.reverse(V.JPair{x1, x2, x3}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JSpan{+x1, +x2}:
      no({V.wf.go(V.reverse(V.JSpan{x1, x2}, acc), V.WArr{}) == True{} : Bool}, hc)
    case V.JBind{+x1, +x2, +x3, +x4}:
      no({V.wf.go(V.reverse(V.JBind{x1, x2, x3, x4}, acc), V.WArr{}) == True{} : Bool}, hc)

# well-formed object cells reversed onto well-formed cells
law rev_wf_obj:
  for +cells: V.Json
  for +acc: V.Json
  for +hc: {V.wf.go(cells, V.WObj{}) == True{} : Bool}
  for ha: {V.wf.go(acc, V.WObj{}) == True{} : Bool}
  {V.wf.go(V.reverse(cells, acc), V.WObj{}) == True{} : Bool}

def rev_wf_obj(cells, acc, hc, ha):
  match cells:
    case V.JNull{}:
      no({V.wf.go(V.reverse(V.JNull{}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JBool{+x1}:
      no({V.wf.go(V.reverse(V.JBool{x1}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JNum{+x1}:
      no({V.wf.go(V.reverse(V.JNum{x1}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JStr{+x1}:
      no({V.wf.go(V.reverse(V.JStr{x1}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JArr{+x1}:
      no({V.wf.go(V.reverse(V.JArr{x1}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JObj{+x1}:
      no({V.wf.go(V.reverse(V.JObj{x1}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JNil{}:
      ha
    case V.JCons{+x1, +x2}:
      no({V.wf.go(V.reverse(V.JCons{x1, x2}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JPair{+x1, +x2, +x3}:
      rev_wf_obj(x3, V.JPair{x1, x2, acc}, stop_r(V.wf(x2), V.wf.go(x3, V.WObj{}), hc),
        pair_wf(Parse.KOwn{x1}, x2, acc, stop_l(V.wf(x2), V.wf.go(x3, V.WObj{}), hc), ha))
    case V.JSpan{+x1, +x2}:
      no({V.wf.go(V.reverse(V.JSpan{x1, x2}, acc), V.WObj{}) == True{} : Bool}, hc)
    case V.JBind{+x1, +x2, +x3, +x4}:
      rev_wf_obj(x4, V.JBind{x1, x2, x3, acc}, stop_r(V.wf(x3), V.wf.go(x4, V.WObj{}), hc),
        pair_wf(Parse.KCut{x1, x2}, x3, acc, stop_l(V.wf(x3), V.wf.go(x4, V.WObj{}), hc), ha))

# put keeps the state well-formed, given a well-formed value
law put_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +vv: V.Json
  for +bad: Bool
  for hv: {V.wf(vv) == True{} : Bool}
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.put(stk, root, vv, bad))

def put_inv(stk, root, vv, _bad, hv, h):
  match stk:
    case Nil{}:
      match root:
        case None{}:
          (hv, Unit{})
        case Some{_rr}:
          (hr, _hs) = h
          (hr, Unit{})
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, (hf, hrest)) = h
              (hr, (cons_wf(vv, items, hv, hf), hrest))
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})
        case Parse.FObj{+pairs, +key, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, (hf, hrest)) = h
              (hr, (pair_wf(key, vv, pairs, hv, hf), hrest))
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})
# a colon keeps the state well-formed
law colon_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.colon(stk, root, bad))

def colon_inv(stk, _root, _bad, h):
  match stk:
    case Nil{}:
      (hr, _rest) = h
      (hr, Unit{})
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})
        case Parse.FObj{+pairs, +key, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              h

# a comma keeps the state well-formed
law comma_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.comma(stk, root, bad))

def comma_inv(stk, _root, _bad, h):
  match stk:
    case Nil{}:
      (hr, _rest) = h
      (hr, Unit{})
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              h
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})
        case Parse.FObj{+pairs, +key, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              h
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})

# a string keeps the state well-formed
law str_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +key: Parse.Key
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.put.str(stk, root, key, bad))

def str_inv(stk, root, key, bad, h):
  match stk:
    case Nil{}:
      put_inv([], root, Parse.put.text(key), bad, text_wf(key), h)
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, slot}:
          match slot:
            case Parse.SValue{}:
              put_inv(Parse.FArr{items, Parse.SValue{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
            case Parse.SComma{}:
              put_inv(Parse.FArr{items, Parse.SComma{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
            case Parse.SKey{}:
              put_inv(Parse.FArr{items, Parse.SKey{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
            case Parse.SColon{}:
              put_inv(Parse.FArr{items, Parse.SColon{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
        case Parse.FObj{+pairs, +k2, slot}:
          match slot:
            case Parse.SValue{}:
              put_inv(Parse.FObj{pairs, k2, Parse.SValue{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
            case Parse.SComma{}:
              put_inv(Parse.FObj{pairs, k2, Parse.SComma{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)
            case Parse.SKey{}:
              h
            case Parse.SColon{}:
              put_inv(Parse.FObj{pairs, k2, Parse.SColon{}} <> rest, root, Parse.put.text(key), bad, text_wf(key), h)

# close_arr_inv, for one frame
law ca_arr:
  for slot: Parse.Slot
  for items: V.Json
  for +rest: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, Parse.FArr{items, slot} <> rest})
  pinv(Parse.close_arr(Parse.FArr{items, slot} <> rest, root, bad))

def ca_arr(slot, items, rest, root, bad, h):
  match slot:
    case Parse.SValue{}:
      match items:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, (_hf, hrest)) = h
          put_inv(rest, root, V.JArr{V.JNil{}}, bad, {==}, (hr, hrest))
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})
    case Parse.SComma{}:
      (hr, (hf, hrest)) = h
      +it = items
      ec = Equal.sym(Parse.P, Parse.close_arr(Parse.FArr{it, Parse.SComma{}} <> rest, root, bad),
        Parse.put(rest, root, V.JArr{V.reverse(it, V.JNil{})}, bad), close_arr_comma(it, rest, root, bad))
      %ec : pinv(_)
      put_inv(rest, root, V.JArr{V.reverse(it, V.JNil{})}, bad, rev_wf_arr(it, V.JNil{}, hf, {==}), (hr, hrest))
    case Parse.SKey{}:
      match items:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})
    case Parse.SColon{}:
      match items:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})

# a closing bracket keeps the state well-formed
law close_arr_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.close_arr(stk, root, bad))

def close_arr_inv(stk, root, bad, h):
  match stk:
    case Nil{}:
      (hr, _rest) = h
      (hr, Unit{})
    case fr <> +rest:
      match fr:
        case Parse.FArr{items, slot}:
          ca_arr(slot, items, rest, root, bad, h)
        case Parse.FObj{+pairs, +key, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})

# close_obj_inv, for one frame
law co_obj:
  for slot: Parse.Slot
  for pairs: V.Json
  for +key: Parse.Key
  for +rest: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, Parse.FObj{pairs, key, slot} <> rest})
  pinv(Parse.close_obj(Parse.FObj{pairs, key, slot} <> rest, root, bad))

def co_obj(slot, pairs, key, rest, root, bad, h):
  match slot:
    case Parse.SValue{}:
      match pairs:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})
    case Parse.SComma{}:
      (hr, (hf, hrest)) = h
      +ps = pairs
      ec = Equal.sym(Parse.P, Parse.close_obj(Parse.FObj{ps, key, Parse.SComma{}} <> rest, root, bad),
        Parse.put(rest, root, V.JObj{V.reverse(ps, V.JNil{})}, bad), close_obj_comma(ps, key, rest, root, bad))
      %ec : pinv(_)
      put_inv(rest, root, V.JObj{V.reverse(ps, V.JNil{})}, bad, rev_wf_obj(ps, V.JNil{}, hf, {==}), (hr, hrest))
    case Parse.SKey{}:
      match pairs:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, (_hf, hrest)) = h
          put_inv(rest, root, V.JObj{V.JNil{}}, bad, {==}, (hr, hrest))
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})
    case Parse.SColon{}:
      match pairs:
        case V.JNull{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBool{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNum{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JStr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JArr{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JObj{+x1}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JNil{}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JCons{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JPair{+x1, +x2, +x3}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JSpan{+x1, +x2}:
          (hr, _rest) = h
          (hr, Unit{})
        case V.JBind{+x1, +x2, +x3, +x4}:
          (hr, _rest) = h
          (hr, Unit{})

# a closing brace keeps the state well-formed
law close_obj_inv:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.close_obj(stk, root, bad))

def close_obj_inv(stk, root, bad, h):
  match stk:
    case Nil{}:
      (hr, _rest) = h
      (hr, Unit{})
    case fr <> +rest:
      match fr:
        case Parse.FArr{+items, slot}:
          match slot:
            case Parse.SValue{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SComma{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SKey{}:
              (hr, _rest) = h
              (hr, Unit{})
            case Parse.SColon{}:
              (hr, _rest) = h
              (hr, Unit{})
        case Parse.FObj{pairs, +key, slot}:
          co_obj(slot, pairs, key, rest, root, bad, h)

# opening an array keeps the state well-formed
law oa_inv:
  for ok: Bool
  for +bad: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.open_arr.go(bad, root, stk, ok))

def oa_inv(ok, _bad, _root, _stk, h):
  match ok:
    case True{}:
      (hr, hs) = h
      (hr, ({==}, hs))
    case False{}:
      (hr, _hs) = h
      (hr, Unit{})

# opening an object keeps the state well-formed
law oo_inv:
  for ok: Bool
  for +bad: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.open_obj.go(bad, root, stk, ok))

def oo_inv(ok, _bad, _root, _stk, h):
  match ok:
    case True{}:
      (hr, hs) = h
      (hr, ({==}, hs))
    case False{}:
      (hr, _hs) = h
      (hr, Unit{})

# a word parse accepts is a well-formed value
law word_wf:
  for b1: Bool
  for b2: Bool
  for b3: Bool
  for +raw: String
  for eo: {Bool.or(b1, Bool.or(b2, Bool.or(b3, V.num.ok(raw)))) == True{} : Bool}
  {V.wf(Bool.pick(V.Json, b1, V.JNull{}, Bool.pick(V.Json, b2, V.JBool{True{}}, Bool.pick(V.Json, b3,
    V.JBool{False{}}, V.JNum{raw})))) == True{} : Bool}

def word_wf(b1, b2, b3, _raw, eo):
  match b1:
    case True{}:
      {==}
    case False{}:
      match b2:
        case True{}:
          {==}
        case False{}:
          match b3:
            case True{}:
              {==}
            case False{}:
              eo

# a word keeps the state well-formed
law sw_inv:
  for ok: Bool
  for +raw: String
  for +bad: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for eo: {Parse.word.ok(raw) == ok : Bool}
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.word.go(raw, Parse.P{bad, root, stk}, ok))

def sw_inv(ok, raw, bad, root, stk, eo, h):
  match ok:
    case True{}:
      put_inv(stk, root, Parse.word(raw), bad, word_wf(String.eq(raw, "null"), String.eq(raw, "true"),
        String.eq(raw, "false"), raw, eo), h)
    case False{}:
      h

# a number span keeps the state well-formed
law sk_inv:
  for ok: Bool
  for +raw: String
  for +bad: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for eo: {V.num.ok(raw) == ok : Bool}
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.span.open(Parse.P{bad, root, stk}, Parse.step.span.ok(raw, ok)))

def sk_inv(ok, raw, bad, root, stk, eo, h):
  match ok:
    case True{}:
      put_inv(stk, root, V.JNum{raw}, bad, eo, h)
    case False{}:
      h

# a word span keeps the state well-formed
law sg_inv:
  for aa: Bool
  for bb: Bool
  for cc: Bool
  for +src: String
  for +nn: U32
  for +bad: Bool
  for +root: Maybe<&2, V.Json>
  for +stk: List<&2, Parse.Frame>
  for h: pinv(Parse.P{bad, root, stk})
  pinv(Parse.step.span.open(Parse.P{bad, root, stk}, Parse.step.span.go(src, nn, aa, bb, cc)))

def sg_inv(aa, bb, cc, src, nn, bad, root, stk, h):
  match aa:
    case True{}:
      put_inv(stk, root, V.JNull{}, bad, {==}, h)
    case False{}:
      match bb:
        case True{}:
          put_inv(stk, root, V.JBool{True{}}, bad, {==}, h)
        case False{}:
          match cc:
            case True{}:
              put_inv(stk, root, V.JBool{False{}}, bad, {==}, h)
            case False{}:
              +raw = V.span.str(src, nn, U32.is_zero(nn))
              sk_inv(V.num.ok(raw), raw, bad, root, stk, {==}, h)

# one token keeps the state well-formed
law step_inv:
  for tok: Lex.Tok
  for st: Parse.P
  for h: pinv(st)
  pinv(Parse.step(tok, st))

def step_inv(tok, st, h):
  match tok:
    case Lex.TOpenArr{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          oa_inv(Parse.step.ready(stk, root), bad, root, stk, h)
    case Lex.TOpenObj{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          oo_inv(Parse.step.ready(stk, root), bad, root, stk, h)
    case Lex.TCloseArr{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          close_arr_inv(stk, root, bad, h)
    case Lex.TCloseObj{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          close_obj_inv(stk, root, bad, h)
    case Lex.TColon{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          colon_inv(stk, root, bad, h)
    case Lex.TComma{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          comma_inv(stk, root, bad, h)
    case Lex.TStr{+txt}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          str_inv(stk, root, Parse.KOwn{txt}, bad, h)
    case Lex.TWord{+raw}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          sw_inv(Parse.word.ok(raw), raw, bad, root, stk, {==}, h)
    case Lex.TStrS{+src, +nn}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          str_inv(stk, root, Parse.KCut{src, nn}, bad, h)
    case Lex.TWordS{+src, +nn}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          sg_inv(V.span.eq(src, nn, "null"), V.span.eq(src, nn, "true"), V.span.eq(src, nn, "false"), src, nn, bad,
            root, stk, h)
    case Lex.TBad{}:
      match st:
        case Parse.P{+bad, +root, +stk}:
          h

# every token keeps the state well-formed
law run_inv:
  for xs: List<&2, Lex.Tok>
  for +st: Parse.P
  for h: pinv(st)
  pinv(Parse.run(xs, st))

def run_inv(xs, st, h):
  match xs:
    case Nil{}:
      h
    case +tok <> rest:
      run_inv(rest, Parse.step(tok, st), step_inv(tok, st, h))

# a finished parse of a well-formed state is well-formed
law fin_wf:
  for bad: Bool
  for stk: List<&2, Parse.Frame>
  for root: Maybe<&2, V.Json>
  for h: (minv(root) & finv(stk))
  {Laws.wf_m(Parse.result(bad, stk, root)) == True{} : Bool}

def fin_wf(bad, stk, root, h):
  match bad:
    case True{}:
      {==}
    case False{}:
      match stk:
        case +_fr <> +_rest:
          {==}
        case Nil{}:
          match root:
            case None{}:
              {==}
            case Some{_jj}:
              (hr, _hs) = h
              hr

# a finished parse is well-formed
law fin_inv:
  for st: Parse.P
  for h: pinv(st)
  {Laws.wf_m(Parse.finish(st)) == True{} : Bool}

def fin_inv(st, h):
  match st:
    case Parse.P{bad, root, stk}:
      fin_wf(bad, stk, root, h)

def Laws.parse_wf(txt):
  fin_inv(Parse.run(Lex.tokens(txt), Parse.P{False{}, None{}, Nil{}}),
    run_inv(Lex.tokens(txt), Parse.P{False{}, None{}, Nil{}}, (Unit{}, Unit{})))


# WP-H: parse on spans against parse on what they cover

# a span comparison that has missed stays missed
law span_miss:
  for +src: String
  for +zero: Bool
  for +key: String
  for +nn: U32
  {V.span.eq.go(src, False{}, zero, key, nn) == False{} : Bool}

def span_miss(src, _zero, _key, _nn):
  match src:
    case SNil{}:
      {==}
    case SCon{_a, _as}:
      {==}

# span_eq_go, one character on, with its comparison named
law span_eq_at:
  for cc: Cmp
  for +xx: U32
  for +yy: U32
  for +as: String
  for +bs: String
  for +nn: U32
  for ih: {V.span.eq.go(as, True{}, U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1)) ==
    String.eq(V.span.str(as, U32.sub(nn, 1), U32.is_zero(U32.sub(nn, 1))), bs) : Bool}
  {V.span.eq.go(as, Cmp.is_eq(cc), U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1)) ==
    String.eq.fin(String.cmp.fin(V.span.str(as, U32.sub(nn, 1), U32.is_zero(U32.sub(nn, 1))), bs,
      ((Chr{xx}, Chr{yy}), cc))) : Bool}

def span_eq_at(cc, xx, yy, as, bs, nn, ih):
  match cc:
    case LT{}:
      span_miss(as, U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1))
    case GT{}:
      span_miss(as, U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1))
    case EQ{}:
      +sp = V.span.str(as, U32.sub(nn, 1), U32.is_zero(U32.sub(nn, 1)))
      Equal.trans(Bool, V.span.eq.go(as, True{}, U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1)), String.eq(sp, bs),
        String.eq.fin(String.cmp.rec(Chr{xx}, Chr{yy}, String.cmp(sp, bs))), ih,
        Equal.sym(Bool, String.eq.fin(String.cmp.rec(Chr{xx}, Chr{yy}, String.cmp(sp, bs))), String.eq(sp, bs),
          cmp_rec_eq(Chr{xx}, Chr{yy}, String.cmp(sp, bs))))

# comparing a span with a key is comparing what the span covers with it
law span_eq_go:
  for +src: String
  for +zero: Bool
  for +key: String
  for +nn: U32
  {V.span.eq.go(src, True{}, zero, key, nn) == String.eq(V.span.str(src, nn, zero), key) : Bool}

def span_eq_go(src, zero, key, nn):
  match src:
    case SNil{}:
      match zero:
        case True{}:
          match key:
            case SNil{}:
              {==}
            case SCon{_b, _bs}:
              {==}
        case False{}:
          match key:
            case SNil{}:
              {==}
            case SCon{_b, _bs}:
              {==}
    case SCon{Chr{+xx}, +as}:
      match zero:
        case True{}:
          match key:
            case SNil{}:
              {==}
            case SCon{_b, _bs}:
              {==}
        case False{}:
          match key:
            case SNil{}:
              {==}
            case SCon{Chr{+yy}, +bs}:
              span_eq_at(U32.cmp(xx, yy), xx, yy, as, bs, nn,
                span_eq_go(as, U32.is_zero(U32.sub(nn, 1)), bs, U32.sub(nn, 1)))

# fix_eq, with the scalar test named
law fix_eq.go:
  for bb: Bool
  for +uu: U32
  {Bool.pick(Char, Bool.not(bb), Chr{uu}, Chr{65533}) == Bool.pick(Char, bb, Char.from_u32(65533), Chr{uu}) : Char}

def fix_eq.go(bb, _uu):
  match bb:
    case True{}:
      {==}
    case False{}:
      {==}

# print's fix and the spec's are the same
law fix_eq:
  for +ch: Char
  {fix(ch) == Laws.fix_char(ch) : Char}

def fix_eq(ch):
  match ch:
    case Chr{+uu}:
      fix_eq.go(Laws.non_scalar(uu), uu)

# print's fixs and the spec's fix_str are the same
law fixs_eq:
  for +txt: String
  {fixs(String.to_list(txt)) == Laws.fix_str(txt) : String}

def fixs_eq(txt):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      Equal.trans(String, SCon{fix(hd), fixs(String.to_list(tl))}, SCon{Laws.fix_char(hd), fixs(String.to_list(tl))},
        SCon{Laws.fix_char(hd), Laws.fix_str(tl)},
        Equal.cong(Char, String, zz => SCon{zz, fixs(String.to_list(tl))}, fix(hd), Laws.fix_char(hd), fix_eq(hd)),
        Equal.cong(String, String, zz => SCon{Laws.fix_char(hd), zz}, fixs(String.to_list(tl)), Laws.fix_str(tl),
          fixs_eq(tl)))

# a key with its span read out
def ownk(key: Parse.Key) -> Parse.Key:
  match key:
    case Parse.KOwn{txt}:
      Parse.KOwn{txt}
    case Parse.KCut{src, +nn}:
      Parse.KOwn{V.span.str(src, nn, U32.is_zero(nn))}

# an open frame with its spans read out
def ownf(fr: Parse.Frame) -> Parse.Frame:
  match fr:
    case Parse.FArr{items, slot}:
      Parse.FArr{Laws.own(items), slot}
    case Parse.FObj{pairs, key, slot}:
      Parse.FObj{Laws.own(pairs), ownk(key), slot}

# the open frames with their spans read out
def owns(stk: List<&2, Parse.Frame>) -> List<&2, Parse.Frame>:
  match stk:
    case Nil{}:
      Nil{}
    case fr <> rest:
      ownf(fr) <> owns(rest)

# the parser's state with its spans read out
def ownp(st: Parse.P) -> Parse.P:
  match st:
    case Parse.P{bad, root, stk}:
      Parse.P{bad, Laws.own_m(root), owns(stk)}

# whether a value may go next does not look at spans
law ready_own:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  {Parse.step.ready(owns(stk), Laws.own_m(root)) == Parse.step.ready(stk, root) : Bool}

def ready_own(stk, root):
  match stk:
    case Nil{}:
      match root:
        case None{}:
          {==}
        case Some{_jj}:
          {==}
    case fr <> _rest:
      match fr:
        case Parse.FArr{_items, slot}:
          match slot:
            case Parse.SValue{}:
              {==}
            case Parse.SComma{}:
              {==}
            case Parse.SKey{}:
              {==}
            case Parse.SColon{}:
              {==}
        case Parse.FObj{_pairs, _key, slot}:
          match slot:
            case Parse.SValue{}:
              {==}
            case Parse.SComma{}:
              {==}
            case Parse.SKey{}:
              {==}
            case Parse.SColon{}:
              {==}

# a pair put under a key, owned
law pair_own:
  for key: Parse.Key
  for +vv: V.Json
  for +pairs: V.Json
  {Laws.own(Parse.put.pair(key, vv, pairs)) == Parse.put.pair(ownk(key), Laws.own(vv), Laws.own(pairs)) : V.Json}

def pair_own(key, _vv, _pairs):
  match key:
    case Parse.KOwn{_txt}:
      {==}
    case Parse.KCut{_src, _nn}:
      {==}

# a string key's value, owned
law text_own:
  for key: Parse.Key
  {Laws.own(Parse.put.text(key)) == Parse.put.text(ownk(key)) : V.Json}

def text_own(key):
  match key:
    case Parse.KOwn{_txt}:
      {==}
    case Parse.KCut{_src, _nn}:
      {==}

# put, owned, is put of the owned value on the owned state
law put_own:
  for +stk: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +vv: V.Json
  for +bad: Bool
  {ownp(Parse.put(stk, root, vv, bad)) == Parse.put(owns(stk), Laws.own_m(root), Laws.own(vv), bad) : Parse.P}

def put_own(stk, root, vv, bad):
  match stk:
    case Nil{}:
      match root:
        case None{}:
          {==}
        case Some{_rr}:
          {==}
    case fr <> +rest:
      match fr:
        case Parse.FArr{_items, slot}:
          match slot:
            case Parse.SValue{}:
              {==}
            case Parse.SComma{}:
              {==}
            case Parse.SKey{}:
              {==}
            case Parse.SColon{}:
              {==}
        case Parse.FObj{+pairs, +key, slot}:
          match slot:
            case Parse.SValue{}:
              Equal.cong(V.Json, Parse.P, zz => Parse.P{bad, Laws.own_m(root), Parse.FObj{zz, Parse.KOwn{""},
                Parse.SComma{}} <> owns(rest)},
                Laws.own(Parse.put.pair(key, vv, pairs)), Parse.put.pair(ownk(key), Laws.own(vv), Laws.own(pairs)),
                pair_own(key, vv, pairs))
            case Parse.SComma{}:
              {==}
            case Parse.SKey{}:
              {==}
            case Parse.SColon{}:
              {==}

# reversing cells, owned
law own_rev:
  for +cells: V.Json
  for +acc: V.Json
  {Laws.own(V.reverse(cells, acc)) == V.reverse(Laws.own(cells), Laws.own(acc)) : V.Json}

def own_rev(cells, acc):
  match cells:
    case V.JNull{}:
      {==}
    case V.JBool{+x1}:
      {==}
    case V.JNum{+x1}:
      {==}
    case V.JStr{+x1}:
      {==}
    case V.JArr{+x1}:
      {==}
    case V.JObj{+x1}:
      {==}
    case V.JNil{}:
      {==}
    case V.JCons{+x1, +x2}:
      own_rev(x2, V.JCons{x1, acc})
    case V.JPair{+x1, +x2, +x3}:
      own_rev(x3, V.JPair{x1, x2, acc})
    case V.JSpan{+x1, +x2}:
      {==}
    case V.JBind{+x1, +x2, +x3, +x4}:
      own_rev(x4, V.JBind{x1, x2, x3, acc})

# a closing bracket on an array frame, owned
law ca_own:
  for slot: Parse.Slot
  for items: V.Json
  for +rest: List<&2, Parse.Frame>
  for +root: Maybe<&2, V.Json>
  for +bad: Bool
  {ownp(Parse.close_arr(Parse.FArr{items, slot} <> rest, root, bad)) ==
    Parse.close_arr(owns(Parse.FArr{items, slot} <> rest), Laws.own_m(root), bad) : Parse.P}

def ca_own(slot, items, rest, root, bad):
  match slot:
    case Parse.SValue{}:
      match items:
        case V.JNull{}:
          {==}
        case V.JBool{+x1}:
          {==}
        case V.JNum{+x1}:
          {==}
        case V.JStr{+x1}:
          {==}
        case V.JArr{+x1}:
          {==}
        case V.JObj{+x1}:
          {==}
        case V.JNil{}:
          put_own(rest, root, V.JArr{V.JNil{}}, bad)
        case V.JCons{+x1, +x2}:
          {==}
        case V.JPair{+x1, +x2, +x3}:
          {==}
        case V.JSpan{+x1, +x2}:
          {==}
        case V.JBind{+x1, +x2, +x3, +x4}:
          {==}
    case Parse.SComma{}:
      +it = items
      Equal.trans(Parse.P, ownp(Parse.close_arr(Parse.FArr{it, Parse.SComma{}} <> rest, root, bad)),
        ownp(Parse.put(rest, root, V.JArr{V.reverse(it, V.JNil{})}, bad)), Parse.close_arr(Parse.FArr{Laws.own(it),
        Parse.SComma{}} <> owns(rest), Laws.own_m(root), bad), Equal.cong(Parse.P, Parse.P, zz => ownp(zz),
        Parse.close_arr(Parse.FArr{it, Parse.SComma{}} <> rest, root, bad), Parse.put(rest, root, V.JArr{V.reverse(it,
        V.JNil{})}, bad),
        close_arr_comma(it, rest, root, bad)),
        Equal.trans(Parse.P, ownp(Parse.put(rest, root, V.JArr{V.reverse(it, V.JNil{})}, bad)), Parse.put(owns(rest),
          Laws.own_m(root), V.JArr{Laws.own(V.reverse(it, V.JNil{}))}, bad), Parse.close_arr(Parse.FArr{Laws.own(it),
          Parse.SComma{}} <> owns(rest), Laws.own_m(root), bad), put_own(rest, root, V.JArr{V.reverse(it, V.JNil{})},
          bad),
        Equal.trans(Parse.P, Parse.put(owns(rest), Laws.own_m(root), V.JArr{Laws.own(V.reverse(it, V.JNil{}))}, bad),
          Parse.put(owns(rest), Laws.own_m(root), V.JArr{V.reverse(Laws.own(it), V.JNil{})}, bad),
          Parse.close_arr(Parse.FArr{Laws.own(it), Parse.SComma{}} <> owns(rest), Laws.own_m(root), bad),
          Equal.cong(V.Json, Parse.P, zz => Parse.put(owns(rest), Laws.own_m(root), V.JArr{zz}, bad),
          Laws.own(V.reverse(it, V.JNil{})),
        V.reverse(Laws.own(it), V.JNil{}), own_rev(it, V.JNil{})),
        Equal.sym(Parse.P, Parse.close_arr(Parse.FArr{Laws.own(it), Parse.SComma{}} <> owns(rest), Laws.own_m(root),
          bad), Parse.put(owns(rest), Laws.own_m(root), V.JArr{V.reverse(Laws.own(it), V.JNil{})}, bad),
