  for +ww: Bool
  for +ch: Char
  cpt(sc.out(lt, dd, Lex.CPunct{Lex.TCloseArr{}}, ch), gps(Laws.GpOut{ww}, Lex.CPunct{Lex.TCloseArr{}}))

