# JSON-PRINT-2, the second half: printing does not see spans or the fix

# esc_fix, with the scalar test named
law esc_fix.go:
  for bb: Bool
  for +uu: U32
  for eb: {Laws.non_scalar(uu) == bb : Bool}
  {Print.escape.char(Bool.pick(Char, bb, Char.from_u32(65533), Chr{uu})) == Print.escape.char(Chr{uu}) : String}

def esc_fix.go(bb, uu, eb):
  match bb:
    case True{}:
      es = Equal.sym(Bool, Laws.non_scalar(uu), True{}, eb)
      %es : {Print.escape.char(Char.from_u32(65533)) == Print.escape.scalar(uu, Chr{uu}, Bool.not(_)) : String}
      {==}
    case False{}:
      {==}

# a character and its fix print the same
law esc_fix:
  for +ch: Char
  {Print.escape.char(Laws.fix_char(ch)) == Print.escape.char(ch) : String}

def esc_fix(ch):
  match ch:
    case Chr{+uu}:
      esc_fix.go(Laws.non_scalar(uu), uu, {==})

# a string and its fix print the same
law quote_fix:
  for +txt: String
  {Print.escape(String.to_list(Laws.fix_str(txt))) == Print.escape(String.to_list(txt)) : String}

def quote_fix(txt):
  match txt:
    case SNil{}:
      {==}
    case SCon{+hd, +tl}:
      e1 = esc_fix(hd)
      e2 = quote_fix(tl)
      %e1 : {Print.escape.char(Laws.fix_char(hd)) ++ Print.escape(String.to_list(Laws.fix_str(tl))) ==
        _ ++ Print.escape(String.to_list(tl)) : String}
      %e2 : {Print.escape.char(Laws.fix_char(hd)) ++ Print.escape(String.to_list(Laws.fix_str(tl))) ==
        Print.escape.char(Laws.fix_char(hd)) ++ _ : String}
      {==}


# print_fix for an array cell, by what follows it
law pf_cons:
