# s + (k*t + y) is x + t and y is past x: k is 0
law sub_lt_k:
  for kk: Nat
  for +ss: Nat
  for +xx: Nat
  for +yy: Nat
  for +ee: Nat
  for +tt: Nat
  for hk: {Nat.add(ss, Nat.add(Nat.mul(kk, tt), yy)) == Nat.add(xx, tt) : Nat}
  for hy: {1n+Nat.add(xx, ee) == yy : Nat}
