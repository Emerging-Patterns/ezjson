# tx_print for a boolean
law txp_bool:
  for bb: Bool
  {Laws.tx.run(String.to_list(Print.print(V.JBool{bb})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def txp_bool(bb):
  match bb:
    case True{}:
      {==}
    case False{}:
      {==}


# a well-formed value's text leaves the scan outside strings, never at
# whitespace
law tx_print:
  for +val: V.Json
  for +sh: V.Shape
  for +h: {V.wf.go(val, sh) == True{} : Bool}
  {Laws.tx.run(String.to_list(Print.print(val)), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}

def tx_print(val, sh, h):
  match val:
    case V.JNull{}:
      match sh:
        case V.WVal{}:
          {==}
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JNull{})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JNull{})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JBool{bb}:
      match sh:
        case V.WVal{}:
          txp_bool(bb)
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JBool{bb})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JBool{bb})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JNum{+raw}:
      match sh:
        case V.WVal{}:
          tx_num(raw, h)
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JNum{raw})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JNum{raw})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JStr{+txt}:
      match sh:
        case V.WVal{}:
          tx_quote(txt)
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JStr{txt})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JStr{txt})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JArr{+items}:
      match sh:
        case V.WVal{}:
          Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("[" ++ (Print.print(items) ++ "]")), Laws.TxOut{}),
            Laws.tx.run(String.to_list(Print.print(items) ++ "]"), Laws.TxOut{}), Laws.TxOut{},
            tseq("[", Print.print(items) ++ "]", Laws.TxOut{}, Laws.TxOut{}, {==}),
            Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(items) ++ "]"), Laws.TxOut{}),
              Laws.tx.run(String.to_list("]"), Laws.TxOut{}), Laws.TxOut{},
            tseq(Print.print(items), "]", Laws.TxOut{}, Laws.TxOut{}, tx_print(items, V.WArr{}, h)),
            {==}))
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JArr{items})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JArr{items})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JObj{+pairs}:
      match sh:
        case V.WVal{}:
          Equal.trans(Laws.Tx, Laws.tx.run(String.to_list("{" ++ (Print.print(pairs) ++ "}")), Laws.TxOut{}),
            Laws.tx.run(String.to_list(Print.print(pairs) ++ "}"), Laws.TxOut{}), Laws.TxOut{},
            tseq("{", Print.print(pairs) ++ "}", Laws.TxOut{}, Laws.TxOut{}, {==}),
            Equal.trans(Laws.Tx, Laws.tx.run(String.to_list(Print.print(pairs) ++ "}"), Laws.TxOut{}),
              Laws.tx.run(String.to_list("}"), Laws.TxOut{}), Laws.TxOut{},
            tseq(Print.print(pairs), "}", Laws.TxOut{}, Laws.TxOut{}, tx_print(pairs, V.WObj{}, h)),
            {==}))
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JObj{pairs})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JObj{pairs})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JNil{}:
      match sh:
        case V.WVal{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JNil{})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WArr{}:
          {==}
        case V.WObj{}:
          {==}
    case V.JCons{+hd, +tl}:
      match sh:
        case V.WVal{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JCons{hd, tl})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WArr{}:
          txp_cons(tl, hd, h, xx => tx_print(hd, V.WVal{}, xx), xx => tx_print(tl, V.WArr{}, xx))
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JCons{hd, tl})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JPair{+kk, +vv, +rr}:
      match sh:
        case V.WVal{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JPair{kk, vv, rr})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JPair{kk, vv, rr})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          txp_pair(rr, kk, vv, h, xx => tx_print(vv, V.WVal{}, xx), xx => tx_print(rr, V.WObj{}, xx))
    case V.JSpan{+src, +nn}:
      match sh:
        case V.WVal{}:
          tx_quote(V.span.str(src, nn, U32.is_zero(nn)))
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JSpan{src, nn})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JSpan{src, nn})), Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
    case V.JBind{+src, +nn, +vv, +rr}:
      match sh:
        case V.WVal{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JBind{src, nn, vv, rr})),
            Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WArr{}:
          no({Laws.tx.run(String.to_list(Print.print(V.JBind{src, nn, vv, rr})),
            Laws.TxOut{}) == Laws.TxOut{} : Laws.Tx}, h)
        case V.WObj{}:
          txp_bind(rr, src, nn, vv, h, xx => tx_print(vv, V.WVal{}, xx), xx => tx_print(rr, V.WObj{}, xx))

# JSON-PRINT-2, the first half
def Laws.print_compact(txt, jj, e_p):
  hw = Equal.trans(Bool, V.wf(jj), Laws.wf_m(Ezjson.parse(txt)), True{},
    Equal.sym(Bool, Laws.wf_m(Ezjson.parse(txt)), V.wf(jj), Equal.cong(Maybe<&2, V.Json>, Bool, zz => Laws.wf_m(zz),
      Ezjson.parse(txt), Some{jj}, e_p)), Laws.parse_wf(txt))
  Equal.cong(Laws.Tx, Bool, zz => Laws.tx.ok(zz), Laws.tx.run(String.to_list(Print.print(jj)), Laws.TxOut{}),
    Laws.TxOut{}, tx_print(jj, V.WVal{}, hw))


# WP-G: rows that follow from the round trip

# the value of a Some; null for None
def unsome(mb: Maybe<&2, V.Json>) -> V.Json:
  match mb:
    case None{}:
      V.JNull{}
    case Some{jj}:
      jj

# whether a Maybe is None
def is_none(mb: Maybe<&2, V.Json>) -> Bool:
  match mb:
    case None{}:
      True{}
    case Some{_jj}:
      False{}

# a value whose owned form is a number is that number
law own_num:
  for +val: V.Json
  for +raw: String
  for e: {Laws.own(val) == V.JNum{raw} : V.Json}
  {val == V.JNum{raw} : V.Json}

def own_num(val, raw, e):
  match val:
    case V.JNull{}:
      Empty.absurd({V.JNull{} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JNull{}), V.JNum{raw}, e)))
    case V.JBool{+x1}:
      Empty.absurd({V.JBool{x1} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JBool{x1}), V.JNum{raw}, e)))
    case V.JNum{+x1}:
      e
    case V.JStr{+x1}:
      Empty.absurd({V.JStr{x1} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JStr{x1}), V.JNum{raw}, e)))
    case V.JArr{+x1}:
      Empty.absurd({V.JArr{x1} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JArr{x1}), V.JNum{raw}, e)))
    case V.JObj{+x1}:
      Empty.absurd({V.JObj{x1} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JObj{x1}), V.JNum{raw}, e)))
    case V.JNil{}:
      Empty.absurd({V.JNil{} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JNil{}), V.JNum{raw}, e)))
    case V.JCons{+x1, +x2}:
      Empty.absurd({V.JCons{x1, x2} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JCons{x1, x2}), V.JNum{raw}, e)))
    case V.JPair{+x1, +x2, +x3}:
      Empty.absurd({V.JPair{x1, x2, x3} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool,
        zz => Laws.is_num(zz),
        Laws.own(V.JPair{x1, x2, x3}), V.JNum{raw}, e)))
    case V.JSpan{+x1, +x2}:
      Empty.absurd({V.JSpan{x1, x2} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool, zz => Laws.is_num(zz),
        Laws.own(V.JSpan{x1, x2}), V.JNum{raw}, e)))
    case V.JBind{+x1, +x2, +x3, +x4}:
      Empty.absurd({V.JBind{x1, x2, x3, x4} == V.JNum{raw} : V.Json}, false_true(Equal.cong(V.Json, Bool,
        zz => Laws.is_num(zz),
        Laws.own(V.JBind{x1, x2, x3, x4}), V.JNum{raw}, e)))

# a parse result whose owned form is a number is that number
law own_m_num:
  for +mb: Maybe<&2, V.Json>
  for +raw: String
  for e: {Laws.own_m(mb) == Some{V.JNum{raw}} : Maybe<&2, V.Json>}
  {mb == Some{V.JNum{raw}} : Maybe<&2, V.Json>}

def own_m_num(mb, raw, e):
  match mb:
    case None{}:
      Empty.absurd({None{} == Some{V.JNum{raw}} : Maybe<&2, V.Json>}, true_false(Equal.cong(Maybe<&2, V.Json>, Bool,
        zz => is_none(zz), None{},
        Some{V.JNum{raw}}, e)))
    case Some{+jj}:
      Equal.cong(V.Json, Maybe<&2, V.Json>, zz => Some{zz}, jj, V.JNum{raw}, own_num(jj, raw,
        Equal.cong(Maybe<&2, V.Json>, V.Json, zz => unsome(zz), Some{Laws.own(jj)}, Some{V.JNum{raw}}, e)))

def Laws.parse_num(raw, h_ok, h_s):
  own_m_num(Ezjson.parse(raw), raw, Laws.print_parse(V.JNum{raw}, h_ok, h_s))

def Laws.print_num(_raw):
  {==}


# JSON-TEXT-4: a bare word

# a word character is a word character to the lexer
law oth_wc:
  for +ch: Char
  for h: {Laws.word_char(ch) == True{} : Bool}
  {Lex.classify(ch) == Lex.COther{} : Lex.Class}

