  for +dd: Nat
  for +ww: Bool
  for +ch: Char
  cpt(sc.out(lt, dd, Lex.COther{}, ch), gps(Laws.GpOut{ww}, Lex.COther{}))

def cpo.c8(lt, _dd, _ww, _ch):
