        Equal.cong(Lex.Lex, List<&2, Lex.Tok>, zz => Lex.finish(zz), Lex.run(cs, Lex.Lex{Lex.Idle{}, [], []}),
          Lex.Lex{Lex.Word{}, List.reverse.go(&2, Char, cs, []), []}, lex_word(hd, String.to_list(tl), oth_words(cs,
