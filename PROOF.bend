    case Laws.GEnd{} Laws.GKObj{}:
      strm_one(Pull.Cur{w1 ++ SCon{'}', tail}, Pull.FObj{Pull.SCom{}, fr} <> stack, False{}, False{}}, Pull.EEndObj{},
        aft(tail, stack),
