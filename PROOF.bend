        case Lex.HiEsc{+h1}:
          Equal.cong(List<&2, Lex.Tok>, Lex.Tok, zz => thead(zz), List.reverse.go(&2, Lex.Tok, List.append(&2, Lex.Tok,
            tk, [t0]), [Lex.TBad{}]), List.reverse.go(&2, Lex.Tok, [t0], List.reverse.go(&2, Lex.Tok, tk,
            [Lex.TBad{}])),
