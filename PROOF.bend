  kr(Pull.next.go(fn, "", Pull.place.val.on(Pull.ENum{raw, nn}, "", Pull.GNext{}, spot)), Pull.next.go(2n+aw, "",
    Pull.err.st(Pull.GSkip{1n+kk})), 1n+kk)

