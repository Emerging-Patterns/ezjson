  match lt:
    case LSt{}:
      Unit{}
    case LOp{}:
      match dd:
        case 0n:
          Unit{}
        case 1n+n0:
          Unit{}
    case LVal{}:
      match dd:
        case 0n:
          Unit{}
        case 1n+n0:
