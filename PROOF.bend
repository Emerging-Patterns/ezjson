        Equal.trans(List<&2, Lex.Tok>, dens(Lex.tokens("\"" ++ pre ++ SCon{'\\', SCon{Chr{uu}, post}} ++ "\"")),
        dens(Lex.finish(Lex.run(String.to_list("\"" ++ pre ++ SCon{'\\', SCon{Chr{uu}, post}} ++ "\""),
        Lex.Lex{Lex.Idle{}, [], []}))),
