# a string's pieces, read in a string, leave the scan in it
law sp_in:
  for +ps: List<&2, Laws.Piece>
  for +h: {Laws.spell_ok(ps) == True{} : Bool}
  for +dd: Nat
  {sc.run(Laws.spell(ps), SIn{dd}) == SIn{dd} : Sc}

