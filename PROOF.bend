# U32s compare as the Nats they are
law u_cmp:
  for aa: U32
  for bb: U32
  {U32.cmp(aa, bb) == Nat.cmp(U32.to_nat(aa), U32.to_nat(bb)) : Cmp}

def u_cmp(aa, bb):
  match aa bb:
    case U32{xw} U32{yw}:
      w_cmp(32n, xw, yw)

